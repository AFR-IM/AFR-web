# --- Chinese locale: every zh page (no assets are served under /zh-CN/) ---
/zh-CN
  Cache-Control: public, max-age=60, stale-while-revalidate=600
/zh-CN/
  Cache-Control: public, max-age=60, stale-while-revalidate=600
/zh-CN/*
  Cache-Control: public, max-age=60, stale-while-revalidate=600
