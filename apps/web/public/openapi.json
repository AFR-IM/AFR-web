{
  "openapi": "3.1.0",
  "info": {
    "title": "AFR.IM API",
    "version": "1.0.0",
    "description": "Public, key-free read API for the AFR.IM AI-Friendliness Rating (AFR) directory. All JSON endpoints send Access-Control-Allow-Origin: *. Ratings are snapshots computed from public, reproducible evidence — see GET /api/v1/method for the machine-readable standard."
  },
  "servers": [
    {
      "url": "https://afr.im",
      "description": "Production"
    }
  ],
  "paths": {
    "/api/v1/sites": {
      "get": {
        "summary": "List rated sites",
        "description": "Paginated directory listing. Pending (unratable) sites are excluded from natural results.",
        "parameters": [
          {
            "name": "category",
            "in": "query",
            "schema": {
              "type": "string"
            },
            "description": "Filter by category slug, e.g. dev-tools"
          },
          {
            "name": "grade",
            "in": "query",
            "schema": {
              "type": "string",
              "enum": [
                "A",
                "B",
                "C",
                "D",
                "F"
              ]
            },
            "description": "Filter by grade"
          },
          {
            "name": "q",
            "in": "query",
            "schema": {
              "type": "string"
            },
            "description": "Substring match on domain or title"
          },
          {
            "name": "sort",
            "in": "query",
            "schema": {
              "type": "string",
              "enum": [
                "score",
                "rank",
                "new"
              ],
              "default": "score"
            },
            "description": "score = AFR score DESC (default), rank = source rank, new = newest first"
          },
          {
            "name": "page",
            "in": "query",
            "schema": {
              "type": "integer",
              "minimum": 1,
              "default": 1
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Page of sites",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SiteList"
                },
                "example": {
                  "items": [
                    {
                      "domain": "github.com",
                      "title": "GitHub · Where software is built",
                      "lang": "en",
                      "category": "dev-tools",
                      "strategy_tag": "AI-Open",
                      "grade": "A",
                      "score_total": 91,
                      "score_l1": 33,
                      "score_l2": 38,
                      "score_l3": 20,
                      "rank_source": 4,
                      "rank": 1,
                      "status": "active",
                      "verified": true,
                      "created_at": "2026-11-10T11:40:00.000Z",
                      "updated_at": "2026-11-10T11:40:00.000Z",
                      "scanned_at": "2026-11-10T11:40:00.000Z"
                    }
                  ],
                  "page": 1,
                  "per_page": 24,
                  "total": 8,
                  "sort": "score"
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/BadRequest"
          }
        }
      }
    },
    "/api/v1/sites/{domain}": {
      "get": {
        "summary": "Site detail with latest scan and evidence",
        "parameters": [
          {
            "name": "domain",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            },
            "example": "github.com"
          }
        ],
        "responses": {
          "200": {
            "description": "Site, latest scan, and its evidence rows",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "site": {
                      "$ref": "#/components/schemas/Site"
                    },
                    "scan": {
                      "oneOf": [
                        {
                          "$ref": "#/components/schemas/Scan"
                        },
                        {
                          "type": "null"
                        }
                      ]
                    },
                    "evidence": {
                      "type": "array",
                      "items": {
                        "$ref": "#/components/schemas/Evidence"
                      }
                    }
                  }
                },
                "example": {
                  "site": {
                    "domain": "github.com",
                    "grade": "A",
                    "score_total": 91,
                    "strategy_tag": "AI-Open",
                    "verified": true
                  },
                  "scan": {
                    "id": 42,
                    "domain": "github.com",
                    "engine_version": "afr-1.1.0",
                    "score_total": 91,
                    "grade": "A",
                    "started_at": "2026-11-10T11:40:00.000Z"
                  },
                  "evidence": [
                    {
                      "check_id": "l1.robots.ai-policy",
                      "status": "pass",
                      "points": 25,
                      "max_points": 25,
                      "evidence_type": "http",
                      "evidence_ref": "GET /robots.txt"
                    }
                  ]
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/BadRequest"
          },
          "404": {
            "$ref": "#/components/responses/NotFound"
          }
        }
      }
    },
    "/api/v1/sites/{domain}/history": {
      "get": {
        "summary": "Scan history for a site (newest first)",
        "parameters": [
          {
            "name": "domain",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "All scans for the domain",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "domain": {
                      "type": "string"
                    },
                    "scans": {
                      "type": "array",
                      "items": {
                        "$ref": "#/components/schemas/Scan"
                      }
                    }
                  }
                }
              }
            }
          },
          "404": {
            "$ref": "#/components/responses/NotFound"
          }
        }
      }
    },
    "/api/v1/stats": {
      "get": {
        "summary": "Totals, grade distribution, and average score",
        "responses": {
          "200": {
            "description": "Directory statistics",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Stats"
                },
                "example": {
                  "total": 8,
                  "verified": 4,
                  "pending": 0,
                  "avg_score": 58,
                  "grades": {
                    "A": 1,
                    "B": 2,
                    "C": 2,
                    "D": 2,
                    "F": 1
                  }
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/categories": {
      "get": {
        "summary": "Category tree with per-category site counts",
        "responses": {
          "200": {
            "description": "Category tree",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "categories": {
                      "type": "array",
                      "items": {
                        "$ref": "#/components/schemas/Category"
                      }
                    }
                  }
                },
                "example": {
                  "categories": [
                    {
                      "slug": "dev-tools",
                      "name_en": "Developer Tools",
                      "name_zh": "开发者工具",
                      "count": 3,
                      "children": []
                    }
                  ]
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/leaderboard": {
      "get": {
        "summary": "Top sites by pure AFR score descending",
        "description": "Natural ranking never mixes in sponsored placements.",
        "parameters": [
          {
            "name": "category",
            "in": "query",
            "schema": {
              "type": "string"
            },
            "description": "Restrict to one category slug"
          },
          {
            "name": "limit",
            "in": "query",
            "schema": {
              "type": "integer",
              "minimum": 1,
              "maximum": 50
            },
            "description": "Number of rows (default: leaderboard size)"
          }
        ],
        "responses": {
          "200": {
            "description": "Ranked leaderboard rows",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "category": {
                      "type": [
                        "string",
                        "null"
                      ]
                    },
                    "items": {
                      "type": "array",
                      "items": {
                        "$ref": "#/components/schemas/LeaderboardItem"
                      }
                    }
                  }
                },
                "example": {
                  "category": null,
                  "items": [
                    {
                      "rank": 1,
                      "domain": "github.com",
                      "title": "GitHub · Where software is built",
                      "grade": "A",
                      "score": 91,
                      "category": "dev-tools",
                      "strategy_tag": "AI-Open"
                    }
                  ]
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/method": {
      "get": {
        "summary": "Machine-readable AFR standard",
        "description": "Layers, per-sub-check points, and grade thresholds — the same values the scoring engine uses.",
        "responses": {
          "200": {
            "description": "AFR standard",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Method"
                },
                "example": {
                  "standard": "AFR",
                  "version": "1.0.0",
                  "layers": [
                    {
                      "id": "L1",
                      "name": "Reachability",
                      "weight": 35,
                      "checks": []
                    },
                    {
                      "id": "L2",
                      "name": "Legibility",
                      "weight": 40,
                      "checks": []
                    },
                    {
                      "id": "L3",
                      "name": "Actionability",
                      "weight": 25,
                      "checks": []
                    }
                  ],
                  "grades": [
                    {
                      "min": 75,
                      "grade": "A",
                      "color": "#22c55e"
                    },
                    {
                      "min": 60,
                      "grade": "B",
                      "color": "#84cc16"
                    },
                    {
                      "min": 42,
                      "grade": "C",
                      "color": "#eab308"
                    },
                    {
                      "min": 25,
                      "grade": "D",
                      "color": "#f97316"
                    },
                    {
                      "min": 0,
                      "grade": "F",
                      "color": "#ef4444"
                    }
                  ]
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/ads": {
      "get": {
        "summary": "Currently active sponsored placements",
        "description": "Sponsored placements are served separately from the natural ranking and never change grades or order.",
        "parameters": [
          {
            "name": "slot",
            "in": "query",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "key",
            "in": "query",
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Active ads",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "items": {
                      "type": "array",
                      "items": {
                        "$ref": "#/components/schemas/Ad"
                      }
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/submissions": {
      "post": {
        "summary": "Request a scan of a site",
        "description": "Fully automatic inclusion. Registered domains only (eTLD+1 heuristic): subdomains like blog.example.com are rejected with error subdomain_not_allowed, www is stripped. Already-listed domains return status 'exists' (open the detail page); already-queued domains return status 'queued' (idempotent, no quota burned). New submissions are queued AND immediately dispatch the scan workflow, so a typical listing is searchable within ~10 minutes (etaSeconds covers scan + rebuild); if dispatch is deferred the next daily scan (02:00 UTC) collects it. Rate-limited to 5 new submissions per IP per day. New entries carry etaSeconds 600 (scan plus rebuild) and dispatch 'scheduled' | 'ok' | 'deferred'; the idempotent 'exists'/'queued' responses omit dispatch.",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": [
                  "domain"
                ],
                "properties": {
                  "domain": {
                    "type": "string",
                    "description": "Bare registered domain, e.g. example.com (subdomains rejected)"
                  },
                  "note": {
                    "type": "string",
                    "maxLength": 500,
                    "description": "Optional note for the reviewers"
                  }
                }
              },
              "example": {
                "domain": "example.com",
                "note": "We ship a public llms.txt and API."
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Already listed (status='exists') or already queued (status='queued') — idempotent, no quota consumed",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SubmissionResult"
                },
                "example": {
                  "ok": true,
                  "status": "exists",
                  "domain": "example.com"
                }
              }
            }
          },
          "201": {
            "description": "Queued and scan dispatch attempted",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SubmissionResult"
                },
                "example": {
                  "ok": true,
                  "id": 1,
                  "domain": "example.com",
                  "status": "queued",
                  "etaSeconds": 600,
                  "dispatch": "scheduled"
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/BadRequest"
          },
          "429": {
            "description": "Rate limited",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                },
                "example": {
                  "error": "rate_limited",
                  "limit": 5,
                  "remaining": 0
                }
              }
            }
          }
        }
      }
    },
    "/badge/{domain}.svg": {
      "get": {
        "summary": "Rating badge image for a domain",
        "description": "SVG badge with ring, grade letter, and score. Cached for one hour. Unknown domains get a neutral gray badge.",
        "parameters": [
          {
            "name": "domain",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            },
            "example": "github.com.svg"
          }
        ],
        "responses": {
          "200": {
            "description": "Badge SVG",
            "content": {
              "image/svg+xml": {
                "schema": {
                  "type": "string"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/search-scan": {
      "post": {
        "summary": "Request an on-demand scan of a domain",
        "description": "Interactive-session variant of a submission: looser quota tiers (10 per IP per day, 1 per domain per 30-minute window, 50 globally per day). Already-listed domains return status 'exists' and already-queued domains return status 'queued' with no quota burned - both omit the dispatch field. The scan workflow is dispatched in the background, so the response never waits for GitHub: 'scheduled' means triggered, 'deferred' means the nightly run will pick it up (still queued, not lost).",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": [
                  "domain"
                ],
                "properties": {
                  "domain": {
                    "type": "string",
                    "description": "Bare registered domain, e.g. example.com"
                  }
                }
              },
              "example": {
                "domain": "example.com"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Queued, already queued, or already listed",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object"
                },
                "example": {
                  "status": "queued",
                  "domain": "example.com",
                  "etaSeconds": 180,
                  "dispatch": "scheduled"
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/BadRequest"
          },
          "429": {
            "description": "One of the three daily tiers is exhausted",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                },
                "example": {
                  "error": "rate_limited",
                  "retryAfter": 1800
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/rescan": {
      "post": {
        "summary": "Re-scan a site that is already rated",
        "description": "Use after the owner changes robots.txt, adds llms.txt, or fixes the homepage. 30-minute per-domain window; the response carries nextAllowedAt, the earliest legitimate retry time. The scan is dispatched in the background and the response omits the dispatch field.",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": [
                  "domain"
                ],
                "properties": {
                  "domain": {
                    "type": "string"
                  }
                }
              },
              "example": {
                "domain": "example.com"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Re-scan queued",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object"
                },
                "example": {
                  "status": "queued",
                  "etaSeconds": 180,
                  "nextAllowedAt": "2026-11-18T09:00:00.000Z"
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/BadRequest"
          },
          "404": {
            "$ref": "#/components/responses/NotFound"
          },
          "429": {
            "description": "Per-domain or per-device window still active (30 minutes)",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                },
                "example": {
                  "error": "rate_limited",
                  "scope": "domain",
                  "retryAfter": 1800
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/queue": {
      "get": {
        "summary": "List pending submissions",
        "description": "Public and key-free. Up to 50 oldest queued entries. If a domain you submitted appears here it is waiting its turn - queued is not lost.",
        "responses": {
          "200": {
            "description": "Pending queue",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object"
                },
                "example": {
                  "items": [
                    {
                      "domain": "example.com",
                      "source": "on_demand",
                      "note": null,
                      "createdAt": "2026-11-17T06:47:36.931Z"
                    }
                  ]
                }
              }
            }
          }
        }
      }
    }
  },
