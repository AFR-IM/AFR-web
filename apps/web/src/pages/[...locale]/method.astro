---
// Prerendered: this page is a static asset. Only the detail pages are
// rendered on demand (SSOT item 20 — the catalog must not cost assets).
export const prerender = true;
// P5 method page — /method (the anchor of trust, highest design priority).
// Fully bilingual inline: every prose unit below carries EN + ZH in this file,
// structured data (layers/checks/grades) comes from packages/afr/src/method.ts
// so the page can never drift from the machine-readable standard.
//
// Honest-disclosure rules baked in: ads never touch scores, claims sit beside evidence.
//   · paid placements never change ranking or grades
//   · llms.txt is a machine-readability bonus, not an AI-citation guarantee
//   · where the written standard and the engine differ, the recorded engine
//     version governs recomputation

import Base from '../../layouts/Base.astro';
import StrategyTag from '../../components/detail/StrategyTag.astro';
import { AFR_METHOD } from '../../../../../packages/afr/src/method.ts';
import { ENGINE_VERSION } from '../../../../../packages/afr/src/index.ts';
import { SCANNER_VERSION, USER_AGENT } from '../../../../../packages/scanner/src/http.ts';
import { getCatalog, LOCALES, pathFor, toLocale, type Locale } from '../../i18n/loader.ts';
import type { StrategyTag as StrategyTagType } from '../../data/types.ts';

export function getStaticPaths() {
  return [{ params: { locale: undefined } }, { params: { locale: 'zh-CN' } }];
}

const locale: Locale = toLocale(Astro.params.locale);
const L = getCatalog(locale);
const isZh = locale === 'zh-CN';
const href = (p: string) => pathFor(locale, p);

/* ── inline bilingual prose (per-locale) ───────────────── */

const PROSE = {
  en: {
    title: 'The AFR standard',
    description:
      'The AFR scoring rules, evidence checks, grade thresholds and steps to recompute scores from complete saved inputs.',
    intro:
      'AFR (AI-Friendliness Rating) scores observable public signals about how open a website is to AI crawlers and agents, on a scale of 0–100. The rules below describe the evidence and heuristics behind the grade.',
    toc: ['Three layers', 'Every check', 'Grades & strategies', 'Engine versions', 'Recompute', 'Neutrality', 'Data sources', 'Machine-readable'],
    layerHeading: 'The three-layer model',
    layerIntro:
      'The total is 100 = 35 + 40 + 25. Legibility carries the most weight because machine-readable content is what AI-friendliness actually means: a site that is technically open but unreadable still fails on AI usefulness.',
    colLayer: 'Layer',
    colQuestion: 'Question',
    colWeight: 'Weight',
    questions: { L1: 'Can AI reach it?', L2: 'Can it be read?', L3: 'Can it act?' },
    checksHeading: 'Every sub-check',
    checksIntro:
      'Grouped exactly as the standard defines them. Points are fixed; nothing here depends on opinion, popularity, or payment.',
    gradesHeading: 'Grade thresholds',
    gradesIntro: 'Current thresholds: A ≥75 / B ≥ 60 / C ≥ 42 / D ≥ 25, calibrated on 2026-11-10 against the first Top-1000 scan distribution. After that, thresholds only move at quarter boundaries following a distribution review, and historical scores keep the engine version they were computed with.',
    colGrade: 'Grade',
    colRange: 'Range',
    colLabel: 'Label',
    colMeaning: 'Meaning',
    strategiesHeading: 'Strategy tags',
    strategiesIntro:
      'A second, independent axis derived from robots.txt alone. The tag sits next to the grade and never deducts points — it explains the policy behind the score.',
    engineHeading: 'Engine versions',
    engineIntro: 'Each score records the engine version that produced it.',
    rowStandard: 'Method revision',
    rowEngine: 'Scoring engine',
    rowScanner: 'Scanner',
    rowUa: 'Crawler user-agent',
    engineNote:
      'Every snapshot stores engine_version; historical scores are never re-graded with a newer engine — they stay attached to the version that produced them.',
    honestyLine:
      'Recompute with the recorded version and complete inputs. Some snapshots have had response bodies pruned and cannot be fully recomputed.',
    recomputeHeading: 'Recompute from a complete snapshot',
    recomputeIntro:
      'The scoring engine is a pure function: no IO, no clock, no network. Check out the engine version recorded on the snapshot, run the tests, then supply the complete saved signals.',
    recomputeClone: '1. Clone and run the engine test suite (Node ≥ 22, zero dependencies):',
    recomputeRun: '2. Feed a recorded snapshot ({ signals, afr } per site) back into the engine:',
    neutralityHeading: 'Neutrality pledge',
    neutralityIntro: 'Read it verbatim — this is the promise the product is built on.',
    neutralityPledge: [
      'Paid placements never change ranking or grades. The natural list is always a pure AFR-score descending sort; money buys exposure in a separate Sponsored block, never a better position in the natural order and never a better-looking grade.',
      'Every sponsored slot shows the site\'s real grade ring and score — an F-grade site can buy exposure, but it cannot buy an A-grade appearance.',
      'Ads live in visually separated blocks with a permanent "Sponsored" label, never mixed into natural results, and hovering an ad never changes a grade color.',
      'Verification, badges, evidence chains and score-change notifications stay free forever. Nothing in the free tier is throttled to force an upgrade.',
    ],
    dataHeading: 'Data sources',
    dataItems: [
      ['Seed set', 'Tranco daily Top 1M (tranco-list.eu, free for academic use with attribution).'],
      ['Scan evidence', 'Public snapshots committed to github.com/AFR-IM/AFR-data — git versioning is the audit trail.'],
      ['Corrections', 'Pull requests to the data repository (corrections/) are reviewed by AFR and the site is re-scanned manually; verified owners may publish a statement.'],
    ],
    schemaHeading: 'Machine-readable standard',
    schemaBody:
      'Use scoring in /api/v1/method for the current engine rules. The top-level layers field is a deprecated compatibility field.',
    schemaLink: 'Open /api/v1/method',
    license: 'AFR is published under CC BY 4.0 — reuse it with attribution.',
  },
  'zh-CN': {
    title: 'AFR 标准全文',
    description:
      'AFR 评分规则、证据检查、等级阈值与使用完整历史输入复算的方法。',
    intro:
      'AFR（AI-Friendliness Rating，AI 友好度评级）根据可观测的公开信号，用 0–100 分衡量网站对 AI 爬虫和智能体的开放程度。各项证据与启发式规则如下。',
    toc: ['三层模型', '全部子项', '等级与策略', '引擎版本', '复算指南', '中立性', '数据来源', '机读标准'],
    layerHeading: '三层模型',
    layerIntro:
      '总分 100 = 35 + 40 + 25。可懂层权重最高，因为“内容机器可读”才是 AI 友好的本体：技术上全开放但内容混乱的站，在 AI 实用性上仍然不及格。',
    colLayer: '层',
    colQuestion: '回答的问题',
    colWeight: '权重',
    questions: { L1: 'AI 能不能来？', L2: '来了能不能读懂？', L3: '能不能替用户干活？' },
    checksHeading: '全部子项',
    checksIntro: '严格按标准分组。分值固定，不依赖观点、热度或付费。',
    gradesHeading: '等级阈值',
    gradesIntro: '现行阈值 A ≥75 / B ≥60 / C ≥42 / D ≥25，2026-11-10 依据首批 Top-1000 扫描分布校准；此后仅在季度边界按分布复核调整，历史分数按其当时的引擎版本保留展示。',
    colGrade: '等级',
    colRange: '分数区间',
    colLabel: '名称',
    colMeaning: '含义',
    strategiesHeading: '策略标签',
    strategiesIntro: '仅由 robots.txt 得出的第二条独立坐标。标签与等级并列展示，不参与扣分——它解释分数背后的策略。',
    engineHeading: '引擎版本',
    engineIntro: '每次扫描都会记录生成评分的引擎版本。',
    rowStandard: '方法修订号',
    rowEngine: '评分引擎',
    rowScanner: '扫描器',
    rowUa: '爬虫 User-Agent',
    engineNote: '每份快照都存 engine_version；历史分数绝不用新引擎重算——始终绑定产出它的那个版本。',
    honestyLine: '复算需要对应的引擎版本和完整输入。部分历史快照已裁剪响应正文，无法完整复算。',
    recomputeHeading: '使用完整快照复算',
    recomputeIntro: '评分引擎是纯函数：无 IO、无时钟、无网络。切换到快照记录的引擎版本，运行测试，再输入完整的扫描信号。',
    recomputeClone: '1. 克隆仓库并运行引擎测试（Node ≥ 22，零依赖）：',
    recomputeRun: '2. 把记录好的快照（每站 { signals, afr }）喂回引擎：',
    neutralityHeading: '中立性承诺',
    neutralityIntro: '原文照录——这是产品立身之本。',
    neutralityPledge: [
      '付费永远不能改变排名或等级。自然排行始终是纯 AFR 分数降序；付费买到的是独立 Sponsored 区块的曝光位，绝不会改变自然榜位次，也绝买不到更好看的等级。',
      '每个广告位都强制展示该站真实的等级色环与分数——F 级站可以买曝光，但买不到 A 级外观。',
      '广告以带固定 “Sponsored” 角标的独立区块呈现，绝不与自然结果混排；hover 广告不会改变任何等级色。',
      '站长验证、徽章、证据链与评分变化通知永久免费。免费层绝不设限逼升级。',
    ],
    dataHeading: '数据来源',
    dataItems: [
      ['种子集', 'Tranco 每日 Top 1M（tranco-list.eu，学术用途免费署名）。'],
      ['扫描证据', '公开快照提交至 github.com/AFR-IM/AFR-data——git 版本化即审计轨迹。'],
      ['纠错通道', '向数据仓提 PR（corrections/）由 AFR 审阅并人工安排重扫；已验证站方可发布声明。'],
    ],
    schemaHeading: '机读标准',
    schemaBody: '/api/v1/method 的 scoring 字段提供现行引擎规则。顶层 layers 字段仅供旧客户端兼容，已弃用。',
    schemaLink: '打开 /api/v1/method',
    license: 'AFR 以 CC BY 4.0 发布——署名后可自由复用。',
  },
} as const;

const P = PROSE[locale === 'zh-CN' ? 'zh-CN' : 'en'];
const lang = isZh ? 'zh' : 'en';

const rangeOf = (min: number, prevMin?: number) => `${min}–${prevMin !== undefined ? prevMin - 1 : 100}`;

const cloneSnippet = `git clone https://github.com/AFR-IM/AFR-web
cd AFR-web
npm test   # = node --test packages/*/test/*.test.ts`;

const runSnippet = `import { scoreAfr } from './packages/afr/src/index.ts';
import snapshot from './scans/github.com.json' with { type: 'json' };

const result = scoreAfr(snapshot.signals);
console.log(result.score, result.grade, result.engineVersion);`;

const strategyOrder: StrategyTagType[] = ['AI-Open', 'Middle-Path', 'Training-Open', 'AI-Closed', 'Unconfigured'];

const sectionIds = ['layers', 'checks', 'grades', 'engine', 'recompute', 'neutrality', 'data', 'schema'];

/* ── FAQPage structured data (product FAQ; mirrors the page's own prose) ── */
const FAQ = {
  en: [
    {
      q: 'How does the AFR rating work?',
      a: 'AFR scans only public signals — robots.txt, llms.txt, sitemap, structured data, semantic HTML, public APIs, and agent instructions — with a fixed budget of HTTP requests. Each of the 100 possible points belongs to a named sub-check with published evidence, and the total is the sum of three layers: Reachability (35), Legibility (40), and Actionability (25).',
    },
    {
      q: 'Does the scan collect private data or require a login?',
      a: 'No. The scanner fetches public responses without logging in. A recorded challenge can trigger a browser user-agent fallback for content checks. Recomputing a historical score requires the original scan inputs.',
    },
    {
      q: "How can I improve my site's score?",
      a: 'Allow the known AI crawler families in robots.txt instead of blocking them, keep the homepage reachable without JavaScript or a login wall, publish a sitemap and an llms.txt file, mark up your content with JSON-LD, keep exactly one clear h1 plus a meta description, and publish a documented API with agent instructions at /agents.md. The check tables above list every sub-check with its points.',
    },
    {
      q: 'What do the grades A through F mean?',
      a: 'Grades are coordinates on an openness scale: A (75–100) is open to AI crawlers and agents, B and C are partially open, D is mostly closed, and F (0–24) has few observed positive signals. They describe technical openness to automated visitors, not the quality of the site\'s content.',
    },
    {
      q: 'Do paid placements change grades or ranking?',
      a: 'No. Paid placements appear only in separately labeled sponsored blocks. The natural ranking is always a pure AFR-score descending order, and verification, badges, evidence chains, and score-change notifications stay free.',
    },
  ],
  'zh-CN': [
    {
      q: 'AFR 评级是如何运作的？',
      a: 'AFR 只扫描公开信号——robots.txt、llms.txt、sitemap、结构化数据、语义化 HTML、公开 API 与 Agent 指令——且抓取预算固定。100 分中的每个分值都属于一个具名子项并附带公开证据，总分来自三层之和：可达层（35）、可懂层（40）、可交互层（25）。',
    },
    {
      q: '扫描会采集隐私数据或要求登录吗？',
      a: '不会。扫描器仅抓取公开响应，不登录。遇到挑战页时，可能使用浏览器 User-Agent 回退抓取供内容检查。复算历史分数需要原始扫描输入。',
    },
    {
      q: '如何提升自己网站的分数？',
      a: '在 robots.txt 中显式放行已知的 AI 爬虫家族而不是屏蔽；保证首页不依赖 JS、无登录墙即可读；发布 sitemap 与 llms.txt；用 JSON-LD 标注内容；全页只有一个清晰的 h1 与 meta description；再公开一份有文档的 API 与 /agents.md Agent 指令。上面的子项表列出了每个子项及其分值。',
    },
    {
      q: 'A 到 F 的等级是什么意思？',
      a: '等级是开放度坐标：A（75–100）对 AI 爬虫与智能体完全开放，B、C 部分开放，D 大部分关闭，F（0–24）表示本次观察到的正向信号较少。它描述的是对自动访问者的技术开放度，不是内容质量。',
    },
    {
      q: '付费展示会改变等级或排名吗？',
      a: '不会。付费展示只出现在独立标注的赞助区块中。自然排名永远是纯 AFR 分数降序，验证、徽章、证据链与分数变化通知永久免费。',
    },
  ],
}[locale];

const faqJsonLd = JSON.stringify({
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: FAQ.map((item) => ({
    '@type': 'Question',
    name: item.q,
    acceptedAnswer: { '@type': 'Answer', text: item.a },
  })),
}).replace(/</g, '\\u003c');
---

<Base title={P.title} description={P.description}>
  <script type="application/ld+json" is:inline set:html={faqJsonLd}></script>
  <div class="container method">
    <header class="hero">
      <p class="eyebrow mono">{AFR_METHOD.engineVersion} · {P.rowStandard} {AFR_METHOD.revision}</p>
      <h1>{P.title}</h1>
      <p class="lede">{P.intro}</p>
      <nav class="toc" aria-label="contents">
        {
          sectionIds.map((id, i) => (
            <a class="chip" href={`#${id}`}>
              {P.toc[i]}
            </a>
          ))
        }
      </nav>
    </header>

    <!-- (a) three-layer model -->
    <section class="sec" id="layers">
      <h2>{P.layerHeading}</h2>
      <p>{P.layerIntro}</p>
      <table class="tbl">
        <thead>
          <tr>
            <th>{P.colLayer}</th>
            <th>{P.colQuestion}</th>
            <th class="num">{P.colWeight}</th>
          </tr>
        </thead>
        <tbody>
          {
            AFR_METHOD.layers.map((layer) => (
              <tr>
                <td>
                  <span class="lid mono">{layer.id}</span>{' '}
                  {layer.name[lang as 'en' | 'zh'] ?? L.layers[layer.id]}
                </td>
                <td>{P.questions[layer.id]}</td>
                <td class="num">{layer.weight}</td>
              </tr>
            ))
          }
        </tbody>
      </table>
    </section>

    <!-- (b) full check tables per layer -->
    <section class="sec" id="checks">
      <h2>{P.checksHeading}</h2>
      <p>{P.checksIntro}</p>
      <p>{AFR_METHOD.ratedWhen[lang]}</p>
      <p>{AFR_METHOD.rounding[lang]}</p>

      {
        AFR_METHOD.layers.map((layer) => (
          <div class="layer-block">
            <h3 class="layer-h">
              <span class="lid mono">{layer.id}</span> {layer.name[lang as 'en' | 'zh'] ?? L.layers[layer.id]}
              <span class="w mono">
                {layer.weight} {lang === 'zh' ? '分' : 'points'}
              </span>
            </h3>
            {layer.checks.map((check) => (
              <div class="group">
                <h4 class="group-h">
                  <span class="mono">{check.code}</span> {check.name[lang]}
                  <span class="g-total mono">{check.points} {isZh ? '分' : 'pts'}</span>
                </h4>
                <p class="group-intro">{check.rule[lang]}</p>
                <p class="mono">{check.id}</p>
                {check.code === 'A1' && (
                  <ul>
                    {AFR_METHOD.robotsFamilies.map((family) => (
                      <li>{family.name[lang]} ({family.points}): {family.userAgents.join(', ')}</li>
                    ))}
                  </ul>
                )}
              </div>
            ))}
          </div>
        ))
      }
    </section>

    <!-- (c) grades + strategy tags -->
    <section class="sec" id="grades">
      <h2>{P.gradesHeading}</h2>
      <p>{P.gradesIntro}</p>
      <table class="tbl">
        <thead>
          <tr>
            <th>{P.colGrade}</th>
            <th class="num">{P.colRange}</th>
            <th>{P.colLabel}</th>
            <th>{P.colMeaning}</th>
          </tr>
        </thead>
        <tbody>
          {
            AFR_METHOD.grades.map((g, i) => {
              const info = L.grades[g.grade as 'A' | 'B' | 'C' | 'D' | 'F'];
              return (
                <tr>
                  <td>
                    <span class="sw" style={`background:var(--grade-${g.grade.toLowerCase()});`} />
                    <span class="mono g-letter" style={`color:var(--grade-${g.grade.toLowerCase()}-text);`}>
                      {g.grade}
                    </span>
                  </td>
                  <td class="num">{rangeOf(g.min, i > 0 ? AFR_METHOD.grades[i - 1]!.min : undefined)}</td>
                  <td>{info?.label ?? g.grade}</td>
                  <td>{info?.slogan ?? ''}</td>
                </tr>
              );
            })
          }
        </tbody>
      </table>

      <h3 class="sub-h">{P.strategiesHeading}</h3>
      <p>{P.strategiesIntro}</p>
      <ul class="strats">
        {
          strategyOrder.map((t) => (
            <li>
              <StrategyTag tag={t} locale={locale} />
              <span class="strat-desc">{L.strategies[t]?.desc ?? t}</span>
            </li>
          ))
        }
      </ul>
    </section>

    <!-- (d) engine versions -->
    <section class="sec" id="engine">
      <h2>{P.engineHeading}</h2>
      <p>{P.engineIntro}</p>
      <table class="tbl">
        <tbody>
          <tr>
            <th class="row-h">{P.rowStandard}</th>
            <td class="mono">{AFR_METHOD.revision}</td>
          </tr>
          <tr>
            <th class="row-h">{P.rowEngine}</th>
            <td class="mono">{ENGINE_VERSION}</td>
          </tr>
          <tr>
            <th class="row-h">{P.rowScanner}</th>
            <td class="mono">{SCANNER_VERSION}</td>
          </tr>
          <tr>
            <th class="row-h">{P.rowUa}</th>
            <td class="mono ua">{USER_AGENT}</td>
          </tr>
        </tbody>
      </table>
      <p class="note">{P.engineNote}</p>
      <p class="honest mono">{P.honestyLine}</p>
    </section>

    <!-- (e) recompute guide -->
    <section class="sec" id="recompute">
      <h2>{L.ui.recomputeTitle ?? P.recomputeHeading}</h2>
      <p>{P.recomputeIntro}</p>
      <p class="step">{P.recomputeClone}</p>
      <pre class="mono" tabindex="0"><code>{cloneSnippet}</code></pre>
      <p class="step">{P.recomputeRun}</p>
      <pre class="mono" tabindex="0"><code>{runSnippet}</code></pre>
    </section>

    <!-- (f) neutrality pledge -->
    <section class="sec" id="neutrality">
      <h2>{P.neutralityHeading}</h2>
      <p class="pledge-lead">{L.ui.neutralityStatement ?? P.neutralityIntro}</p>
      <p class="pledge-intro">{P.neutralityIntro}</p>
      <ul class="pledge">
        {P.neutralityPledge.map((line) => <li>{line}</li>)}
      </ul>
      <p class="pledge-foot mono">{L.ui.footerPledge}</p>
    </section>

    <!-- (g) data sources -->
    <section class="sec" id="data">
      <h2>{P.dataHeading}</h2>
      <dl class="sources">
        {
          P.dataItems.map(([k, v]) => (
            <div class="src-row">
              <dt class="mono">{k}</dt>
              <dd>{v}</dd>
            </div>
          ))
        }
      </dl>
    </section>

    <!-- (h) machine-readable schema + license -->
    <section class="sec" id="schema">
      <h2>{P.schemaHeading}</h2>
      <p>{P.schemaBody}</p>
      <p>
        <a class="btn" href="/api/v1/method">{P.schemaLink}</a>
      </p>
      <p class="license mono">{P.license}</p>
    </section>
  </div>
</Base>

<style>
  .method {
    padding-top: 32px;
    padding-bottom: 24px;
  }

  .hero {
    max-width: 820px;
    margin-bottom: 28px;
  }
  .eyebrow {
    margin: 0 0 8px;
    font-size: 12px;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--brand-link);
  }
  .hero h1 {
    font-size: clamp(28px, 4.4vw, 42px);
    margin-bottom: 12px;
  }
  .lede {
    margin: 0;
    font-size: 16px;
    line-height: 1.7;
    color: var(--text-2);
  }
  .toc {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    margin-top: 18px;
  }
  .toc .chip {
    font-size: 12px;
    transition: border-color var(--t-micro) var(--ease), color var(--t-micro) var(--ease);
  }
  .toc .chip:hover {
    border-color: var(--brand);
    color: var(--brand-link);
  }

  .sec {
    background: var(--bg-surface);
    border: 1px solid var(--line);
    border-radius: var(--radius);
    padding: 26px 26px 24px;
    margin-bottom: 20px;
    scroll-margin-top: 84px;
  }
