} as const;

const P = PROSE[locale === 'zh-CN' ? 'zh-CN' : 'en'];

const statsExample = `{
  "total": 8,
  "verified": 4,
  "pending": 0,
  "avg_score": 58,
  "grades": { "A": 1, "B": 2, "C": 2, "D": 2, "F": 1 }
}`;

