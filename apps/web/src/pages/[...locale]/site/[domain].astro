---
// P3 detail page — /site/:domain.
//
// Rendered on demand (SSOT item 20: 详情页按需生成). A static page per site
// does not scale: the Worker Free plan allows 20,000 asset files per
// version, and the bilingual detail pages cost two files per domain — the
// catalog is the product, the pages must not be the limit.
//
// The payload is the same scan snapshot the static build used (the data
// repo's JSON is the SSOT), so an on-demand page shows exactly what the
// static one showed: the snapshot comes from the data repo, and the map
// that says where it lives is written by the build.
//
// Layout: 340px report card │ 1fr evidence chain │ 320px
// statement/badge/history, left+right sticky at top 80px; 768–1279 → 2+1;
// ≤767 → three tabs (Report / Evidence / Statement).

import Base from '../../../layouts/Base.astro';
import GradeRing from '../../../components/grade/GradeRing.astro';
import StrategyTag from '../../../components/detail/StrategyTag.astro';
import VerifiedTick from '../../../components/detail/VerifiedTick.astro';
import ReportCard from '../../../components/detail/ReportCard.astro';
import EvidenceChain from '../../../components/detail/EvidenceChain.astro';
import ObservationPanel from '../../../components/detail/ObservationPanel.astro';
import ClaimBlock from '../../../components/detail/ClaimBlock.astro';
import BadgeEmbed from '../../../components/detail/BadgeEmbed.astro';
import HistorySpark from '../../../components/detail/HistorySpark.astro';
import RescanButton from '../../../components/detail/RescanButton.astro';
import TorchBadge from '../../../components/detail/TorchBadge.astro';
import TorchBoost from '../../../components/detail/TorchBoost.astro';
import PromoCard from '../../../components/detail/PromoCard.astro';
import { getCatalog, pathFor, toLocale, type Locale } from '../../../i18n/loader.ts';
import { uiText } from '../../../components/home/fallbacks.ts';
import { loadRuntimeDetail } from '../../../data/runtime-detail.ts';
import type { SiteDetail } from '../../../data/types.ts';
import { gradeTextVar } from '../../../utils/grade.ts';

// Rendered per request — not prerendered into an asset.
export const prerender = false;

const locale: Locale = toLocale(Astro.params.locale);
const L = getCatalog(locale);
const isZh = locale === 'zh-CN';
const T = (en: string, zh: string) => (isZh ? zh : en);
const href = (p: string) => pathFor(locale, p);

const domain = Astro.params.domain ?? '';
// The static build answered /site/<domain> with a redirect to the slash
// form (the asset was a directory); the rendered route has to keep that
// answer, or every old link breaks.
if (!Astro.url.pathname.endsWith('/')) {
  return Astro.redirect(`${Astro.url.pathname}/${Astro.url.search}`, 307);
}
const site: SiteDetail | undefined = await loadRuntimeDetail(
  domain,
  Astro.locals.runtime as unknown as Parameters<typeof loadRuntimeDetail>[1],
  Astro.url.origin,
);
// The page is cached like the static one was (the old _headers rule for
// /site/*): a short fresh window, a long stale window, and the origin only
// pays for a change.
//
// The edge keeps its own, much longer copy (Workers Cache — wrangler.jsonc).
// A hit is served WITHOUT running the Worker, so a repeat visitor costs no
// CPU, no isolate start and no GitHub round trip; the browser still sees
// the old 60 s window, because the edge directive is stripped on the way
// out. The page only changes when the domain is rescanned, so an hour of
// edge freshness is still far fresher than the old static build, which
// only changed on the next full rebuild.
Astro.response.headers.set('Cache-Control', 'public, max-age=60, stale-while-revalidate=600');
Astro.response.headers.set(
  'cloudflare-cdn-cache-control',
  'public, max-age=3600, stale-while-revalidate=7200, stale-if-error=86400',
);
const isPending = site?.grade === 'Pending';
const gc = site ? gradeTextVar(site.grade) : 'var(--text-3)'; // ring label text
const gradeInfo = site ? L.grades[site.grade] : undefined;
const strategyLabel = site ? (L.strategies[site.strategyTag]?.label ?? site.strategyTag) : '';
const scannedAt = site
  ? new Date(site.scannedAt).toISOString().replace('T', ' ').slice(0, 16) + ' UTC'
  : '';
const tabs = [
  { id: 'report', label: L.ui.reportTitle ?? T('Report', '报告') },
  { id: 'evidence', label: L.ui.evidenceTitle ?? T('Evidence', '证据') },
  // Mobile: the third tab holds the whole right column (statement, badge,
  // history, rescan, owner tools) — a neutral name, with "Owner's statement"
  // kept as its own sub-heading inside ClaimBlock.
  { id: 'statement', label: L.ui.siteTools ?? T('Site tools', '站点工具') },
];
const viewsLabel = uiText(L.ui, 'viewsLabel', locale);
const notFound = !site;
if (notFound) Astro.response.status = 404;
// A 404 is never cached at the edge: the domain may be missing from the
// catalog for good, but it may also be a domain whose snapshot could not be
// read this time (the data repo was unreachable). Caching that would keep
// a wrong page up for an hour; not caching it lets the next request try
// again. The catalog answers "is this domain known?" separately from
// "could we read its snapshot?" — see runtime-detail.ts.
if (notFound) Astro.response.headers.set('Cache-Control', 'no-store');
// The edge directive above has the highest precedence, so it has to be
// cleared too — otherwise the 404 would sit in the edge cache for an hour.
if (notFound) Astro.response.headers.set('cloudflare-cdn-cache-control', 'no-store');
// Every domain in the catalog gets a per-site OG card in the same build
// (scripts/make-og-cards.mjs), so the card path is known without asking
// the filesystem at runtime.
const ogImagePath = site ? `/og/sites/${domain}.png` : undefined;
const title = notFound ? (L.ui.notFound as string) : `${domain} — ${site.title ?? site.grade}`;
// Unratable scans carry no score claim — the description omits score/grade numbers.
const description = notFound
  ? (L.ui.notFoundCta as string)
  : isPending
    ? `${domain}: ${L.ui.pendingBadge ?? 'Pending'} · ${T(
        'AI-friendliness rating pending — no readable homepage or robots.txt yet.',
        'AI 友好度评级待定——首页与 robots.txt 均无法读取。',
      )}`
    : `${domain}: ${site.score}/100 · ${site.grade} · ${strategyLabel} — ${T('AI-friendliness rating with full evidence chain.', '带完整证据链的 AI 友好度评级。')}`;
---

<Base title={title} description={description} ogImagePath={ogImagePath}>
  {
    notFound ? (
      <div class="container missing">
        <h1>{L.ui.notFound}</h1>
        <a class="btn" href={href('/submit')}>
          {L.ui.notFoundCta}
        </a>
      </div>
    ) : (
      <div class="container detail" style={`--gc:${gc};`}>
        {site.delistedNote && (
          <p class="retired-banner" role="status">
            {locale === 'zh-CN' ? site.delistedNote.noteZh : site.delistedNote.noteEn}
          </p>
        )}
        <header class="head">
          <div class="head-main">
            <p class="crumb mono">
              <a href={href('/')}>AFR.IM</a> <span>/</span>{' '}
              <span>{L.ui.crumbSite ?? T('site', '站点')}</span>
            </p>
            <div class="head-row">
              {/* The domain itself is a sponsorship link (rel="nofollow
                  sponsored"): visitors who follow it leave for the site —
                  paid links carry the sponsored rel by convention. */}
              <h1 class="domain mono">
                <a href={`https://${site.domain}`} rel="noopener nofollow sponsored" target="_blank">{site.domain}</a>
              </h1>
              {site.verified && <VerifiedTick locale={locale} />}
            </div>
            {site.title && <p class="title">{site.title}</p>}
            <div class="meta">
              <StrategyTag tag={site.strategyTag} locale={locale} />
              <a class="chip mono" href={`${href('/method')}#grades`} title={L.ui.gradesLinkTitle}>
                {`${L.ui.grade}: ${site.grade}${gradeInfo ? ` · ${gradeInfo.slogan}` : ''}`}
              </a>
              <span class="chip mono">
                {L.ui.scanTime}{' '}
                <time datetime={site.scannedAt} data-scan-time>{scannedAt}</time>
              </span>
              {/* "other" = Uncategorized: no chip at all (data-cat keeps filtering) */}
              {site.category && site.category !== 'other' && (
                <a class="chip mono" href={href(`/c/${site.category}`)}>
                  {L.categories[site.category]?.name ?? site.category}
                </a>
              )}
            </div>
          </div>

          <div class="head-ring">
            {isPending ? (
              <>
                <span class="ring-pending" role="img" aria-label={L.ui.pendingNotice}>
                  <span class="ring-pending-letter mono">—</span>
                </span>
                <span class="ring-label mono" style="color:var(--text-3);">
                  {L.ui.pendingBadge ?? 'Pending'}
                </span>
              </>
            ) : (
              <>
                <GradeRing score={site.score} grade={site.grade} size={96} animate />
                <span class="ring-label mono" style={`color:${gc};`}>
                  {gradeInfo?.label ?? site.grade}
                </span>
              </>
            )}
          </div>
        </header>

        {isPending && (
          <p class="pending-notice" role="note">
            {L.ui.pendingNotice}
          </p>
        )}

        <div class="tabbar" role="tablist" aria-label={L.ui.sectionsLabel ?? T('Report sections', '报告分区')}>
          {tabs.map((t, i) => (
            <button
              class="tab mono"
              type="button"
              role="tab"
              id={`tab-${t.id}`}
              aria-controls={`panel-${t.id}`}
              data-tab-btn={t.id}
              aria-selected={i === 0 ? 'true' : 'false'}
              tabindex={i === 0 ? '0' : '-1'}
            >
              {t.label}
            </button>
          ))}
        </div>

        <div class="grid" data-tab="report">
          <div class="col col-left" id="panel-report" role="tabpanel" aria-labelledby="tab-report">
            <ReportCard site={site} locale={locale} />
            {/* Paid promotion — never part of the score (see PromoCard). */}
            <PromoCard domain={site.domain} locale={locale} />
          </div>
          <div class="col col-center" id="panel-evidence" role="tabpanel" aria-labelledby="tab-evidence">
            <ObservationPanel site={site} locale={locale} />
            <EvidenceChain site={site} locale={locale} />
          </div>
          <div class="col col-right" id="panel-statement" role="tabpanel" aria-labelledby="tab-statement">
            <ClaimBlock claim={site.claim} locale={locale} />
            <BadgeEmbed domain={site.domain} grade={site.grade} locale={locale} badgeHref={href('/badges')} />
            {/* Ghost, not solid: Re-scan below stays the single primary action. */}
            {!site.delistedNote && (
              <a class="btn btn-ghost" href={href(`/owner/${site.domain}/`)}>{T('Site owner tools', '站主管理')}</a>
            )}
            <HistorySpark site={site} locale={locale} />
            <TorchBadge domain={site.domain} locale={locale} />
            <TorchBoost domain={site.domain} locale={locale} />
            <p class="views mono" data-views data-domain={site.domain} data-label={viewsLabel}>
              <span class="views-sk" aria-hidden="true"></span>
              <span class="views-txt" data-views-txt hidden></span>
            </p>
            <RescanButton
              domain={site.domain}
              locale={locale}
              scannedAt={site.scannedAt}
              score={site.score}
            />
          </div>

          {/* PV marker — counting moved into the page script: localStorage
              once-per-domain-per-UTC-day dedup + sendBeacon (T3 write cut) */}
          <span class="pv-pixel" data-pv={site.domain} hidden aria-hidden="true"></span>
        </div>
      </div>
    )
  }
</Base>

<style>
  .missing {
    padding: 80px 0;
    text-align: center;
  }

  .detail {
    padding-top: 28px;
  }

  /* ── header ─────────────────────────────────────────── */
  .head {
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    gap: 24px;
    padding-bottom: 24px;
    border-bottom: 1px solid var(--line);
    margin-bottom: 24px;
  }
  .crumb {
    margin: 0 0 8px;
    font-size: 12px;
    color: var(--text-3);
  }
  .crumb a:hover {
    color: var(--brand-link);
  }
  .crumb span {
    margin: 0 4px;
  }
  .head-row {
    display: flex;
    align-items: center;
    gap: 10px;
  }
  .domain {
    margin: 0;
    font-family: var(--font-mono);
    font-size: clamp(26px, 4vw, 38px);
    font-weight: 700;
    letter-spacing: -0.02em;
    color: var(--text-1);
    word-break: break-all;
  }
  /* The h1 wraps a sponsorship link — keep the exact heading look. */
  .domain a {
    color: inherit;
    text-decoration: none;
  }
  .domain a:hover {
    color: var(--brand-link);
  }
  .title {
    margin: 6px 0 0;
    font-size: 15px;
    color: var(--text-2);
  }
  .meta {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 8px;
    margin-top: 14px;
  }
  .meta .chip {
    gap: 6px;
    font-size: 11.5px;
  }
  .meta a.chip:hover {
    border-color: var(--brand);
    color: var(--brand-link);
  }

  .head-ring {
    display: grid;
    justify-items: center;
    gap: 8px;
    flex: none;
  }
  .ring-label {
    font-size: 12px;
  }

  /* Pending (unratable) placeholder — neutral track, no grade color, no score */
  .ring-pending {
    display: grid;
    place-items: center;
    width: 96px;
    height: 96px;
    border: 8px solid var(--line);
    border-radius: 50%;
    color: var(--text-3);
  }
  .ring-pending-letter {
    font-size: 34px; /* same letter size as GradeRing at 96px */
    line-height: 1;
    color: var(--text-3);
  }
  .pending-notice {
    margin: 0 0 24px;
    padding: 14px 16px;
    background: var(--bg-surface);
    border: 1px dashed var(--line);
    border-radius: var(--radius);
    color: var(--text-2);
    font-size: 14px;
    line-height: 1.6;
  }

  /* ── runtime views counter (right column) ─────────────── */
  /* one reserved line: skeleton → count → (on API failure) hidden, no shift */
  .views {
    display: flex;
    align-items: center;
    gap: 6px;
    margin: 0;
    min-height: 18px;
    font-size: 11.5px;
    color: var(--text-3);
    font-variant-numeric: tabular-nums;
  }
  .views[data-state='error'] {
    /* keep the reserved line, hide the content — zero layout shift */
    visibility: hidden;
  }
  .views-sk {
    width: 64px;
    height: 11px;
    border-radius: var(--r-1);
    background: var(--line);
    animation: views-breathe 1.6s ease-in-out infinite;
  }
  .views[data-state='ready'] .views-sk {
    display: none;
  }
  .views-txt {
    font-variant-numeric: tabular-nums;
  }
  .views-txt[hidden] {
    display: none;
  }
  @keyframes views-breathe {
    0%,
    100% {
      filter: brightness(1);
    }
    50% {
      filter: brightness(1.6);
    }
  }

  /* PV marker: hidden, no layout cost */
  .pv-pixel {
    display: none;
  }

  /* ── mobile tab bar (≤767) ──────────────────────────── */
  .tabbar {
    display: none;
    gap: 6px;
    margin-bottom: 16px;
    border-bottom: 1px solid var(--line);
  }
  .tab {
    padding: 8px 12px;
    font-size: 12.5px;
    color: var(--text-3);
    border-bottom: 2px solid transparent;
    transition: color var(--t-micro) var(--ease), border-color var(--t-micro) var(--ease);
  }
  .tab[aria-selected='true'] {
    color: var(--text-1);
    border-bottom-color: var(--brand);
  }

  /* ── three columns ──────────────────────────── */
  .grid {
    display: grid;
    grid-template-columns: 340px minmax(0, 1fr) 320px;
    gap: 24px;
    align-items: start;
    padding-bottom: 8px;
  }
  .col-left,
  .col-right {
    position: sticky;
    top: 80px;
  }
  .col-right {
    display: grid;
    gap: 16px;
  }

  /* tablet: 2 + 1, right column flows below */
  @media (max-width: 1279px) {
    .grid {
      grid-template-columns: 340px minmax(0, 1fr);
    }
    .col-right {
      position: static;
      grid-column: 1 / -1;
      grid-template-columns: repeat(2, minmax(0, 1fr));
      align-items: start;
    }
  }

  /* phone: tabs (Report / Evidence / Statement) */
  @media (max-width: 767px) {
    .detail {
      padding-top: 20px;
    }
    .head {
      /* domain/h1 first — the ring no longer pushes the title down */
      flex-direction: column;
      gap: 16px;
    }
    .head-ring {
      /* ring sits below the title, right-aligned — never above the domain */
      justify-items: end;
      align-self: stretch;
    }
    .tabbar {
      display: flex;
      overflow-x: auto;
    }
    .grid {
      grid-template-columns: minmax(0, 1fr);
      gap: 0;
    }
    .col {
      display: none;
    }
    .col-left,
    .col-center,
    .col-right {
      position: static;
      grid-column: auto;
    }
    .col-right {
      grid-template-columns: minmax(0, 1fr);
      gap: 16px;
    }
    .grid[data-tab='report'] .col-left {
      display: block;
    }
    .grid[data-tab='evidence'] .col-center {
      display: block;
    }
    .grid[data-tab='statement'] .col-right {
      display: grid;
    }
  }
      .retired-banner {
        margin: 0 0 16px;
        padding: 10px 14px;
        border: 1px dashed var(--line);
        border-radius: var(--r-2);
        background: var(--bg-elevated);
        color: var(--text-2);
        font-size: 13.5px;
      }
</style>

<script>
  // ≤767 tab switcher (vanilla, no framework) — desktop shows all three columns.
  // Roving tabindex: only the selected tab is in the tab order.
  const grid = document.querySelector<HTMLElement>('.grid[data-tab]');
  if (grid) {
    const buttons = document.querySelectorAll<HTMLButtonElement>('[data-tab-btn]');
    const select = (btn: HTMLButtonElement) => {
      grid.dataset.tab = btn.dataset.tabBtn ?? 'report';
      for (const other of buttons) {
        other.setAttribute('aria-selected', String(other === btn));
        other.tabIndex = other === btn ? 0 : -1;
      }
    };
    buttons.forEach((btn, i) => {
      btn.addEventListener('click', () => select(btn));
      btn.addEventListener('keydown', (e) => {
        const key = e.key;
        if (key !== 'ArrowLeft' && key !== 'ArrowRight' && key !== 'Home' && key !== 'End') return;
        e.preventDefault();
        let next = i;
        if (key === 'ArrowLeft') next = (i - 1 + buttons.length) % buttons.length;
        else if (key === 'ArrowRight') next = (i + 1) % buttons.length;
        else if (key === 'Home') next = 0;
        else if (key === 'End') next = buttons.length - 1;
        const target = buttons[next];
        if (target) {
          target.focus();
          select(target);
        }
      });
    });
  }

  // PV beacon (T3 write cut): count each site at most once per browser per
  // UTC day — localStorage dedup, then sendBeacon (POST) so the ping never
  // competes with page resources. Storage failures (private mode, quota)
  // degrade to counting every view, which the server-side daily cap bounds.
  const pvDomain = document.querySelector<HTMLElement>('[data-pv]')?.dataset.pv ?? '';
  if (pvDomain) {
    const day = new Date().toISOString().slice(0, 10); // UTC — matches counted_on
    const key = `afr-pv:${pvDomain}:${day}`;
    let fresh = true;
    try {
      if (localStorage.getItem(key)) fresh = false;
      else localStorage.setItem(key, '1');
    } catch {
      /* storage unavailable → count every view (capped server-side) */
    }
    if (fresh) {
      const url = '/api/v1/pv?site=' + encodeURIComponent(pvDomain);
      if (navigator.sendBeacon) navigator.sendBeacon(url);
      else fetch(url, { method: 'POST', keepalive: true }).catch(() => {});
    }
  }

  // Runtime views counter — GET /api/v1/sites/:domain/views. Skeleton until the
  // response lands; on API failure the element hides but keeps its reserved
  // line (visibility) so the right column never shifts.
  for (const el of document.querySelectorAll<HTMLElement>('[data-views]')) {
    const domain = el.dataset.domain ?? '';
    const label = el.dataset.label ?? 'Views';
    const out = el.querySelector<HTMLElement>('[data-views-txt]');
    const done = (text: string | null) => {
      if (text !== null && out) {
        out.textContent = text;
        out.hidden = false;
        el.dataset.state = 'ready';
      } else {
        el.dataset.state = 'error';
      }
    };
    fetch('/api/v1/sites/' + encodeURIComponent(domain) + '/views', {
      headers: { accept: 'application/json' },
    })
      .then((r) => (r.status === 200 ? r.json().catch(() => null) : null))
      .then((body) => {
        const n = body && typeof body.views === 'number' ? body.views : null;
        done(n !== null ? `${label} · ${n}` : null);
      })
      .catch(() => done(null));
  }
</script>
