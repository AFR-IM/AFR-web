---
// P3 detail page — /site/:domain (spec §10.3 "product's soul page").
// Layout per §10.7: 340px report card │ 1fr evidence chain │ 320px
// statement/badge/history, left+right sticky at top 80px; 768–1279 → 2+1;
// ≤767 → three tabs (Report / Evidence / Statement).

import Base from '../../../layouts/Base.astro';
import GradeRing from '../../../components/grade/GradeRing.astro';
import StrategyTag from '../../../components/detail/StrategyTag.astro';
import VerifiedTick from '../../../components/detail/VerifiedTick.astro';
import ReportCard from '../../../components/detail/ReportCard.astro';
import EvidenceChain from '../../../components/detail/EvidenceChain.astro';
import ClaimBlock from '../../../components/detail/ClaimBlock.astro';
import ClaimForm from '../../../components/detail/ClaimForm.astro';
import BadgeEmbed from '../../../components/detail/BadgeEmbed.astro';
import VerifyPanel from '../../../components/detail/VerifyPanel.astro';
import HistorySpark from '../../../components/detail/HistorySpark.astro';
import RescanButton from '../../../components/detail/RescanButton.astro';
import { getCatalog, LOCALES, pathFor, toLocale, type Locale } from '../../../i18n/loader.ts';
import { uiText } from '../../../components/home/fallbacks.ts';
import { listAllSites, loadSite } from '../../../data/loader.ts';
import type { SiteDetail } from '../../../data/types.ts';
import { gradeVar } from '../../../utils/grade.ts';
import { ENGINE_VERSION } from '../../../../../../packages/afr/src/index.ts';
import { SCANNER_VERSION } from '../../../../../../packages/scanner/src/http.ts';

export function getStaticPaths() {
  const out: { params: { locale?: string; domain: string } }[] = [];
  for (const locale of LOCALES) {
    // Both rated and unratable sites get a detail page (scored + pending).
    for (const card of listAllSites()) {
      out.push({ params: { locale: locale === 'en' ? undefined : locale, domain: card.domain } });
    }
  }
  return out;
}

/** Sites without a full snapshot render a "pending scan" state. */
function resolveDetail(domain: string): SiteDetail | undefined {
  const full = loadSite(domain);
  if (full) return full;
  const card = listAllSites().find((s) => s.domain === domain);
  if (!card) return undefined;
  return {
    ...card,
    engineVersion: ENGINE_VERSION,
    scannerVersion: SCANNER_VERSION,
    layers: [],
    breakdown: {},
    history: [],
  };
}

const locale: Locale = toLocale(Astro.params.locale);
const L = getCatalog(locale);
const isZh = locale === 'zh-CN';
const T = (en: string, zh: string) => (isZh ? zh : en);
const href = (p: string) => pathFor(locale, p);

const domain = Astro.params.domain ?? '';
const site = resolveDetail(domain);
const isPending = site?.grade === 'Pending';
const gc = site ? gradeVar(site.grade) : 'var(--text-3)';
const gradeInfo = site ? L.grades[site.grade] : undefined;
const strategyLabel = site ? (L.strategies[site.strategyTag]?.label ?? site.strategyTag) : '';
const scannedAt = site
  ? new Date(site.scannedAt).toISOString().replace('T', ' ').slice(0, 16) + ' UTC'
  : '';
const tabs = [
  { id: 'report', label: L.ui.reportTitle ?? T('Report', '报告') },
  { id: 'evidence', label: L.ui.evidenceTitle ?? T('Evidence', '证据') },
  { id: 'statement', label: L.ui.statementTitle ?? T('Statement', '声明') },
];
const viewsLabel = uiText(L.ui, 'viewsLabel', locale);
const claimFormVisible = !!site?.verified || !!site?.claim;
const notFound = !site;
const title = notFound ? (L.ui.notFound as string) : `${domain} — ${site.title ?? site.grade}`;
// Unratable scans carry no score claim — the description omits score/grade numbers.
const description = notFound
  ? (L.ui.notFoundCta as string)
  : isPending
    ? `${domain}: ${L.ui.pendingBadge ?? 'Pending'} · ${T(
        'AI-friendliness rating pending — no readable homepage or robots.txt yet.',
        'AI 友好度评级待定——首页与 robots.txt 均无法读取。',
      )}`
    : `${domain}: ${site.score}/100 · ${site.grade} · ${strategyLabel} — ${T('AI-friendliness rating with full evidence chain.', '带完整证据链的 AI 友好度评级。')}`;
---

<Base title={title} description={description}>
  {
    notFound ? (
      <div class="container missing">
        <h1>{L.ui.notFound}</h1>
        <a class="btn" href={href('/submit')}>
          {L.ui.notFoundCta}
        </a>
      </div>
    ) : (
      <div class="container detail" style={`--gc:${gc};`}>
        <header class="head">
          <div class="head-main">
            <p class="crumb mono">
              <a href={href('/')}>AFR.IM</a> <span>/</span> <span>site</span>
            </p>
            <div class="head-row">
              <h1 class="domain mono">{site.domain}</h1>
              {site.verified && <VerifiedTick locale={locale} />}
            </div>
            {site.title && <p class="title">{site.title}</p>}
            <div class="meta">
              <StrategyTag tag={site.strategyTag} locale={locale} />
              <span class="chip mono">
                {`${L.ui.grade}: ${site.grade}${gradeInfo ? ` · ${gradeInfo.slogan}` : ''}`}
              </span>
              <span class="chip mono">
                {L.ui.scanTime}{' '}
                <time datetime={site.scannedAt} data-scan-time>{scannedAt}</time>
              </span>
              {site.category && (
                <a class="chip mono" href={href(`/c/${site.category}`)}>
                  {L.categories[site.category]?.name ?? site.category}
                </a>
              )}
            </div>
          </div>

          <div class="head-ring">
            {isPending ? (
              <>
                <span class="ring-pending" role="img" aria-label={L.ui.pendingNotice}>
                  <span class="ring-pending-letter mono">—</span>
                </span>
                <span class="ring-label mono" style="color:var(--text-3);">
                  {L.ui.pendingBadge ?? 'Pending'}
                </span>
              </>
            ) : (
              <>
                <GradeRing score={site.score} grade={site.grade} size={96} animate />
                <span class="ring-label mono" style={`color:${gc};`}>
                  {gradeInfo?.label ?? site.grade}
                </span>
              </>
            )}
          </div>
        </header>

        {isPending && (
          <p class="pending-notice" role="note">
            {L.ui.pendingNotice}
          </p>
        )}

        <div class="tabbar" role="tablist" aria-label={L.ui.reportTitle}>
          {tabs.map((t, i) => (
            <button
              class="tab mono"
              type="button"
              role="tab"
              data-tab-btn={t.id}
              aria-selected={i === 0 ? 'true' : 'false'}
            >
              {t.label}
            </button>
          ))}
        </div>

        <div class="grid" data-tab="report">
          <div class="col col-left">
            <ReportCard site={site} locale={locale} />
          </div>
          <div class="col col-center">
            <EvidenceChain site={site} locale={locale} />
          </div>
          <div class="col col-right">
            <ClaimBlock claim={site.claim} locale={locale} />
            <BadgeEmbed domain={site.domain} grade={site.grade} locale={locale} badgeHref={href('/badge')} />
            <VerifyPanel domain={site.domain} locale={locale} verified={!!site.verified} />
            <ClaimForm domain={site.domain} locale={locale} visible={claimFormVisible} />
            <HistorySpark site={site} locale={locale} />
            <p class="views mono" data-views data-domain={site.domain} data-label={viewsLabel}>
              <span class="views-sk" aria-hidden="true"></span>
              <span class="views-txt" data-views-txt hidden></span>
            </p>
            <RescanButton
              domain={site.domain}
              locale={locale}
              scannedAt={site.scannedAt}
              score={site.score}
            />
          </div>

          {/* PV pixel — counts this detail view; absolute + 1×1 ⇒ zero CLS */}
          <img
            class="pv-pixel"
            src={`/api/v1/pv?site=${encodeURIComponent(site.domain)}`}
            alt=""
            aria-hidden="true"
            width="1"
            height="1"
          />
        </div>
      </div>
    )
  }
</Base>

<style>
  .missing {
    padding: 80px 0;
    text-align: center;
  }

  .detail {
    padding-top: 28px;
  }

  /* ── header ─────────────────────────────────────────── */
  .head {
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    gap: 24px;
    padding-bottom: 24px;
    border-bottom: 1px solid var(--line);
    margin-bottom: 24px;
  }
  .crumb {
    margin: 0 0 8px;
    font-size: 12px;
    color: var(--text-3);
  }
  .crumb a:hover {
    color: var(--brand);
  }
  .crumb span {
    margin: 0 4px;
  }
  .head-row {
    display: flex;
    align-items: center;
    gap: 10px;
  }
  .domain {
    margin: 0;
    font-family: var(--font-mono);
    font-size: clamp(26px, 4vw, 38px);
    font-weight: 700;
    letter-spacing: -0.02em;
    color: var(--text-1);
    word-break: break-all;
  }
  .title {
    margin: 6px 0 0;
    font-size: 15px;
    color: var(--text-2);
  }
  .meta {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 8px;
    margin-top: 14px;
  }
  .meta .chip {
    gap: 6px;
    font-size: 11.5px;
  }
  .meta a.chip:hover {
    border-color: var(--brand);
    color: var(--brand);
  }

  .head-ring {
    display: grid;
    justify-items: center;
    gap: 8px;
    flex: none;
  }
  .ring-label {
    font-size: 12px;
  }

  /* Pending (unratable) placeholder — neutral track, no grade color, no score */
  .ring-pending {
    display: grid;
    place-items: center;
    width: 96px;
    height: 96px;
    border: 8px solid var(--line);
    border-radius: 50%;
    color: var(--text-3);
  }
  .ring-pending-letter {
    font-size: 34px; /* same letter size as GradeRing at 96px */
    line-height: 1;
    color: var(--text-3);
  }
  .pending-notice {
    margin: 0 0 24px;
    padding: 14px 16px;
    background: var(--bg-surface);
    border: 1px dashed var(--line);
    border-radius: var(--radius);
    color: var(--text-2);
    font-size: 14px;
    line-height: 1.6;
  }

  /* ── runtime views counter (right column) ─────────────── */
  /* one reserved line: skeleton → count → (on API failure) hidden, no shift */
  .views {
    display: flex;
    align-items: center;
    gap: 6px;
    margin: 0;
    min-height: 18px;
    font-size: 11.5px;
    color: var(--text-3);
    font-variant-numeric: tabular-nums;
  }
  .views[data-state='error'] {
    /* keep the reserved line, hide the content — zero layout shift */
    visibility: hidden;
  }
  .views-sk {
    width: 64px;
    height: 11px;
    border-radius: var(--r-1);
    background: var(--line);
    animation: views-breathe 1.6s ease-in-out infinite;
  }
  .views[data-state='ready'] .views-sk {
    display: none;
  }
  .views-txt {
    font-variant-numeric: tabular-nums;
  }
  .views-txt[hidden] {
    display: none;
  }
  @keyframes views-breathe {
    0%,
    100% {
      filter: brightness(1);
    }
    50% {
      filter: brightness(1.6);
    }
  }

  /* PV pixel: absolute offscreen, 1×1 — counts the view with zero CLS */
  .pv-pixel {
    position: absolute;
    top: 0;
    left: -9999px;
    width: 1px;
    height: 1px;
    border: 0;
    margin: -1px;
    padding: 0;
    overflow: hidden;
    clip-path: inset(50%);
    white-space: nowrap;
  }

  /* ── mobile tab bar (≤767) ──────────────────────────── */
  .tabbar {
    display: none;
    gap: 6px;
    margin-bottom: 16px;
    border-bottom: 1px solid var(--line);
  }
  .tab {
    padding: 8px 12px;
    font-size: 12.5px;
    color: var(--text-3);
    border-bottom: 2px solid transparent;
    transition: color var(--t-micro) var(--ease), border-color var(--t-micro) var(--ease);
  }
  .tab[aria-selected='true'] {
    color: var(--text-1);
    border-bottom-color: var(--brand);
  }

  /* ── three columns (§10.7) ──────────────────────────── */
  .grid {
    display: grid;
    grid-template-columns: 340px minmax(0, 1fr) 320px;
    gap: 24px;
    align-items: start;
    padding-bottom: 8px;
  }
  .col-left,
  .col-right {
    position: sticky;
    top: 80px;
  }
  .col-right {
    display: grid;
    gap: 16px;
  }

  /* tablet: 2 + 1, right column flows below (§10.7) */
  @media (max-width: 1279px) {
    .grid {
      grid-template-columns: 340px minmax(0, 1fr);
    }
    .col-right {
      position: static;
      grid-column: 1 / -1;
      grid-template-columns: repeat(2, minmax(0, 1fr));
      align-items: start;
    }
  }

  /* phone: tabs (Report / Evidence / Statement) */
  @media (max-width: 767px) {
    .detail {
      padding-top: 20px;
    }
    .head {
      flex-direction: column-reverse;
      gap: 16px;
    }
    .head-ring {
      justify-items: start;
    }
    .tabbar {
      display: flex;
      overflow-x: auto;
    }
    .grid {
      grid-template-columns: minmax(0, 1fr);
      gap: 0;
    }
    .col {
      display: none;
    }
    .col-left,
    .col-center,
    .col-right {
      position: static;
      grid-column: auto;
    }
    .col-right {
      grid-template-columns: minmax(0, 1fr);
      gap: 16px;
    }
    .grid[data-tab='report'] .col-left {
      display: block;
    }
    .grid[data-tab='evidence'] .col-center {
      display: block;
    }
    .grid[data-tab='statement'] .col-right {
      display: grid;
    }
  }
</style>

<script>
  // ≤767 tab switcher (vanilla, no framework) — desktop shows all three columns.
  const grid = document.querySelector<HTMLElement>('.grid[data-tab]');
  if (grid) {
    const buttons = document.querySelectorAll<HTMLButtonElement>('[data-tab-btn]');
    for (const btn of buttons) {
      btn.addEventListener('click', () => {
        grid.dataset.tab = btn.dataset.tabBtn ?? 'report';
        for (const other of buttons) other.setAttribute('aria-selected', String(other === btn));
      });
    }
  }

  // Runtime views counter — GET /api/v1/sites/:domain/views. Skeleton until the
  // response lands; on API failure the element hides but keeps its reserved
  // line (visibility) so the right column never shifts.
  for (const el of document.querySelectorAll<HTMLElement>('[data-views]')) {
    const domain = el.dataset.domain ?? '';
    const label = el.dataset.label ?? 'Views';
    const out = el.querySelector<HTMLElement>('[data-views-txt]');
    const done = (text: string | null) => {
      if (text !== null && out) {
        out.textContent = text;
        out.hidden = false;
        el.dataset.state = 'ready';
      } else {
        el.dataset.state = 'error';
      }
    };
    fetch('/api/v1/sites/' + encodeURIComponent(domain) + '/views', {
      headers: { accept: 'application/json' },
    })
      .then((r) => (r.status === 200 ? r.json().catch(() => null) : null))
      .then((body) => {
        const n = body && typeof body.views === 'number' ? body.views : null;
        done(n !== null ? `${label} · ${n}` : null);
      })
      .catch(() => done(null));
  }
</script>
