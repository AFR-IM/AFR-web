---
// Prerendered: this page is a static asset. Only the detail pages are
// rendered on demand (SSOT item 20 — the catalog must not cost assets).
export const prerender = true;
// Search page — reads ?q= and renders results client-side from the search
// index: the server ships only the page chrome, then the first 50 matches
// render as DomainCards cloned from an inert template, with "Show more"
// appending 50 more (bounded DOM at 100k scale). The Sponsored row appears
// above the results only while the query is non-empty and never mixes into
// the natural cards. Zero results → searchEmpty + submit CTA.
//
// The index is sharded (see apps/web/scripts/search-index-contract.mjs): a
// manifest lists the shards, and the browser fetches what it needs — the
// leaderboard slice for the browse case (an empty query), every shard for
// a query. A payload from before the shards existed is still read as one
// legacy file.
//
// Zero results for a bare domain → "not collected yet" block: an explicit,
// user-triggered scan (POST /api/v1/search-scan) plus 10s polling of
// GET /api/v1/sites/:domain until the report lands. The POST NEVER fires on
// typing — only on button click (abuse guard).

import Base from '../../layouts/Base.astro';
import DomainCard from '../../components/home/DomainCard.astro';
import SponsoredCard from '../../components/home/SponsoredCard.astro';
import Turnstile from '../../components/security/Turnstile.astro';
import { getCatalog, pathFor, toLocale } from '../../i18n/loader.ts';
import { listSites } from '../../data/loader.ts';
import { uiText } from '../../components/home/fallbacks.ts';
import { GRADE_VAR, GRADE_TEXT_VAR } from '../../utils/grade.ts';
// The grade table is NOT written into the search index any more: the browser
// derives the grade from the score with these thresholds. They are the
// engine's own table (packages/shared), serialized into the page — the page
// never keeps a second copy of the grade rules.
import { GRADE_THRESHOLDS } from '../../../../../packages/shared/src/index.ts';

export function getStaticPaths() {
  return [{ params: { locale: undefined } }, { params: { locale: 'zh-CN' } }];
}

const locale = toLocale(Astro.params.locale);
const L = getCatalog(locale);
const href = (p: string) => pathFor(locale, p);

const sites = listSites();
const tplSite = sites[0]; // inert template placeholder (never rendered)
// Bounded DOM: results render client-side, 50 at a time
const PAGE_SIZE = 50;
const countTpl = uiText(L.ui, 'siteCount', locale);
const title = uiText(L.ui, 'searchTitle', locale);
const placeholder = L.ui.searchPlaceholder ?? 'Search a domain…';
const emptyText = L.ui.searchEmpty ?? 'No site matches that search.';
const submitCta = L.ui.submitCta ?? 'Submit domain';

// "not collected yet" scan block — catalog-first, inline EN/ZH fallback copy
const scanHeading = uiText(L.ui, 'scanHeading', locale);
const scanDesc = uiText(L.ui, 'scanDesc', locale);
const scanBtn = uiText(L.ui, 'scanBtn', locale);
const scanBusy = uiText(L.ui, 'scanBusy', locale);
const scanQueued = uiText(L.ui, 'scanQueued', locale);
const scanPolling = uiText(L.ui, 'scanPolling', locale);
const scanStill = uiText(L.ui, 'scanStill', locale);
const scanTimeout = uiText(L.ui, 'scanTimeout', locale);
const scanRate = uiText(L.ui, 'scanRate', locale);
const scanError = uiText(L.ui, 'scanError', locale);
const scanNet = uiText(L.ui, 'scanNet', locale);
const scanOpen = uiText(L.ui, 'scanResultOpen', locale);
const invalidText = uiText(L.ui, 'submitInvalid', locale); // reused for the domain check
// Human check (Cloudflare Turnstile) — the worker gates POST /api/v1/search-scan.
const turnstileRequiredText =
  L.ui.turnstileRequired ?? 'Please complete the human verification, then try again.';
const turnstileFailedText = L.ui.turnstileFailed ?? 'Human verification failed — please try again.';
const turnstileUnavailableText =
  L.ui.turnstileUnavailable ?? 'The human check could not be loaded — check your connection and try again.';
const gradeLabel = L.ui.grade ?? 'Grade';
const scoreLabel = L.ui.score ?? 'Score';
const strategyLabel = L.ui.strategy ?? 'Strategy';
const strategyLabels = JSON.stringify(
  Object.fromEntries(Object.entries(L.strategies).map(([k, v]) => [k, v.label])),
);
const catNames = JSON.stringify(
  Object.fromEntries(Object.entries(L.categories).map(([k, v]) => [k, v.name])),
);
// "Show more" copy — catalog-first with inline EN/ZH fallbacks
const loadMoreLabel = L.ui.loadMore ?? 'Load more';
const loadingText = L.ui.loading ?? 'Loading…';
const doneTpl = uiText(L.ui, 'loadMoreDone', locale);
const progressTpl = uiText(L.ui, 'loadMoreProgress', locale);
const loadMoreErrorText = uiText(L.ui, 'loadMoreError', locale);

---

<Base title={title} description={L.ui.tagline}>
  <div class="container page">
    <h1 class="page-title">{title}</h1>

    <form class="search-form" id="search-form" role="search" aria-label={title} action={href('/search')} method="get">
      <input
        class="search-input mono"
        id="search-input"
        type="search"
        name="q"
        data-ad-search
        placeholder={placeholder}
        aria-label={placeholder}
        autocomplete="off"
      />
    </form>

    <p class="result-count mono" data-count data-count-template={countTpl} hidden></p>
    <p class="scan-sr" data-count-live role="status" aria-atomic="true"></p>

    {/* the keyword slot has its own lifecycle, independent of the results */}
    <SponsoredCard slot="search-top" locale={locale} />

    <div
      class="grid"
      data-grid
      data-page-size={PAGE_SIZE}
      data-report-base={href('/site/')}
      data-grade-vars={JSON.stringify(GRADE_VAR)}
      data-grade-thresholds={JSON.stringify(GRADE_THRESHOLDS)}
      data-cat-names={catNames}
    ></div>

    {/* inert card template — runtime result cards clone this markup so the
        Astro-scoped classes/styles match exactly */}
    {tplSite && (
      <template data-card-tpl>
        <DomainCard site={tplSite} locale={locale} index={0} />
      </template>
    )}

    <div
      class="more"
      data-more-wrap
      hidden
      data-tpl-done={doneTpl}
      data-tpl-progress={progressTpl}
      data-msg-error={loadMoreErrorText}
      data-msg-loading={loadingText}
    >
      <button type="button" class="btn more-btn" data-more>{loadMoreLabel}</button>
      <p class="more-status mono" data-more-status role="status" aria-live="polite"></p>
    </div>

    <div class="empty" data-empty hidden>
      <p>{emptyText}</p>
      <a class="btn" href={href('/submit')}>{submitCta}</a>
    </div>

    {/* "not collected yet" — shown only when a bare-domain query has zero hits */}
    <section
      class="scan"
      data-scan
      hidden
      data-label-idle={scanBtn}
      data-label-busy={scanBusy}
      data-tpl-queued={scanQueued}
      data-tpl-polling={scanPolling}
      data-still={scanStill}
      data-tpl-timeout={scanTimeout}
      data-tpl-rate={scanRate}
      data-msg-error={scanError}
      data-msg-net={scanNet}
      data-msg-invalid={invalidText}
      data-msg-turnstile={turnstileRequiredText}
      data-msg-turnstile-failed={turnstileFailedText}
      data-msg-turnstile-unavailable={turnstileUnavailableText}
      data-eta-default="180"
      data-locale={locale}
      data-report-base={href('/site/')}
      data-label-grade={gradeLabel}
      data-label-score={scoreLabel}
      data-label-strategy={strategyLabel}
      data-strategies={strategyLabels}
      data-grade-vars={JSON.stringify(GRADE_TEXT_VAR)}
    >
      <h2 class="scan-kicker mono">{scanHeading}</h2>
      <p class="scan-domain mono" data-scan-domain></p>
      <p class="scan-desc">{scanDesc}</p>

      {/* human check — the worker gates POST /api/v1/search-scan on it */}
      <Turnstile action="afr_search_scan" locale={locale} />

      <div class="scan-row">
        <button class="btn scan-btn" type="button" data-scan-btn>
          <span class="scan-spinner" aria-hidden="true"></span>
          <span data-scan-btn-txt>{scanBtn}</span>
        </button>
        <a class="scan-alt" href={href('/submit')}>{submitCta}</a>
      </div>

      <!-- visual countdown (phase changes are announced via data-scan-live) -->
      <p class="scan-status mono" data-scan-status aria-hidden="true"></p>
      <p class="scan-sr" data-scan-live role="status" aria-live="polite"></p>

      <div class="scan-result" data-scan-result hidden>
        <span class="sr-grade mono" data-sr-grade></span>
        <span class="sr-info">
          <span class="sr-domain mono" data-sr-domain></span>
          <span class="sr-meta mono" data-sr-meta></span>
          <a class="btn sr-open" data-sr-link href={href('/site/')}>{scanOpen}</a>
        </span>
      </div>
    </section>
  </div>

  <!-- inline so the ?q= filter applies before first paint (no flash / CLS) -->
  <script is:inline>
    (function () {
      var grid = document.querySelector('[data-grid]');
      var cardTemplate = document.querySelector('[data-card-tpl]');
      if (!grid || !cardTemplate) return;
      var input = document.getElementById('search-input');
      var form = document.getElementById('search-form');
      var empty = document.querySelector('[data-empty]');
      var countEl = document.querySelector('[data-count]');
      var countLive = document.querySelector('[data-count-live]');
      var countTimer;
      function announceCount(message) {
        if (!countLive) return;
        clearTimeout(countTimer);
        if (!message) {
          countLive.textContent = '';
          return;
        }
        countTimer = setTimeout(function () { countLive.textContent = message; }, 300);
      }
      var countTpl = (countEl && countEl.getAttribute('data-count-template')) || '{n} sites';
      var scanBox = document.querySelector('[data-scan]');
      var moreWrap = document.querySelector('[data-more-wrap]');
      var moreBtn = moreWrap && moreWrap.querySelector('[data-more]');
      var moreStatus = moreWrap && moreWrap.querySelector('[data-more-status]');
      var moreLabel = moreBtn ? moreBtn.textContent : '';

      /* runtime search index + incremental rendering state (chrome-only SSR) */
      var PAGE = parseInt(grid.getAttribute('data-page-size'), 10) || 50;
      var reportBase = grid.getAttribute('data-report-base') || '/site/';
      var gradeVars = {};
      var catNames = {};
      var thresholds = [];
      try { gradeVars = JSON.parse(grid.getAttribute('data-grade-vars') || '{}'); } catch (e) {}
      try { catNames = JSON.parse(grid.getAttribute('data-cat-names') || '{}'); } catch (e) {}
      try { thresholds = JSON.parse(grid.getAttribute('data-grade-thresholds') || '[]'); } catch (e) {}
      var RATED = ['A', 'B', 'C', 'D', 'F'];
      /* The index carries the score, not the grade: the grade is derived here
         with the engine's own thresholds, which the server serialized into
         the page (packages/shared GRADE_THRESHOLDS). */
      function gradeFor(score) {
        for (var i = 0; i < thresholds.length; i++) {
          if (score >= thresholds[i].min) return thresholds[i].grade;
        }
        return thresholds.length ? thresholds[thresholds.length - 1].grade : '';
      }
      /* The index is sharded: the manifest lists the shards, and the browser
         fetches only what it needs. The leaderboard slice serves the browse
         case (an empty query — the page must not download the whole catalog
         to show the first fifty cards); a query needs the whole catalog, so
         every shard is fetched, in parallel, and merged back into one
         score-desc list. A payload from before the shards existed (no
         manifest, or a manifest this browser does not understand) is still
         read as one legacy file. */
      var INDEX = {
        entries: null, /* the entries loaded so far, score desc */
        total: 0, /* the size of the whole catalog */
        full: false, /* true once every shard is in */
        topPromise: null, /* the leaderboard slice, in flight */
        fullPromise: null, /* every shard, in flight */
      };
      var DATA_DIR = '/data/';
      var MANIFEST_URL = DATA_DIR + 'search-index-manifest.json';
      var LEGACY_URL = DATA_DIR + 'search-index.json';
      var matches = []; /* entries matching the current query */
      var domCount = 0; /* result cards currently in the grid */
      var cap = PAGE; /* how many matches may be rendered */
      var lastKey = null; /* query the DOM was built for */
      var currentQ = '';

      var DOMAIN_RE = /^(?:[a-z0-9](?:[a-z0-9-]{0,61}[a-z0-9])?\.)+[a-z]{2,63}$/i;
      var POLL_MS = 10000;
      var MAX_MS = 300000; /* ~5 min of polite polling */

      /* domain helpers — mirror the server's normalizeDomain() */
      function normDomain(raw) {
        return (raw || '')
          .trim()
          .toLowerCase()
          .replace(/^[a-z]+:\/\//, '')
          .replace(/^www\./, '')
          .split('/')[0]
          .split('?')[0]
          .split('#')[0]
          .replace(/:\d+$/, '')
          .replace(/\.$/, '');
      }
      function isDomainish(raw) {
        var q = (raw || '').trim();
        if (!q || /\s/.test(q)) return false;
        var d = normDomain(q);
        return d.length >= 4 && d.length <= 253 && d.indexOf('.') > 0;
      }

      /* ── scan state machine: idle → submitting → queued → polling → done ── */
      var SCAN = {
        domain: '',
        phase: 'idle', /* idle | submitting | polling | done */
        eta: 0,
        polled: false,
        msgUntil: 0, /* body-message flash window (degraded 5xx responses) */
        deadline: 0,
        tickTimer: 0,
        waitTimer: 0,
        inFlight: false,
      };
      var els = {};

      function attr(name) {
        return (scanBox && scanBox.getAttribute(name)) || '';
      }
      function fmtEta(sec) {
        sec = Math.max(1, Math.round(Number(sec) || 0));
        var zh = attr('data-locale') === 'zh-CN';
        if (sec >= 90) {
          var m = Math.round(sec / 60);
          return zh ? m + ' 分钟' : m + ' min';
        }
        return zh ? sec + ' 秒' : sec + ' s';
      }
      function tpl(name, eta) {
        return attr(name).replace('{eta}', fmtEta(eta));
      }
      function msgOf(body, fallback) {
        return body && typeof body.message === 'string' && body.message ? body.message : fallback;
      }
      function retryAfterOf(r, body) {
        var h = r && r.headers && r.headers.get ? r.headers.get('Retry-After') : null;
        var n = parseInt(h, 10);
        if (!isFinite(n)) n = parseInt(body && (body.retry_after || body.retryAfter), 10);
        if (!isFinite(n)) n = parseInt(body && body.etaSeconds, 10);
        return isFinite(n) && n > 0 ? n : 60;
      }
      function readJson(r) {
        return r.json().then(
          function (b) {
            return b;
          },
          function () {
            return null;
          },
        );
      }
      /* human check (Turnstile): the worker gates the POST on a valid token.
         The token is single-use, so it is reset after every attempt. */
      function turnstileToken(action) {
        var api = window.__afrTurnstile;
        return api && typeof api.getToken === 'function' ? api.getToken(action) : '';
      }
      function turnstileHas(action) {
        var api = window.__afrTurnstile;
        return !!(api && typeof api.hasWidget === 'function' && api.hasWidget(action));
      }
      function turnstileUnavailable() {
        var api = window.__afrTurnstile;
        return !!(api && typeof api.isFailed === 'function' && api.isFailed());
      }
      function turnstileReset(action) {
        var api = window.__afrTurnstile;
        if (api && typeof api.reset === 'function') api.reset(action);
      }

      function setBtn(mode) {
        /* 'idle' | 'busy' | 'hidden' — .scan-row keeps its height either way */
        if (!els.btn || !els.btnTxt) return;
        if (mode === 'hidden') {
          els.btn.hidden = true;
          return;
        }
        els.btn.hidden = false;
        els.btn.disabled = mode === 'busy';
        els.btn.classList.toggle('is-busy', mode === 'busy');
        els.btnTxt.textContent = mode === 'busy' ? attr('data-label-busy') : attr('data-label-idle');
      }
      function setStatus(msg, isErr) {
        if (!els.status) return;
        els.status.textContent = msg || '';
        els.status.classList.toggle('is-err', !!isErr);
        els.status.classList.toggle('is-busy', SCAN.phase === 'polling' && !isErr && !!msg);
      }
      function announce(msg) {
        if (els.live) els.live.textContent = msg || '';
      }
      function paint() {
        if (SCAN.msgUntil) {
          if (Date.now() < SCAN.msgUntil) return; /* keep a body message visible */
          SCAN.msgUntil = 0;
        }
        var t = SCAN.phase === 'done' ? '' : SCAN.polled ? 'data-tpl-polling' : 'data-tpl-queued';
        if (SCAN.phase === 'polling' && SCAN.eta <= 0) setStatus(attr('data-still'), false);
        else if (t) setStatus(tpl(t, SCAN.eta), false);
      }

      function clearTimers() {
        if (SCAN.tickTimer) clearInterval(SCAN.tickTimer);
        if (SCAN.waitTimer) clearInterval(SCAN.waitTimer);
        SCAN.tickTimer = 0;
        SCAN.waitTimer = 0;
      }

      function resetScan(domain) {
        clearTimers();
        SCAN.domain = domain || '';
        SCAN.phase = 'idle';
        SCAN.eta = 0;
        SCAN.polled = false;
        SCAN.deadline = 0;
        SCAN.msgUntil = 0;
        SCAN.inFlight = false;
        setBtn('idle');
        setStatus('', false);
        announce('');
        if (els.result) els.result.hidden = true;
        if (els.domain) els.domain.textContent = SCAN.domain;
      }

      function fail(msg) {
        clearTimers();
        SCAN.phase = 'idle';
        setBtn('idle');
        setStatus(msg, true);
        announce(msg);
      }

      function timeoutScan() {
        clearTimers();
        SCAN.phase = 'idle';
        setBtn('idle');
        var msg = attr('data-tpl-timeout');
        setStatus(msg, false);
        announce(msg);
      }

      function waitCountdown(sec, onDone) {
        /* 429 → polite Retry-After countdown in the status line, then onDone() */
        var left = Math.max(5, Math.round(sec));
        if (SCAN.waitTimer) clearInterval(SCAN.waitTimer);
        setStatus(tpl('data-tpl-rate', left), false);
        announce(tpl('data-tpl-rate', left));
        SCAN.waitTimer = setInterval(function () {
          left -= 1;
          if (left <= 0) {
            clearInterval(SCAN.waitTimer);
            SCAN.waitTimer = 0;
            onDone();
          } else {
            setStatus(tpl('data-tpl-rate', left), false);
          }
        }, 1000);
      }

      function startTicker() {
        /* one 1s tick: countdown repaint + a poll every 10th tick */
        if (SCAN.tickTimer) clearInterval(SCAN.tickTimer);
        var sec = 0;
        SCAN.tickTimer = setInterval(function () {
          if (Date.now() > SCAN.deadline) {
            timeoutScan();
            return;
          }
          sec += 1;
          SCAN.eta = Math.max(0, SCAN.eta - 1);
          if (SCAN.waitTimer) return; /* a 429 countdown owns the status line */
          paint();
          if (sec % (POLL_MS / 1000) === 0) poll();
        }, 1000);
      }

      function poll() {
        if (SCAN.inFlight || SCAN.phase !== 'polling') return;
        var d = SCAN.domain;
        SCAN.inFlight = true;
        fetch('/api/v1/sites/' + encodeURIComponent(d), {
          headers: { accept: 'application/json' },
        })
          .then(function (r) {
            return readJson(r).then(function (body) {
              if (d !== SCAN.domain) return; /* query changed — drop the stale response */
              SCAN.inFlight = false;
              if (SCAN.phase !== 'polling') return; /* timed out / failed meanwhile */
              if (r.status === 200) {
                renderResult(body);
                return;
              }
              if (r.status === 404) {
                SCAN.polled = true;
                paint();
                return;
              }
              if (r.status === 429) {
                /* stop the loop, honor Retry-After, then keep polling */
                if (SCAN.tickTimer) {
                  clearInterval(SCAN.tickTimer);
                  SCAN.tickTimer = 0;
                }
                waitCountdown(retryAfterOf(r, body), startTicker);
                return;
              }
              if (r.status === 400) {
                fail(msgOf(body, attr('data-msg-invalid')));
                return;
              }
              /* 5xx / unknown shape — show the body message, keep politely polling */
              SCAN.polled = true;
              var m = msgOf(body, null);
              if (m) {
                setStatus(m, true);
                announce(m);
                SCAN.msgUntil = Date.now() + POLL_MS;
              }
            });
          })
          .catch(function () {
            if (d !== SCAN.domain) return;
            SCAN.inFlight = false; /* network blip — the ticker keeps trying until deadline */
          });
      }

      function renderResult(body) {
        clearTimers();
        SCAN.phase = 'done';
        var site = (body && body.site) || body || {};
        var grade = site.grade || (body && body.scan && body.scan.grade) || '';
        var score = site.score_total != null ? site.score_total : site.score;
        var strat = site.strategy_tag || site.strategyTag || '';
        var domain = site.domain || SCAN.domain;
        var stratLabels = {};
        try {
          stratLabels = JSON.parse(attr('data-strategies') || '{}');
        } catch (e) {
          stratLabels = {};
        }
        var gradeVars = {};
        try {
          gradeVars = JSON.parse(attr('data-grade-vars') || '{}');
        } catch (e) {
          gradeVars = {};
        }

        if (els.rGrade) {
          els.rGrade.textContent = grade || '—';
          els.rGrade.style.color = (grade && gradeVars[grade]) || 'var(--text-3)';
        }
        if (els.rDomain) els.rDomain.textContent = domain;
        var parts = [];
        if (grade) parts.push(attr('data-label-grade') + ' ' + grade);
        if (score !== undefined && score !== null && score !== '') {
          parts.push(attr('data-label-score') + ' ' + score);
        }
        if (strat) parts.push(attr('data-label-strategy') + ' ' + (stratLabels[strat] || strat));
        if (els.rMeta) els.rMeta.textContent = parts.join(' · ');
        if (els.rLink) els.rLink.href = attr('data-report-base') + domain + '/';

        setBtn('hidden');
        setStatus('', false);
        if (els.result) els.result.hidden = false;
        announce(domain + ' — ' + (els.rLink ? els.rLink.textContent : ''));
      }

      function startScan() {
        if (SCAN.phase !== 'idle') return;
        var d = SCAN.domain;
        if (!DOMAIN_RE.test(d)) {
          /* invalid domain → inline message, NO request */
          setStatus(attr('data-msg-invalid'), true);
          announce(attr('data-msg-invalid'));
          return;
        }
        SCAN.phase = 'submitting';
        setBtn('busy');
        setStatus('', false);
        announce(attr('data-label-busy'));

        var payload = { domain: d };
        var token = turnstileToken('afr_search_scan');
        if (turnstileHas('afr_search_scan') && !token) {
          /* the widget is on the page but not solved yet — no request */
          fail(
            turnstileUnavailable()
              ? attr('data-msg-turnstile-unavailable')
              : attr('data-msg-turnstile'),
          );
          return;
        }
        payload.turnstile_token = token;

        fetch('/api/v1/search-scan', {
          method: 'POST',
          headers: { 'content-type': 'application/json', accept: 'application/json' },
          body: JSON.stringify(payload),
        })
          .then(function (r) {
            if (d !== SCAN.domain) return; /* query changed — abandon silently */
            return readJson(r).then(function (body) {
              if (r.status === 200) {
                var eta = parseInt(body && body.etaSeconds, 10);
                if (!isFinite(eta) || eta <= 0) eta = parseInt(attr('data-eta-default'), 10) || 180;
                var exists = body && body.status === 'exists';
                if (exists) eta = 0; /* already collected → the report is one fetch away */
                SCAN.phase = 'polling';
                SCAN.eta = eta;
                SCAN.polled = !!exists;
                SCAN.deadline = Date.now() + MAX_MS;
                setBtn('hidden');
                paint();
                announce(
                  exists
                    ? tpl('data-tpl-polling', eta)
                    : tpl('data-tpl-queued', eta),
                );
                startTicker();
                if (exists) poll();
                return;
              }
              if (r.status === 429) {
                /* phase is still 'submitting' → button stays busy during the wait */
                waitCountdown(retryAfterOf(r, body), function () {
                  setStatus('', false);
                  SCAN.phase = 'idle';
                  setBtn('idle');
                });
                return;
              }
              if (r.status === 400) {
                fail(
                  body && body.error === 'turnstile_failed'
                    ? attr('data-msg-turnstile-failed')
                    : msgOf(body, attr('data-msg-invalid')),
                );
                return;
              }
              fail(msgOf(body, attr('data-msg-error')));
            });
          })
          .catch(function () {
            if (d !== SCAN.domain) return;
            fail(attr('data-msg-net'));
          })
          .then(function () {
            turnstileReset('afr_search_scan'); /* a token may only be used once */
          });
      }

      if (scanBox) {
        els = {
          btn: scanBox.querySelector('[data-scan-btn]'),
          btnTxt: scanBox.querySelector('[data-scan-btn-txt]'),
          status: scanBox.querySelector('[data-scan-status]'),
          live: scanBox.querySelector('[data-scan-live]'),
          domain: scanBox.querySelector('[data-scan-domain]'),
          result: scanBox.querySelector('[data-scan-result]'),
          rGrade: scanBox.querySelector('[data-sr-grade]'),
          rDomain: scanBox.querySelector('[data-sr-domain]'),
          rMeta: scanBox.querySelector('[data-sr-meta]'),
          rLink: scanBox.querySelector('[data-sr-link]'),
        };
        if (els.btn) els.btn.addEventListener('click', startScan);
      }

      /* ── runtime index + card rendering (bounded: 50 matches per view) ── */
      function fetchJson(url) {
        return fetch(url, { headers: { accept: 'application/json' } }).then(function (r) {
          if (!r.ok) throw new Error('http ' + r.status);
          return r.json();
        });
      }

      /* The payload used to carry the grade ('g') and the pending sites were
         filtered out here. The current payload carries rated sites only and
         no grade, so the filter only applies to an index cached from before
         that change. */
      function normalizeEntries(data) {
        return (Array.isArray(data) ? data : []).filter(function (e) {
          if (!e || !e.d) return false;
          if (e.g) return RATED.indexOf(e.g) !== -1;
          return true;
        });
      }

      /* score desc, then domain asc — the order the server sorted in */
      function byScoreDesc(a, b) {
        return b.s - a.s || (a.d < b.d ? -1 : a.d > b.d ? 1 : 0);
      }

      function loadManifest() {
        return fetchJson(MANIFEST_URL).then(function (m) {
          /* an unknown version is not ours — the legacy file is the fallback */
          if (!m || m.v !== 1 || !Array.isArray(m.shards) || !m.shards.length) {
            throw new Error('manifest');
          }
          return m;
        });
      }

      function loadShard(file) {
        return fetchJson(DATA_DIR + file).then(normalizeEntries);
      }

      /* The legacy single file — the payload of a build from before the
         shards existed. It is the whole catalog in one file. */
      function loadLegacy() {
        return fetchJson(LEGACY_URL).then(function (data) {
          var list = normalizeEntries(data);
          INDEX.entries = list;
          INDEX.total = list.length;
          INDEX.full = true;
          return list;
        });
      }

      /* The browse case: the leaderboard slice only. */
      function ensureTop() {
        if (INDEX.entries) return Promise.resolve(INDEX.entries);
        if (!INDEX.topPromise) {
          INDEX.topPromise = loadManifest()
            .then(function (m) {
              INDEX.total = m.entries || 0;
              if (!m.top || !m.top.file) throw new Error('no top slice');
              return loadShard(m.top.file);
            })
            .then(function (list) {
              /* the whole catalog may have arrived first (the user typed
                 while the slice was still loading) — never overwrite it */
              if (!INDEX.full) INDEX.entries = list;
              return INDEX.entries;
            })
            .catch(function () {
              INDEX.topPromise = null; /* retry on the next interaction */
              return loadLegacy();
            });
        }
        return INDEX.topPromise;
      }

      /* A query needs the whole catalog: every shard, fetched in parallel
         and merged back into one score-desc list. */
      function ensureFull() {
        if (INDEX.full) return Promise.resolve(INDEX.entries);
        if (!INDEX.fullPromise) {
          INDEX.fullPromise = loadManifest()
            .then(function (m) {
              INDEX.total = m.entries || 0;
              return Promise.all(
                m.shards.map(function (s) {
                  return loadShard(s.file);
                }),
              );
            })
            .then(function (parts) {
              var merged = [];
              for (var i = 0; i < parts.length; i++) merged = merged.concat(parts[i]);
              merged.sort(byScoreDesc);
              INDEX.entries = merged;
              INDEX.full = true;
              return merged;
            })
            .catch(function () {
              INDEX.fullPromise = null; /* retry on the next interaction */
              return loadLegacy();
            });
        }
        return INDEX.fullPromise;
      }

      /* What the current query needs: the slice for the browse case, the
         whole catalog for a query. */
      function needIndex(q) {
        return q === '' ? ensureTop() : ensureFull();
      }

      function computeMatches(q) {
        matches = [];
        if (!INDEX.entries) return;
        var list = INDEX.entries;
        var domain = isDomainish(q) ? normDomain(q) : '';
        if (DOMAIN_RE.test(domain)) {
          var exact = list.find(function (entry) { return normDomain(entry.d) === domain; });
          if (exact) {
            matches.push(exact);
            return;
          }
        }
        for (var i = 0; i < list.length; i++) {
          var e = list[i];
          if (q === '') {
            matches.push(e);
            continue;
          }
          /* same blob the server rendered before: domain + title */
          var hay = ((e.d || '') + ' ' + (e.t || '')).toLowerCase();
          if (hay.indexOf(q) !== -1) matches.push(e);
        }
      }

      /* clone the inert template and fill it — same classes / data-* as the
         server-rendered cards used to be (the clone carries Astro's scope
         attributes, so every scoped rule applies) */
      function buildCard(e, i) {
        var el = cardTemplate.content.firstElementChild.cloneNode(true);
        var d = e.d || '';
        var t = e.t || '';
        var s = Number(e.s) || 0;
        /* the grade travels in the index only for a payload cached from
           before the change; otherwise it is derived from the score */
        var g = e.g || gradeFor(s);
        var c = e.c || '';
        var pct = Math.max(0, Math.min(100, s));
        el.setAttribute('href', reportBase + d);
        el.style.setProperty('--i', String(i));
        el.style.setProperty('--g', gradeVars[g] || 'var(--text-3)');
        el.setAttribute('data-site-grade', g);
        el.setAttribute('data-score', String(s));
        el.setAttribute('data-rank', '');
        el.setAttribute('data-scanned', '');
        el.setAttribute('data-cat', c);
        el.setAttribute('data-tags', '');
        el.setAttribute('data-lang', '');
        el.setAttribute('data-search', (d + ' ' + t).toLowerCase());
        var ring = el.querySelector('[data-grade]');
        if (ring) {
          ring.setAttribute('data-grade', g);
          ring.setAttribute('aria-label', 'Grade ' + g + ', score ' + s + ' of 100');
          ring.style.setProperty('--pct', pct + '%');
          ring.removeAttribute('data-ring-count'); /* no count-up on runtime cards */
          ring.removeAttribute('data-animate');
          var fill = ring.querySelector('.ring-fill');
          if (fill) fill.style.setProperty('--sweep', pct + '%');
          var letter = ring.querySelector('.ring-letter');
          if (letter) letter.textContent = g;
          var sc = ring.querySelector('.ring-score');
          if (sc) sc.textContent = String(s);
        }
        var dom = el.querySelector('.card-domain');
        if (dom) dom.textContent = d;
        var title = el.querySelector('.card-title');
        if (title) title.textContent = t;
        /* category chip: "other" (Uncategorized) never renders; create the chip
           when the inert template happened to come from an "other" site */
        var host = el.querySelector('.card-chips');
        var catChip = el.querySelector('[data-chip="cat"]');
        if (c && c !== 'other') {
          if (!catChip && host) {
            catChip = document.createElement('span');
            catChip.className = 'chip';
            catChip.setAttribute('data-chip', 'cat');
            host.insertBefore(catChip, host.firstChild);
          }
          if (catChip) catChip.textContent = catNames[c] || c;
        } else if (catChip) {
          catChip.remove();
        }
        /* the compact index carries no strategy tag — one chip is the truth */
        var stratChip = el.querySelector('[data-chip="strat"]');
        if (stratChip) stratChip.remove();
        return el;
      }

      function appendRange(from, to, animate) {
        for (var i = from; i < to; i++) {
          var el = buildCard(matches[i], i - from);
          if (animate) el.classList.add('card-enter');
          grid.appendChild(el);
        }
        domCount = to;
      }

      function rebuild() {
        grid.innerHTML = '';
        domCount = 0;
        appendRange(0, Math.min(cap, matches.length), false);
      }

      function setMoreStatus(msg, isErr) {
        if (!moreStatus) return;
        moreStatus.textContent = msg || '';
        moreStatus.classList.toggle('is-err', !!isErr);
      }

      function progressText() {
        /* before the whole catalog is in, the total comes from the manifest */
        var total = INDEX.full ? matches.length : Math.max(matches.length, INDEX.total);
        return (moreWrap && moreWrap.getAttribute('data-tpl-progress') || 'Showing {n} of {t}')
          .replace('{n}', String(domCount))
          .replace('{t}', String(total));
      }

      function updateMore() {
        if (!moreWrap || !moreBtn) return;
        if (!INDEX.entries || matches.length <= PAGE) {
          moreWrap.hidden = true; /* nothing to page (or index not here yet) */
          return;
        }
        moreWrap.hidden = false;
        if (domCount >= matches.length && INDEX.full) {
          moreBtn.disabled = true;
          moreBtn.textContent = (moreWrap.getAttribute('data-tpl-done') || 'All {n} shown')
            .replace('{n}', String(matches.length));
        } else {
          moreBtn.disabled = false;
          moreBtn.textContent = moreLabel;
        }
      }

      if (moreBtn && moreWrap) {
        moreBtn.addEventListener('click', function () {
          if (moreBtn.disabled) return;
          if (!INDEX.entries) {
            /* index fetch failed earlier — this button doubles as the retry */
            moreBtn.disabled = true;
            setMoreStatus(moreWrap.getAttribute('data-msg-loading') || 'Loading…', false);
            needIndex(currentQ).then(
              function () {
                apply(currentQ);
                setMoreStatus('', false);
                updateMore();
              },
              function () {
                moreBtn.disabled = false;
                setMoreStatus(moreWrap.getAttribute('data-msg-error') || 'Retry.', true);
              },
            );
            return;
          }
          if (!INDEX.full && domCount >= INDEX.entries.length) {
            /* the browse slice is exhausted — pull the whole catalog and
               carry on from where the list stopped */
            moreBtn.disabled = true;
            setMoreStatus(moreWrap.getAttribute('data-msg-loading') || 'Loading…', false);
            ensureFull().then(
              function () {
                computeMatches(currentQ);
                cap += PAGE;
                appendRange(domCount, Math.min(cap, matches.length), true);
                setMoreStatus(progressText(), false);
                updateMore();
              },
              function () {
                moreBtn.disabled = false;
                setMoreStatus(moreWrap.getAttribute('data-msg-error') || 'Retry.', true);
              },
            );
            return;
          }
          if (domCount >= matches.length) return;
          cap += PAGE;
          appendRange(domCount, Math.min(cap, matches.length), true);
          setMoreStatus(progressText(), false);
          updateMore();
        });
      }

      function apply(raw) {
        var q = (raw || '').trim().toLowerCase();
        currentQ = q;
        announceCount('');

        /* ready means: the browse slice for an empty query, the whole
           catalog for a query */
        var ready = q === '' ? INDEX.entries !== null : INDEX.full;
        if (!ready) {
          if (q !== '' && countEl) {
            countEl.hidden = false;
            countEl.textContent = (moreWrap && moreWrap.getAttribute('data-msg-loading')) || 'Loading…';
          }
          if (moreWrap && !moreWrap.hidden) {
            setMoreStatus(moreWrap.getAttribute('data-msg-loading') || 'Loading…', false);
          }
          needIndex(q).then(
            function () {
              if (q === currentQ) apply(q);
            },
            function () {
              if (q !== currentQ) return;
              var err = moreWrap && moreWrap.getAttribute('data-msg-error');
              if (countEl && q !== '') {
                countEl.hidden = false;
                countEl.textContent = err || 'Retry.';
                announceCount(countEl.textContent);
              }
              if (moreWrap) {
                moreWrap.hidden = false; /* surface a retryable button */
                if (moreBtn) {
                  moreBtn.disabled = false;
                  moreBtn.textContent = moreLabel;
                }
                setMoreStatus(err || 'Retry.', true);
              }
            },
          );
          return;
        }

        if (q !== lastKey) {
          lastKey = q;
          cap = PAGE;
          computeMatches(q);
          rebuild();
          setMoreStatus('', false); /* stale progress/error from the old query */
        }

        var visible = matches.length;
        var domainish = q !== '' && visible === 0 && isDomainish(q);
        if (scanBox) {
          if (domainish) {
            var d = normDomain(q);
            if (d !== SCAN.domain) resetScan(d);
            scanBox.hidden = false;
          } else {
            if (SCAN.domain !== '') resetScan('');
            scanBox.hidden = true;
          }
        }
        if (empty) empty.hidden = !(q !== '' && visible === 0 && !domainish);
        if (grid) grid.hidden = q !== '' && visible === 0;
        if (countEl) {
          countEl.hidden = q === '';
          if (q !== '') {
            var txt = countTpl.replace('{n}', String(visible));
            if (visible === 1) txt = txt.replace(/\bsites\b/, 'site'); /* EN singular */
            countEl.textContent = txt;
            /* Zero hits: also announce the empty-state copy and its next step
               (submit CTA) so screen-reader users hear what to do, not just
               the count (audit P2). */
            if (visible === 0 && empty && !empty.hidden) {
              var emptyMsg = (empty.querySelector('p') || {}).textContent || '';
              var emptyCta = (empty.querySelector('a') || {}).textContent || '';
              if (emptyMsg) txt = txt + '. ' + emptyMsg.trim();
              if (emptyCta) txt = txt + ' ' + emptyCta.trim();
            }
            announceCount(txt);
          }
        }
        updateMore();
      }

      function syncUrl(q) {
        var url = new URL(location.href);
        if (q) url.searchParams.set('q', q);
        else url.searchParams.delete('q');
        try {
          history.replaceState(null, '', url);
        } catch (err) {
          /* file:// or sandboxed context — results already filtered */
        }
      }

      var initial = new URLSearchParams(location.search).get('q') || '';
      if (input) {
        input.value = initial;
        input.addEventListener('input', function () {
          apply(input.value);
          syncUrl(input.value.trim());
        });
      }
      if (form) {
        form.addEventListener('submit', function (e) {
          e.preventDefault();
          var v = input ? input.value : '';
          apply(v);
          syncUrl(v.trim());
        });
      }
      apply(initial);
    })();
  </script>
</Base>

<style>
  .page {
    padding-top: 44px;
  }
  .page-title {
    font-size: clamp(1.7rem, 3.4vw, 2.4rem);
    margin-bottom: 20px;
  }
  .search-form {
    display: flex;
    align-items: center;
    max-width: 560px;
    padding: 0 14px;
    background: var(--bg-surface);
    border: 1px solid var(--line);
    border-radius: var(--r-2);
    transition: border-color var(--t-micro) var(--ease);
  }
  .search-form:hover,
  .search-form:focus-within {
    border-color: var(--brand);
  }
  .search-input {
    flex: 1;
    min-width: 0;
    padding: 12px 0;
    background: none;
    border: none;
    outline: none;
    font-size: 15px;
    color: var(--text-1);
  }
  .search-input::placeholder {
    color: var(--text-3);
  }

  .result-count {
    margin: 24px 0 0;
    font-size: 12.5px;
    color: var(--text-3);
  }
  .result-count[hidden] {
    display: none;
  }

  .grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(240px, 1fr));
    gap: var(--gutter);
    margin-top: 24px;
  }
  .grid[hidden] {
    display: none;
  }

  /* incremental pagination — status line reserves its height (no layout shift) */
  .more {
    display: grid;
    justify-items: center;
    gap: 8px;
    margin-top: 24px;
  }
  .more[hidden] {
    display: none;
  }
  .more-btn {
    transition: opacity var(--t-micro) var(--ease), border-color var(--t-micro) var(--ease);
  }
  .more-btn[disabled] {
    cursor: default;
    opacity: 0.7;
  }
  .more-status {
    margin: 0;
    min-height: 1.3em; /* reserved: status repaints never shift the layout */
    font-size: 12.5px;
    color: var(--text-3);
    text-align: center;
  }
  .more-status.is-err {
    color: var(--grade-f-text);
  }

  .empty {
    display: grid;
    justify-items: start;
    gap: 12px;
    margin-top: 32px;
    color: var(--text-2);
    font-size: 14.5px;
  }
  .empty[hidden] {
    display: none;
  }

  /* ── "not collected yet" scan block ─────────────────────────────────── */
  .scan {
    display: grid;
    gap: 10px;
    margin-top: 32px;
    padding: 22px;
    background: var(--bg-surface);
    border: 1px solid var(--line);
    border-radius: var(--radius);
    animation: scan-in var(--t-standard) var(--ease);
  }
  .scan[hidden] {
    display: none;
  }
  @keyframes scan-in {
    from {
      opacity: 0;
      transform: translateY(6px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }
  .scan-kicker {
    margin: 0;
    font-size: 11.5px;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--text-3);
  }
  .scan-domain {
    margin: 0;
    font-size: 17px;
    font-weight: 700;
    color: var(--brand-link);
    overflow-wrap: anywhere;
  }
  .scan-desc {
    margin: 0;
    font-size: 14px;
    line-height: 1.6;
    color: var(--text-2);
    max-width: 60ch;
  }
  .scan-row {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: 14px;
    min-height: 38px; /* reserved: button ↔ hidden swap must not shift layout */
    margin-top: 4px;
  }
  @media (max-width: 767px) {
    /* .btn grows to min-height 44px here — keep the reserved height in sync
       so the button ↔ hidden swap still never shifts the layout. */
    .scan-row {
      min-height: 44px;
    }
  }
  .scan-btn[disabled] {
    cursor: not-allowed;
    opacity: 0.85;
  }
  .scan-spinner {
    display: none;
    width: 13px;
    height: 13px;
    border: 2px solid color-mix(in srgb, currentColor 35%, transparent);
    border-top-color: currentColor;
    border-radius: 50%;
    animation: scan-spin 0.8s linear infinite;
  }
  .scan-btn.is-busy .scan-spinner {
    display: inline-block;
  }
  @keyframes scan-spin {
    to {
      transform: rotate(360deg);
    }
  }
  .scan-alt {
    font-size: 13.5px;
    color: var(--brand-link);
  }
  .scan-alt:hover {
    text-decoration: underline;
  }
  .scan-status {
    margin: 0;
    min-height: 1.3em; /* reserved: countdown repaints never shift layout */
    font-size: 12.5px;
    color: var(--text-3);
  }
  .scan-status.is-err {
    color: var(--grade-f-text);
  }
  .scan-status.is-busy::before {
    content: '';
    display: inline-block;
    width: 10px;
    height: 10px;
    margin-right: 7px;
    border: 2px solid color-mix(in srgb, currentColor 35%, transparent);
    border-top-color: currentColor;
    border-radius: 50%;
    vertical-align: -1px;
    animation: scan-spin 0.8s linear infinite;
  }
  .scan-sr {
    position: absolute;
    width: 1px;
    height: 1px;
    margin: -1px;
    padding: 0;
    overflow: hidden;
    clip-path: inset(50%);
    white-space: nowrap;
    border: 0;
  }

  .scan-result {
    display: flex;
    align-items: center;
    gap: 16px;
    padding: 16px;
    background: var(--bg-elevated);
    border: 1px solid var(--line);
    border-radius: var(--radius);
    animation: scan-in var(--t-standard) var(--ease);
  }
  .scan-result[hidden] {
    display: none;
  }
  .sr-grade {
    flex: none;
    font-size: 34px;
    font-weight: 700;
    line-height: 1;
  }
  .sr-info {
    display: grid;
    gap: 6px;
    min-width: 0;
  }
  .sr-domain {
    font-size: 15px;
    font-weight: 700;
    color: var(--text-1);
    overflow-wrap: anywhere;
  }
  .sr-meta {
    font-size: 12.5px;
    color: var(--text-2);
  }
  .sr-open {
    justify-self: start;
  }
</style>
