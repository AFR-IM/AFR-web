---
// P2 category page /c/:slug:
// header (name + count) → Sponsored slot (position 1, above the natural list,
// separated by 24px + 1px dashed --line) → grade/tag/language filter row →
// sorter (score | rank | newest) → card grid (auto-fill minmax, no media
// query). Filtering and sorting are client-side over the pre-rendered cards
// and synced into the URL via history.replaceState (?grade=&tag=&lang=&sort=).
//
// getStaticPaths covers every catalog category slug (14) × both locales so the
// homepage tiles never link to a 404, plus anything listCategories() reports.

import Base from '../../../layouts/Base.astro';
import DomainCard from '../../../components/home/DomainCard.astro';
import Sorter from '../../../components/home/Sorter.astro';
import SponsoredCard from '../../../components/home/SponsoredCard.astro';
import { getCatalog, pathFor, toLocale } from '../../../i18n/loader.ts';
import { listCategories, loadCategory } from '../../../data/loader.ts';
import { GRADES, GRADE_VAR, gradeVar } from '../../../utils/grade.ts';
import { resolvableAds } from '../../../components/home/ads-fixture.ts';
import { sitesLabel, uiText } from '../../../components/home/fallbacks.ts';

export function getStaticPaths() {
  const slugs = new Set<string>([
    ...Object.keys(getCatalog('en').categories),
    ...listCategories().map((c) => c.slug),
  ]);
  const paths: { params: { locale: string | undefined; slug: string } }[] = [];
  for (const slug of slugs) {
    paths.push({ params: { locale: undefined, slug } });
    paths.push({ params: { locale: 'zh-CN', slug } });
  }
  return paths;
}

const slug = Astro.params.slug ?? '';
const locale = toLocale(Astro.params.locale);
const L = getCatalog(locale);
const href = (p: string) => pathFor(locale, p);

const cat = L.categories[slug];
const name = cat?.name ?? slug;
const blurb = cat?.blurb ?? '';

const data = loadCategory(slug);
const sites = data?.sites ?? [];
const count = data?.count ?? 0;
const hasSites = sites.length > 0;

// Bounded DOM (catalogs grow to 100k domains): only the first page is
// server-rendered; "Show more" appends further pages from GET /api/v1/sites.
const PAGE_SIZE = 50;
const firstPage = sites.slice(0, PAGE_SIZE);

const tags = [...new Set(sites.flatMap((s) => s.tags ?? []))].sort();
const langs = [
  ...new Set(sites.map((s) => s.lang).filter((v): v is string => Boolean(v))),
].sort();

const [ad] = resolvableAds(); // slot position 1 (category-top)

const countTpl = uiText(L.ui, 'siteCount', locale);
const countText = sitesLabel(L.ui, locale, count);
const sortOptions = [
  { value: 'score', label: L.ui.sortScore ?? 'Score' },
  { value: 'rank', label: L.ui.sortRank ?? 'Rank' },
  { value: 'new', label: L.ui.sortNew ?? 'Newest' },
];
const strategyLabels = JSON.stringify(
  Object.fromEntries(Object.entries(L.strategies).map(([k, v]) => [k, v.label])),
);
// "Show more" copy — catalog-first with inline EN/ZH fallbacks
const loadMoreLabel = L.ui.loadMore ?? 'Load more';
const loadingText = L.ui.loading ?? 'Loading…';
const doneTpl = uiText(L.ui, 'loadMoreDone', locale);
const progressTpl = uiText(L.ui, 'loadMoreProgress', locale);
const loadMoreErrorText = uiText(L.ui, 'loadMoreError', locale);
---

<Base title={name} description={blurb !== '' ? blurb : L.ui.tagline}>
  <div class="container page">
    <header class="cat-head">
      <p class="crumb mono">
        <a href={href('/categories')}>{L.ui.navCategories}</a>
        <span aria-hidden="true"> / </span>
        <span>{slug}</span>
      </p>
      <h1>{name}</h1>
      <p class="cat-meta">
        <span class="cat-count mono">{countText}</span>
        {blurb !== '' && <span class="cat-blurb">{blurb}</span>}
      </p>
    </header>

    {ad && <SponsoredCard ad={ad} locale={locale} variant="category" />}

    {hasSites ? (
      <div class="cat-body">
        <div class="filters" role="group" aria-label={L.ui.filterCategory}>
          <div class="fgroup">
            <span class="f-label mono">{L.ui.filterGrade}</span>
            <div class="f-chips">
              {GRADES.map((g) => (
                <button
                  type="button"
                  class="chip g-chip"
                  data-filter="grade"
                  data-value={g}
                  aria-pressed="false"
                  style={`--g:${gradeVar(g)}`}
                >
                  <span class="g-dot" aria-hidden="true"></span>
                  <span class="mono">{g}</span>
                </button>
              ))}
            </div>
          </div>

          {tags.length > 0 && (
            <div class="fgroup">
              <span class="f-label mono">{L.ui.filterTag}</span>
              <div class="f-chips">
                {tags.map((t) => (
                  <button type="button" class="chip" data-filter="tag" data-value={t} aria-pressed="false">
                    {t}
                  </button>
                ))}
              </div>
            </div>
          )}

          {langs.length > 0 && (
            <div class="fgroup">
              <span class="f-label mono">{L.ui.filterLang}</span>
              <div class="f-chips">
                {langs.map((l) => (
                  <button type="button" class="chip" data-filter="lang" data-value={l} aria-pressed="false">
                    <span class="mono">{l}</span>
                  </button>
                ))}
              </div>
            </div>
          )}

          <button type="button" class="clear-btn" data-clear-filters hidden>
            {L.ui.clearFilters ?? 'Clear filters'}
          </button>
        </div>

        <div class="list-bar">
          <p class="list-count mono" data-count data-count-template={countTpl}>{countText}</p>
          <Sorter options={sortOptions} active="score" label={uiText(L.ui, 'sortBy', locale)} />
        </div>

        <div
          class="grid"
          data-grid
          data-page-size={PAGE_SIZE}
          data-total={count}
          data-category={slug}
          data-report-base={href('/site/')}
          data-cat-name={name}
          data-grade-vars={JSON.stringify(GRADE_VAR)}
          data-strategies={strategyLabels}
        >
          {firstPage.map((s, i) => <DomainCard site={s} locale={locale} index={i} />)}
        </div>

        {count > PAGE_SIZE && (
          <div
            class="more"
            data-more-wrap
            data-tpl-done={doneTpl}
            data-tpl-progress={progressTpl}
            data-msg-error={loadMoreErrorText}
            data-msg-loading={loadingText}
          >
            <button type="button" class="btn more-btn" data-more>{loadMoreLabel}</button>
            <p class="more-status mono" data-more-status role="status" aria-live="polite"></p>
          </div>
        )}

        {/* inert card template — client-appended cards clone this markup so
            Astro-scoped classes/styles stay identical to server-rendered cards */}
        {count > PAGE_SIZE && (
          <template data-card-tpl>
            <DomainCard site={sites[0]} locale={locale} index={0} />
          </template>
        )}

        <div class="empty" data-empty hidden>
          <p>{L.ui.searchEmpty}</p>
          <a class="btn" href={href('/submit')}>{L.ui.submitCta}</a>
        </div>
      </div>
    ) : (
      <div class="empty">
        <p>{uiText(L.ui, 'emptyCategory', locale)}</p>
        <a class="btn" href={href('/submit')}>{L.ui.submitCta}</a>
      </div>
    )}
  </div>

  <!-- Client-side filter + sort over pre-rendered cards -->
  <script is:inline>
    (function () {
      var grid = document.querySelector('[data-grid]');
      if (!grid) return;
      var cards = Array.prototype.slice.call(grid.querySelectorAll('[data-site-grade]'));
      var filterEls = Array.prototype.slice.call(document.querySelectorAll('[data-filter]'));
      var sortEls = Array.prototype.slice.call(document.querySelectorAll('[data-sort]'));
      var clearBtn = document.querySelector('[data-clear-filters]');
      var empty = document.querySelector('[data-empty]');
      var countEl = document.querySelector('[data-count]');
      var countTpl = (countEl && countEl.getAttribute('data-count-template')) || '{n} sites';

      var params = new URLSearchParams(location.search);
      var state = {
        grade: params.get('grade') || '',
        tag: params.get('tag') || '',
        lang: params.get('lang') || '',
        sort: params.get('sort') || 'score'
      };
      if (['score', 'rank', 'new'].indexOf(state.sort) === -1) state.sort = 'score';

      function syncUrl() {
        var url = new URL(location.href);
        var keys = ['grade', 'tag', 'lang', 'sort'];
        for (var i = 0; i < keys.length; i++) {
          var k = keys[i];
          var v = state[k];
          if (v && !(k === 'sort' && v === 'score')) url.searchParams.set(k, v);
          else url.searchParams.delete(k);
        }
        try {
          history.replaceState(null, '', url);
        } catch (err) {
          /* file:// or sandboxed context — UI state above is already applied */
        }
      }

      function matches(card) {
        if (state.grade && card.getAttribute('data-site-grade') !== state.grade) return false;
        if (state.tag) {
          var tags = (card.getAttribute('data-tags') || '').split(' ');
          if (tags.indexOf(state.tag) === -1) return false;
        }
        if (state.lang && card.getAttribute('data-lang') !== state.lang) return false;
        return true;
      }

      function compare(a, b) {
        if (state.sort === 'new') {
          return (
            (Date.parse(b.getAttribute('data-scanned')) || 0) -
            (Date.parse(a.getAttribute('data-scanned')) || 0)
          );
        }
        if (state.sort === 'rank') {
          var ra = a.getAttribute('data-rank');
          var rb = b.getAttribute('data-rank');
          var na = ra === null || ra === '' ? Infinity : Number(ra);
          var nb = rb === null || rb === '' ? Infinity : Number(rb);
          if (na !== nb) return na - nb;
        }
        // natural AFR ranking = pure score descending (red line: no ad mixing)
        return (
          (Number(b.getAttribute('data-score')) || 0) -
          (Number(a.getAttribute('data-score')) || 0)
        );
      }

      function render(animateIn) {
        var visible = 0;
        var i;
        for (i = 0; i < cards.length; i++) {
          var ok = matches(cards[i]);
          cards[i].hidden = !ok;
          if (ok) visible++;
        }

        var sorted = cards.slice().sort(compare);
        for (i = 0; i < sorted.length; i++) grid.appendChild(sorted[i]);

        if (empty) empty.hidden = visible > 0;
        if (countEl) {
          /* unfiltered → the full category total (not all cards may be loaded
             yet); filtered → how many of the loaded cards match */
          var n = state.grade || state.tag || state.lang ? visible : total;
          var txt = countTpl.replace('{n}', String(n));
          if (n === 1) txt = txt.replace(/\bsites\b/, 'site'); /* EN singular */
          countEl.textContent = txt;
        }

        for (i = 0; i < filterEls.length; i++) {
          var el = filterEls[i];
          var on = state[el.getAttribute('data-filter')] === el.getAttribute('data-value');
          el.classList.toggle('active', on);
          el.setAttribute('aria-pressed', String(on));
        }
        for (i = 0; i < sortEls.length; i++) {
          var s = sortEls[i];
          var son = state.sort === s.getAttribute('data-sort');
          s.classList.toggle('active', son);
          s.setAttribute('aria-pressed', String(son));
        }
        if (clearBtn) clearBtn.hidden = !(state.grade || state.tag || state.lang);

        if (animateIn) {
          var idx = 0;
          for (i = 0; i < sorted.length; i++) {
            var card = sorted[i];
            if (card.hidden) continue;
            card.style.setProperty('--i', String(idx++));
            card.classList.remove('card-enter');
            void card.offsetWidth; /* restart the CSS animation */
            card.classList.add('card-enter');
          }
        }
      }

      filterEls.forEach(function (el) {
        el.addEventListener('click', function () {
          var k = el.getAttribute('data-filter');
          var v = el.getAttribute('data-value');
          state[k] = state[k] === v ? '' : v;
          render(true);
          syncUrl();
        });
      });
      sortEls.forEach(function (el) {
        el.addEventListener('click', function () {
          state.sort = el.getAttribute('data-sort') || 'score';
          render(true);
          syncUrl();
        });
      });
      if (clearBtn) {
        clearBtn.addEventListener('click', function () {
          state.grade = '';
          state.tag = '';
          state.lang = '';
          render(true);
          syncUrl();
        });
      }

      /* ── incremental "Show more": fetch the next page and append cards ── */
      var PAGE = parseInt(grid.getAttribute('data-page-size'), 10) || 50;
      var total = parseInt(grid.getAttribute('data-total'), 10) || cards.length;
      var category = grid.getAttribute('data-category') || '';
      var reportBase = grid.getAttribute('data-report-base') || '/site/';
      var catName = grid.getAttribute('data-cat-name') || '';
      var gradeVars = {};
      var stratLabels = {};
      try { gradeVars = JSON.parse(grid.getAttribute('data-grade-vars') || '{}'); } catch (e) {}
      try { stratLabels = JSON.parse(grid.getAttribute('data-strategies') || '{}'); } catch (e) {}
      var tpl = document.querySelector('[data-card-tpl]');
      var moreWrap = document.querySelector('[data-more-wrap]');
      var moreBtn = moreWrap && moreWrap.querySelector('[data-more]');
      var moreStatus = moreWrap && moreWrap.querySelector('[data-more-status]');
      var nextPage = 2; /* page 1 is the server-rendered slice */
      var loadingMore = false;

      function setMoreStatus(msg, isErr) {
        if (!moreStatus) return;
        moreStatus.textContent = msg || '';
        moreStatus.classList.toggle('is-err', !!isErr);
      }
      function progressText() {
        return (moreWrap && moreWrap.getAttribute('data-tpl-progress') || 'Showing {n} of {t}')
          .replace('{n}', String(cards.length))
          .replace('{t}', String(total));
      }
      function showAllShown() {
        if (!moreBtn) return;
        moreBtn.disabled = true;
        moreBtn.textContent = (moreWrap && moreWrap.getAttribute('data-tpl-done') || 'All {n} shown')
          .replace('{n}', String(total));
      }

      /* map one GET /api/v1/sites item onto the DomainCard shape */
      function fromApi(it) {
        return {
          domain: it.domain || '',
          title: it.title || '',
          score: Number(it.score_total) || 0,
          grade: it.grade || 'F',
          strategyTag: it.strategy_tag || '',
          category: it.category || category,
          lang: it.lang || '',
          rankSource: it.rank_source == null ? null : Number(it.rank_source),
          scannedAt: it.scanned_at || '',
          tags: [], /* the API does not expose tags */
        };
      }

      /* clone the inert template and fill it — same classes / data-* as a
         server-rendered card (the clone carries Astro's scope attributes) */
      function buildCard(s, i) {
        var el = tpl.content.firstElementChild.cloneNode(true);
        var pct = Math.max(0, Math.min(100, s.score));
        var gvar = gradeVars[s.grade] || 'var(--text-3)';
        el.setAttribute('href', reportBase + s.domain);
        el.style.setProperty('--i', String(i));
        el.style.setProperty('--g', gvar);
        el.setAttribute('data-site-grade', s.grade);
        el.setAttribute('data-score', String(s.score));
        el.setAttribute('data-rank', s.rankSource == null ? '' : String(s.rankSource));
        el.setAttribute('data-scanned', s.scannedAt);
        el.setAttribute('data-cat', s.category || '');
        el.setAttribute('data-tags', (s.tags || []).join(' '));
        el.setAttribute('data-lang', s.lang || '');
        el.setAttribute('data-search', [s.domain, s.title, (s.tags || []).join(' ')]
          .join(' ').toLowerCase());
        var ring = el.querySelector('[data-grade]');
        if (ring) {
          ring.setAttribute('data-grade', s.grade);
          ring.setAttribute('aria-label', 'Grade ' + s.grade + ', score ' + s.score + ' of 100');
          ring.style.setProperty('--pct', pct + '%');
          ring.removeAttribute('data-ring-count'); /* no count-up on appended cards */
          ring.removeAttribute('data-animate');
          var fill = ring.querySelector('.ring-fill');
          if (fill) fill.style.setProperty('--sweep', pct + '%');
          var letter = ring.querySelector('.ring-letter');
          if (letter) letter.textContent = s.grade;
          var sc = ring.querySelector('.ring-score');
          if (sc) sc.textContent = String(s.score);
        }
        var dom = el.querySelector('.card-domain');
        if (dom) dom.textContent = s.domain;
        var title = el.querySelector('.card-title');
        if (title) title.textContent = s.title;
        /* category chip: "other" (Uncategorized) never renders; create the chip
           when the inert template happened to come from an "other" site */
        var host = el.querySelector('.card-chips');
        var catChip = el.querySelector('[data-chip="cat"]');
        var cat = s.category || category;
        if (cat && cat !== 'other') {
          if (!catChip && host) {
            catChip = document.createElement('span');
            catChip.className = 'chip';
            catChip.setAttribute('data-chip', 'cat');
            host.insertBefore(catChip, host.firstChild);
          }
          if (catChip) catChip.textContent = catName;
        } else if (catChip) {
          catChip.remove();
        }
        var strat = stratLabels[s.strategyTag] || s.strategyTag;
        var stratChip = el.querySelector('[data-chip="strat"]');
        if (stratChip) {
          if (strat) stratChip.textContent = strat;
          else stratChip.remove();
        }
        return el;
      }

      if (moreBtn && moreWrap) {
        moreBtn.addEventListener('click', function () {
          if (loadingMore || cards.length >= total) return;
          loadingMore = true;
          moreBtn.disabled = true;
          setMoreStatus(moreWrap.getAttribute('data-msg-loading') || 'Loading…', false);
          var url = '/api/v1/sites?category=' + encodeURIComponent(category) +
            '&page=' + nextPage + '&per_page=' + PAGE +
            '&sort=' + encodeURIComponent(state.sort);
          fetch(url, { headers: { accept: 'application/json' } })
            .then(function (r) {
              if (!r.ok) throw new Error('http ' + r.status);
              return r.json();
            })
            .then(function (body) {
              loadingMore = false;
              if (body && Number(body.total) > 0) total = Number(body.total);
              var items = (body && body.items) || [];
              var fresh = [];
              for (var k = 0; k < items.length; k++) {
                var card = buildCard(fromApi(items[k]), cards.length);
                cards.push(card);
                fresh.push(card);
              }
              nextPage += 1;
              render(false);
              /* stagger only the freshly appended cards (nothing above shifts) */
              var idx = 0;
              for (var f = 0; f < fresh.length; f++) {
                var c = fresh[f];
                if (c.hidden) continue;
                c.style.setProperty('--i', String(idx++));
                c.classList.remove('card-enter');
                void c.offsetWidth; /* restart the CSS animation */
                c.classList.add('card-enter');
              }
              setMoreStatus(progressText(), false);
              if (items.length === 0 || cards.length >= total) showAllShown();
              else moreBtn.disabled = false;
            })
            .catch(function () {
              loadingMore = false;
              setMoreStatus(moreWrap.getAttribute('data-msg-error') || 'Retry.', true);
              moreBtn.disabled = false; /* quiet inline error, button stays retryable */
            });
        });
        if (cards.length >= total) showAllShown();
      }

      render(false);
    })();
  </script>
</Base>

<style>
  .page {
    padding-top: 32px;
  }
  .cat-head {
    margin-bottom: 20px;
  }
  .crumb {
    margin: 0 0 10px;
    font-size: 12.5px;
    color: var(--text-3);
  }
  .crumb a {
    color: var(--text-3);
  }
  .crumb a:hover {
    color: var(--brand);
  }
  .cat-head h1 {
    font-size: clamp(1.7rem, 3.4vw, 2.4rem);
    margin-bottom: 8px;
  }
  .cat-meta {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 6px 16px;
    margin: 0;
  }
  .cat-count {
    font-size: 13px;
    color: var(--brand);
  }
  .cat-blurb {
    font-size: 13.5px;
    color: var(--text-2);
  }

  .filters {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 12px 24px;
    padding: 14px 16px;
    background: var(--bg-surface);
    border: 1px solid var(--line);
    border-radius: var(--radius);
  }
  .fgroup {
    display: flex;
    align-items: center;
    gap: 10px;
  }
  .f-label {
    font-size: 11.5px;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--text-3);
  }
  .f-chips {
    display: flex;
    flex-wrap: wrap;
    gap: 6px;
  }
  .f-chips .chip {
    cursor: pointer;
    transition: border-color var(--t-micro) var(--ease), color var(--t-micro) var(--ease);
  }
  .f-chips .chip:hover {
    color: var(--text-1);
  }
  .f-chips .chip.active {
    border-color: var(--brand);
    color: var(--text-1);
  }
  .f-chips .g-chip {
    gap: 6px;
    padding: 4px 10px;
  }
  .f-chips .g-chip:hover,
  .f-chips .g-chip.active {
    border-color: var(--g);
  }
  .g-dot {
    width: 8px;
    height: 8px;
    border-radius: var(--r-1);
    background: var(--g);
    flex: none;
  }
  .clear-btn {
    margin-left: auto;
    font-size: 12.5px;
    color: var(--text-2);
    transition: color var(--t-micro) var(--ease);
  }
  .clear-btn:hover {
    color: var(--brand);
  }
  .clear-btn[hidden] {
    display: none;
  }

  .list-bar {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 16px;
    margin: 22px 0 14px;
  }
  .list-count {
    margin: 0;
    font-size: 12.5px;
    color: var(--text-3);
  }

  /* card flow grid — auto-fill minmax, deliberately no media query */
  .grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(240px, 1fr));
    gap: var(--gutter);
  }

  /* incremental pagination — status line reserves its height (no layout shift) */
  .more {
    display: grid;
    justify-items: center;
    gap: 8px;
    margin-top: 24px;
  }
  .more-btn {
    transition: opacity var(--t-micro) var(--ease), border-color var(--t-micro) var(--ease);
  }
  .more-btn[disabled] {
    cursor: default;
    opacity: 0.7;
  }
  .more-status {
    margin: 0;
    min-height: 1.3em; /* reserved: status repaints never shift the layout */
    font-size: 12.5px;
    color: var(--text-3);
    text-align: center;
  }
  .more-status.is-err {
    color: var(--grade-f);
  }

  .empty {
    display: grid;
    justify-items: start;
    gap: 12px;
    padding: 32px 0;
    color: var(--text-2);
    font-size: 14.5px;
  }
  .empty[hidden] {
    display: none;
  }
</style>
