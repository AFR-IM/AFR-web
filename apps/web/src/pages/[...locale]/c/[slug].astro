---
// P2 category page /c/:slug (spec §10.3 / §10.5 / §10.6 / §10.7):
// header (name + count) → Sponsored slot (position 1, above the natural list,
// separated by 24px + 1px dashed --line) → grade/tag/language filter row →
// sorter (score | rank | newest) → card grid (auto-fill minmax, no media
// query). Filtering and sorting are client-side over the pre-rendered cards
// and synced into the URL via history.replaceState (?grade=&tag=&lang=&sort=).
//
// getStaticPaths covers every catalog category slug (14) × both locales so the
// homepage tiles never link to a 404, plus anything listCategories() reports.

import Base from '../../../layouts/Base.astro';
import DomainCard from '../../../components/home/DomainCard.astro';
import Sorter from '../../../components/home/Sorter.astro';
import SponsoredCard from '../../../components/home/SponsoredCard.astro';
import { getCatalog, pathFor, toLocale } from '../../../i18n/loader.ts';
import { listCategories, loadCategory } from '../../../data/loader.ts';
import { GRADES, gradeVar } from '../../../utils/grade.ts';
import { resolvableAds } from '../../../components/home/ads-fixture.ts';
import { sitesLabel, uiText } from '../../../components/home/fallbacks.ts';

export function getStaticPaths() {
  const slugs = new Set<string>([
    ...Object.keys(getCatalog('en').categories),
    ...listCategories().map((c) => c.slug),
  ]);
  const paths: { params: { locale: string | undefined; slug: string } }[] = [];
  for (const slug of slugs) {
    paths.push({ params: { locale: undefined, slug } });
    paths.push({ params: { locale: 'zh-CN', slug } });
  }
  return paths;
}

const slug = Astro.params.slug ?? '';
const locale = toLocale(Astro.params.locale);
const L = getCatalog(locale);
const href = (p: string) => pathFor(locale, p);

const cat = L.categories[slug];
const name = cat?.name ?? slug;
const blurb = cat?.blurb ?? '';

const data = loadCategory(slug);
const sites = data?.sites ?? [];
const count = data?.count ?? 0;
const hasSites = sites.length > 0;

const tags = [...new Set(sites.flatMap((s) => s.tags ?? []))].sort();
const langs = [
  ...new Set(sites.map((s) => s.lang).filter((v): v is string => Boolean(v))),
].sort();

const [ad] = resolvableAds(); // slot position 1 (category-top)

const countTpl = uiText(L.ui, 'siteCount', locale);
const countText = sitesLabel(L.ui, locale, count);
const sortOptions = [
  { value: 'score', label: L.ui.sortScore ?? 'Score' },
  { value: 'rank', label: L.ui.sortRank ?? 'Rank' },
  { value: 'new', label: L.ui.sortNew ?? 'Newest' },
];
---

<Base title={name} description={blurb !== '' ? blurb : L.ui.tagline}>
  <div class="container page">
    <header class="cat-head">
      <p class="crumb mono">
        <a href={href('/categories')}>{L.ui.navCategories}</a>
        <span aria-hidden="true"> / </span>
        <span>{slug}</span>
      </p>
      <h1>{name}</h1>
      <p class="cat-meta">
        <span class="cat-count mono">{countText}</span>
        {blurb !== '' && <span class="cat-blurb">{blurb}</span>}
      </p>
    </header>

    {ad && <SponsoredCard ad={ad} locale={locale} variant="category" />}

    {hasSites ? (
      <div class="cat-body">
        <div class="filters" role="group" aria-label={L.ui.filterCategory}>
          <div class="fgroup">
            <span class="f-label mono">{L.ui.filterGrade}</span>
            <div class="f-chips">
              {GRADES.map((g) => (
                <button
                  type="button"
                  class="chip g-chip"
                  data-filter="grade"
                  data-value={g}
                  aria-pressed="false"
                  style={`--g:${gradeVar(g)}`}
                >
                  <span class="g-dot" aria-hidden="true"></span>
                  <span class="mono">{g}</span>
                </button>
              ))}
            </div>
          </div>

          {tags.length > 0 && (
            <div class="fgroup">
              <span class="f-label mono">{L.ui.filterTag}</span>
              <div class="f-chips">
                {tags.map((t) => (
                  <button type="button" class="chip" data-filter="tag" data-value={t} aria-pressed="false">
                    {t}
                  </button>
                ))}
              </div>
            </div>
          )}

          {langs.length > 0 && (
            <div class="fgroup">
              <span class="f-label mono">{L.ui.filterLang}</span>
              <div class="f-chips">
                {langs.map((l) => (
                  <button type="button" class="chip" data-filter="lang" data-value={l} aria-pressed="false">
                    <span class="mono">{l}</span>
                  </button>
                ))}
              </div>
            </div>
          )}

          <button type="button" class="clear-btn" data-clear-filters hidden>
            {L.ui.clearFilters ?? 'Clear filters'}
          </button>
        </div>

        <div class="list-bar">
          <p class="list-count mono" data-count data-count-template={countTpl}>{countText}</p>
          <Sorter options={sortOptions} active="score" label={uiText(L.ui, 'sortBy', locale)} />
        </div>

        <div class="grid" data-grid>
          {sites.map((s, i) => <DomainCard site={s} locale={locale} index={i} />)}
        </div>

        <div class="empty" data-empty hidden>
          <p>{L.ui.searchEmpty}</p>
          <a class="btn" href={href('/submit')}>{L.ui.submitCta}</a>
        </div>
      </div>
    ) : (
      <div class="empty">
        <p>{uiText(L.ui, 'emptyCategory', locale)}</p>
        <a class="btn" href={href('/submit')}>{L.ui.submitCta}</a>
      </div>
    )}
  </div>

  <!-- Client-side filter + sort over pre-rendered cards (§10.6 / §10.7) -->
  <script is:inline>
    (function () {
      var grid = document.querySelector('[data-grid]');
      if (!grid) return;
      var cards = Array.prototype.slice.call(grid.querySelectorAll('[data-site-grade]'));
      var filterEls = Array.prototype.slice.call(document.querySelectorAll('[data-filter]'));
      var sortEls = Array.prototype.slice.call(document.querySelectorAll('[data-sort]'));
      var clearBtn = document.querySelector('[data-clear-filters]');
      var empty = document.querySelector('[data-empty]');
      var countEl = document.querySelector('[data-count]');
      var countTpl = (countEl && countEl.getAttribute('data-count-template')) || '{n} sites';

      var params = new URLSearchParams(location.search);
      var state = {
        grade: params.get('grade') || '',
        tag: params.get('tag') || '',
        lang: params.get('lang') || '',
        sort: params.get('sort') || 'score'
      };
      if (['score', 'rank', 'new'].indexOf(state.sort) === -1) state.sort = 'score';

      function syncUrl() {
        var url = new URL(location.href);
        var keys = ['grade', 'tag', 'lang', 'sort'];
        for (var i = 0; i < keys.length; i++) {
          var k = keys[i];
          var v = state[k];
          if (v && !(k === 'sort' && v === 'score')) url.searchParams.set(k, v);
          else url.searchParams.delete(k);
        }
        try {
          history.replaceState(null, '', url);
        } catch (err) {
          /* file:// or sandboxed context — UI state above is already applied */
        }
      }

      function matches(card) {
        if (state.grade && card.getAttribute('data-site-grade') !== state.grade) return false;
        if (state.tag) {
          var tags = (card.getAttribute('data-tags') || '').split(' ');
          if (tags.indexOf(state.tag) === -1) return false;
        }
        if (state.lang && card.getAttribute('data-lang') !== state.lang) return false;
        return true;
      }

      function compare(a, b) {
        if (state.sort === 'new') {
          return (
            (Date.parse(b.getAttribute('data-scanned')) || 0) -
            (Date.parse(a.getAttribute('data-scanned')) || 0)
          );
        }
        if (state.sort === 'rank') {
          var ra = a.getAttribute('data-rank');
          var rb = b.getAttribute('data-rank');
          var na = ra === null || ra === '' ? Infinity : Number(ra);
          var nb = rb === null || rb === '' ? Infinity : Number(rb);
          if (na !== nb) return na - nb;
        }
        // natural AFR ranking = pure score descending (red line: no ad mixing)
        return (
          (Number(b.getAttribute('data-score')) || 0) -
          (Number(a.getAttribute('data-score')) || 0)
        );
      }

      function render(animateIn) {
        var visible = 0;
        var i;
        for (i = 0; i < cards.length; i++) {
          var ok = matches(cards[i]);
          cards[i].hidden = !ok;
          if (ok) visible++;
        }

        var sorted = cards.slice().sort(compare);
        for (i = 0; i < sorted.length; i++) grid.appendChild(sorted[i]);

        if (empty) empty.hidden = visible > 0;
        if (countEl) {
          var txt = countTpl.replace('{n}', String(visible));
          if (visible === 1) txt = txt.replace(/\bsites\b/, 'site'); /* EN singular */
          countEl.textContent = txt;
        }

        for (i = 0; i < filterEls.length; i++) {
          var el = filterEls[i];
          var on = state[el.getAttribute('data-filter')] === el.getAttribute('data-value');
          el.classList.toggle('active', on);
          el.setAttribute('aria-pressed', String(on));
        }
        for (i = 0; i < sortEls.length; i++) {
          var s = sortEls[i];
          var son = state.sort === s.getAttribute('data-sort');
          s.classList.toggle('active', son);
          s.setAttribute('aria-pressed', String(son));
        }
        if (clearBtn) clearBtn.hidden = !(state.grade || state.tag || state.lang);

        if (animateIn) {
          var idx = 0;
          for (i = 0; i < sorted.length; i++) {
            var card = sorted[i];
            if (card.hidden) continue;
            card.style.setProperty('--i', String(idx++));
            card.classList.remove('card-enter');
            void card.offsetWidth; /* restart the CSS animation */
            card.classList.add('card-enter');
          }
        }
      }

      filterEls.forEach(function (el) {
        el.addEventListener('click', function () {
          var k = el.getAttribute('data-filter');
          var v = el.getAttribute('data-value');
          state[k] = state[k] === v ? '' : v;
          render(true);
          syncUrl();
        });
      });
      sortEls.forEach(function (el) {
        el.addEventListener('click', function () {
          state.sort = el.getAttribute('data-sort') || 'score';
          render(true);
          syncUrl();
        });
      });
      if (clearBtn) {
        clearBtn.addEventListener('click', function () {
          state.grade = '';
          state.tag = '';
          state.lang = '';
          render(true);
          syncUrl();
        });
      }

      render(false);
    })();
  </script>
</Base>

<style>
  .page {
    padding-top: 32px;
  }
  .cat-head {
    margin-bottom: 20px;
  }
  .crumb {
    margin: 0 0 10px;
    font-size: 12.5px;
    color: var(--text-3);
  }
  .crumb a {
    color: var(--text-3);
  }
  .crumb a:hover {
    color: var(--brand);
  }
  .cat-head h1 {
    font-size: clamp(1.7rem, 3.4vw, 2.4rem);
    margin-bottom: 8px;
  }
  .cat-meta {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 6px 16px;
    margin: 0;
  }
  .cat-count {
    font-size: 13px;
    color: var(--brand);
  }
  .cat-blurb {
    font-size: 13.5px;
    color: var(--text-2);
  }

  .filters {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 12px 24px;
    padding: 14px 16px;
    background: var(--bg-surface);
    border: 1px solid var(--line);
    border-radius: var(--radius);
  }
  .fgroup {
    display: flex;
    align-items: center;
    gap: 10px;
  }
  .f-label {
    font-size: 11.5px;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--text-3);
  }
  .f-chips {
    display: flex;
    flex-wrap: wrap;
    gap: 6px;
  }
  .f-chips .chip {
    cursor: pointer;
    transition: border-color var(--t-micro) var(--ease), color var(--t-micro) var(--ease);
  }
  .f-chips .chip:hover {
    color: var(--text-1);
  }
  .f-chips .chip.active {
    border-color: var(--brand);
    color: var(--text-1);
  }
  .f-chips .g-chip {
    gap: 6px;
    padding: 4px 10px;
  }
  .f-chips .g-chip:hover,
  .f-chips .g-chip.active {
    border-color: var(--g);
  }
  .g-dot {
    width: 8px;
    height: 8px;
    border-radius: var(--r-1);
    background: var(--g);
    flex: none;
  }
  .clear-btn {
    margin-left: auto;
    font-size: 12.5px;
    color: var(--text-2);
    transition: color var(--t-micro) var(--ease);
  }
  .clear-btn:hover {
    color: var(--brand);
  }
  .clear-btn[hidden] {
    display: none;
  }

  .list-bar {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 16px;
    margin: 22px 0 14px;
  }
  .list-count {
    margin: 0;
    font-size: 12.5px;
    color: var(--text-3);
  }

  /* §10.7: card flow grid — auto-fill minmax, deliberately no media query */
  .grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(240px, 1fr));
    gap: var(--gutter);
  }

  .empty {
    display: grid;
    justify-items: start;
    gap: 12px;
    padding: 32px 0;
    color: var(--text-2);
    font-size: 14.5px;
  }
  .empty[hidden] {
    display: none;
  }
</style>
