---
// P1 homepage (spec §10.3 / §10.5 / §15.5): the hero IS real data — the
// A–F distribution bar renders actual scan shares, big slogan + local search
// underneath. Then: 14 category tiles → grade filter bar → latest scan stream
// → Top leaderboard (natural AFR ranking). English at /, zh-CN at /zh-CN/.

import Base from '../../layouts/Base.astro';
import DistributionBar from '../../components/home/DistributionBar.astro';
import SearchBox from '../../components/home/SearchBox.astro';
import DomainCard from '../../components/home/DomainCard.astro';
import CategoryTiles from '../../components/home/CategoryTiles.astro';
import Leaderboard from '../../components/home/Leaderboard.astro';
import { getCatalog, pathFor, toLocale } from '../../i18n/loader.ts';
import { loadHome } from '../../data/loader.ts';
import { GRADES, gradeVar } from '../../utils/grade.ts';
import { sitesLabel, uiText } from '../../components/home/fallbacks.ts';

export function getStaticPaths() {
  return [{ params: { locale: undefined } }, { params: { locale: 'zh-CN' } }];
}

const locale = toLocale(Astro.params.locale);
const L = getCatalog(locale);
const href = (p: string) => pathFor(locale, p);

const home = loadHome();
const parsed = new Date(home.generatedAt);
const generated = Number.isNaN(parsed.getTime())
  ? home.generatedAt
  : new Intl.DateTimeFormat(locale === 'zh-CN' ? 'zh-CN' : 'en-US', {
      dateStyle: 'medium',
      timeStyle: 'short',
      timeZone: 'UTC',
    }).format(parsed);

/* ── "How we rate" explainer (product copy, inline EN/ZH — new keys are not
      added to packages/i18n, so this follows the pages' inline-fallback pattern) ── */
const COPY = {
  en: {
    heading: 'How we rate',
    subA: 'What the score measures',
    a1:
      "Every rating on aiapp.im comes from one automated scan of a site's public signals — nothing behind a login, nothing that requires the site's cooperation. Each sub-check is a single HTTP request or DNS lookup that anyone can repeat from the command line.",
    a2:
      "The 100 points split across three layers. Reachability (35) asks whether an AI crawler can reach the content at all: an explicit robots.txt policy for fourteen well-known AI user-agents, no challenge wall, and a homepage that answers. Legibility (40) asks whether a machine can understand what it fetched: llms.txt, structured data, semantic HTML, a sitemap, and basic content signals. Actionability (25) asks whether an agent can do real work with the site: call a published API, read agent instructions, or use documented machine interfaces.",
    a3:
      'Every awarded point carries its raw evidence — the URL that was fetched, the status code, and the rule that matched — so any score can be checked and recomputed. Grades are coordinates on an openness scale: A means openly available to AI systems, F means actively closed off.',
    subB: 'What makes a site AI-friendly',
    b1:
      'The strongest signal is a robots.txt that explicitly allows the AI crawlers you know about instead of silently defaulting or blocking them. After that come the basics of machine readability: pages that render as real HTML without JavaScript, headings that describe structure, images with alt text, a sitemap with lastmod dates, and an llms.txt file that maps your content for language models.',
    b2:
      'Sites that want to be useful to agents go one step further: a public HTTP API with a machine-readable OpenAPI specification, human-readable documentation, and an agents.md file that tells automated visitors who they are talking to, what they may fetch, and how to cite what they find. Stable HTTPS availability rounds it out — none of it matters if the homepage cannot be reached.',
    b3:
      'Ratings never depend on payment or popularity. Sponsored placements live only in separately labeled blocks and cannot change a grade or the natural ranking; verification, badges, and evidence chains stay free.',
    explore: 'Explore',
    docsLabel: 'API documentation',
    aboutLabel: 'About',
    updated: 'Directory data last updated',
  },
  'zh-CN': {
    heading: '我们如何评级',
    subA: '分数测什么',
    a1:
      'aiapp.im 的每个评级都来自对站点公开信号的一次自动扫描——没有登录墙，也不需要站点配合。每个子项都是一次 HTTP 请求或 DNS 查询，任何人都能在命令行里重复。',
    a2:
      '100 分分三层。可达层（35 分）问 AI 爬虫能不能拿到内容：对 14 个知名 AI User-Agent 的显式 robots.txt 政策、没有挑战墙、首页正常应答。可懂层（40 分）问机器能不能读懂抓到的东西：llms.txt、结构化数据、语义化 HTML、sitemap 与基础内容信号。可交互层（25 分）问智能体能不能真的干活：调用公开 API、读取 Agent 指令、使用有文档的机读接口。',
    a3:
      '每个得分点都带原始证据——抓取的 URL、状态码与命中的规则——因此任何分数都能核对与复算。等级是开放度坐标：A 表示对 AI 系统完全开放，F 表示主动关闭。',
    subB: '什么让一个网站 AI 友好',
    b1:
      '最强的信号是 robots.txt 显式放行你认识的 AI 爬虫，而不是默默走默认或直接屏蔽。其次是机器可读的基本功：不依赖 JS 也能渲染出真实 HTML、能描述结构的标题层级、带 alt 文本的图片、含 lastmod 的 sitemap，以及为语言模型绘制内容地图的 llms.txt。',
    b2:
      '想对智能体更有用的网站会再进一步：公开的 HTTP API 配机读 OpenAPI 规范、人类可读的文档，以及一份 agents.md，告诉自动访客它们在和谁说话、可以抓什么、如何引用找到的内容。稳定的 HTTPS 可用性是底线——首页都打不开，其他都白搭。',
    b3:
      '评级从不依赖付费或热度。付费展示只出现在独立标注的区块里，不能改变等级或自然排名；验证、徽章与证据链永久免费。',
    explore: '继续了解',
    docsLabel: 'API 文档',
    aboutLabel: '关于',
    updated: '目录数据最后更新于',
  },
}[locale];
---

<Base description={L.ui.heroSub}>
  <!-- Hero: slogan + real distribution data + search (§15.5 — no decorative art) -->
  <section class="hero container">
    <p class="hero-kicker mono">aiapp.im · AFR</p>
    <h1 class="hero-slogan">{L.ui.heroSlogan}</h1>
    <p class="hero-sub">{L.ui.heroSub}</p>

    <div class="hero-dist">
      <h2 class="sec-label">{L.ui.distributionTitle}</h2>
      <DistributionBar distribution={home.distribution} total={home.total} locale={locale} />
      <p class="hero-stats mono">
        <span>{sitesLabel(L.ui, locale, home.total)}</span>
        <span>{uiText(L.ui, 'avgScore', locale)} {home.avgScore}</span>
        <span>{L.ui.scanTime} <time datetime={home.generatedAt}>{generated}</time></span>
      </p>
    </div>

    <div class="hero-search">
      <SearchBox sites={home.leaderboard} locale={locale} />
    </div>
  </section>

  <!-- 14 category tiles (§7.1) -->
  <section class="section container">
    <div class="sec-head">
      <h2>{L.ui.categoriesTitle}</h2>
      <a class="sec-more" href={href('/categories')}>{L.ui.viewAll} →</a>
    </div>
    <CategoryTiles locale={locale} />
  </section>

  <!-- Grade filter bar — syncs ?grade= and filters the streams below -->
  <section class="section container" aria-label={L.ui.filterGrade}>
    <div class="grade-bar">
      <span class="gb-label mono">{L.ui.filterGrade}</span>
      <div class="gb-chips">
        {GRADES.map((g) => (
          <a
            class="chip g-chip"
            href={href(`/?grade=${g}`)}
            data-grade-chip={g}
            style={`--g:${gradeVar(g)}`}
          >
            <span class="g-dot" aria-hidden="true"></span>
            <span class="mono">{g}</span>
            <span class="g-slogan">{L.grades[g]?.slogan ?? ''}</span>
            <span class="g-count mono">{home.distribution[g] ?? 0}</span>
          </a>
        ))}
      </div>
      <a class="gb-clear" data-clear href={href('/')} hidden>{L.ui.clearFilters}</a>
    </div>
  </section>

  <!-- Latest scans -->
  <section class="section container">
    <div class="sec-head">
      <h2>{L.ui.latestTitle}</h2>
      <a class="sec-more" href={href('/search')}>{L.ui.viewAll} →</a>
    </div>
    {home.latest.length > 0 ? (
      <div class="grid">
        {home.latest.map((s, i) => <DomainCard site={s} locale={locale} index={i} />)}
      </div>
    ) : (
      <p class="muted">{L.ui.searchEmpty}</p>
    )}
  </section>

  <!-- Top leaderboard — natural ranking, pure AFR score descending -->
  <section class="section container">
    <div class="sec-head">
      <h2>{L.ui.leaderboardTitle}</h2>
      <span class="sec-note">{L.ui.neutralityStatement}</span>
    </div>
    <Leaderboard sites={home.leaderboard} locale={locale} />
  </section>

  <!-- How we rate — product explanation: what the score measures and what
       makes a site AI-friendly (also the homepage's deep content section) -->
  <section class="section container explainer" aria-labelledby="explainer-h">
    <div class="sec-head">
      <h2 id="explainer-h">{COPY.heading}</h2>
      <a class="sec-more" href={href('/method')}>{L.ui.navMethod} →</a>
    </div>
    <div class="ex-grid">
      <article class="ex-card">
        <h3>{COPY.subA}</h3>
        <p>{COPY.a1}</p>
        <p>{COPY.a2}</p>
        <p>{COPY.a3}</p>
      </article>
      <article class="ex-card">
        <h3>{COPY.subB}</h3>
        <p>{COPY.b1}</p>
        <p>{COPY.b2}</p>
        <p>{COPY.b3}</p>
      </article>
    </div>
    <p class="ex-links">
      <span class="ex-label mono">{COPY.explore}:</span>
      <a href={href('/method')}>{L.ui.navMethod}</a>
      <span aria-hidden="true">·</span>
      <a href={href('/docs')}>{COPY.docsLabel}</a>
      <span aria-hidden="true">·</span>
      <a href="/llms.txt">llms.txt</a>
      <span aria-hidden="true">·</span>
      <a href="/agents.md">agents.md</a>
      <span aria-hidden="true">·</span>
      <a href="/openapi.json">OpenAPI</a>
      <span aria-hidden="true">·</span>
      <a href={href('/about')}>{COPY.aboutLabel}</a>
    </p>
    <p class="ex-updated mono">
      {COPY.updated} <time datetime={home.generatedAt}>{generated}</time>
    </p>
  </section>

  <!-- Grade filter: distribution segments + chips share one URL-synced state (§10.6) -->
  <script is:inline>
    (function () {
      var VALID = ['A', 'B', 'C', 'D', 'F'];
      var params = new URLSearchParams(location.search);
      var raw = (params.get('grade') || '').toUpperCase();
      var active = VALID.indexOf(raw) !== -1 ? raw : '';

      function apply(g) {
        active = g;
        var sites = document.querySelectorAll('[data-site-grade]');
        for (var i = 0; i < sites.length; i++) {
          sites[i].hidden = g !== '' && sites[i].getAttribute('data-site-grade') !== g;
        }
        var chips = document.querySelectorAll('[data-grade-chip]');
        for (var j = 0; j < chips.length; j++) {
          var on = chips[j].getAttribute('data-grade-chip') === g;
          chips[j].classList.toggle('active', on);
          if (on) chips[j].setAttribute('aria-current', 'true');
          else chips[j].removeAttribute('aria-current');
        }
        var segs = document.querySelectorAll('[data-grade-seg]');
        for (var k = 0; k < segs.length; k++) {
          segs[k].classList.toggle('active', segs[k].getAttribute('data-grade-seg') === g);
        }
        var clear = document.querySelector('[data-clear]');
        if (clear) clear.hidden = g === '';
      }

      apply(active);

      document.addEventListener('click', function (e) {
        var node = e.target;
        var el =
          node && node.closest
            ? node.closest('[data-grade-chip],[data-grade-seg],[data-clear]')
            : null;
        if (!el) return;
        e.preventDefault();
        var g = el.hasAttribute('data-clear')
          ? ''
          : el.getAttribute('data-grade-chip') || el.getAttribute('data-grade-seg') || '';
        apply(g === active ? '' : g);
        var url = new URL(location.href);
        if (active) url.searchParams.set('grade', active);
        else url.searchParams.delete('grade');
        try {
          history.replaceState(null, '', url);
        } catch (err) {
          /* file:// or sandboxed context — the filter above already applied */
        }
      });
    })();
  </script>
</Base>

<style>
  .hero {
    padding-top: 52px;
  }
  .hero-kicker {
    margin: 0 0 18px;
    font-size: 12px;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--text-3);
  }
  .hero-slogan {
    font-size: clamp(2.1rem, 5.2vw, 3.9rem);
    font-weight: 700;
    letter-spacing: -0.02em;
    max-width: 16em;
    margin-bottom: 14px;
  }
  .hero-sub {
    margin: 0 0 32px;
    max-width: 640px;
    font-size: clamp(1rem, 1.5vw, 1.12rem);
    color: var(--text-2);
  }
  .hero-dist {
    margin-bottom: 30px;
  }
  .sec-label {
    font-family: var(--font-body);
    font-size: 13px;
    font-weight: 500;
    color: var(--text-2);
    margin-bottom: 10px;
  }
  .hero-stats {
    display: flex;
    flex-wrap: wrap;
    gap: 6px 20px;
    margin: 14px 0 0;
    font-size: 12.5px;
    color: var(--text-3);
  }
  .hero-search {
    max-width: 560px;
  }

  .section {
    margin-top: 52px;
  }
  .sec-head {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 16px;
    margin-bottom: 16px;
  }
  .sec-head h2 {
    font-size: 20px;
    margin: 0;
  }
  .sec-more {
    font-size: 13px;
    color: var(--text-2);
    flex: none;
  }
  .sec-note {
    font-size: 12.5px;
    color: var(--text-3);
    text-align: right;
  }

  /* card grids: §10.7 auto-fill minmax, no media query */
  .grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(240px, 1fr));
    gap: var(--gutter);
  }

  /* grade filter bar */
  .grade-bar {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: 10px 14px;
    padding: 14px 16px;
    background: var(--bg-surface);
    border: 1px solid var(--line);
    border-radius: var(--radius);
  }
  .gb-label {
    font-size: 12px;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--text-3);
  }
  .gb-chips {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
  }
  .gb-chips .g-chip {
    gap: 6px;
    padding: 4px 10px;
    transition: border-color var(--t-micro) var(--ease), color var(--t-micro) var(--ease);
  }
  .gb-chips .g-chip:hover {
    border-color: var(--g);
    color: var(--text-1);
  }
  .g-chip.active {
    border-color: var(--g);
    color: var(--text-1);
  }
  .g-dot {
    width: 8px;
    height: 8px;
    border-radius: var(--r-1);
    background: var(--g);
    flex: none;
  }
  .g-slogan {
    font-size: 11.5px;
    color: var(--text-3);
  }
  .g-count {
    font-size: 11.5px;
    color: var(--text-2);
  }
  .gb-clear {
    font-size: 12.5px;
    color: var(--text-2);
    margin-left: auto;
  }
  .gb-clear:hover {
    color: var(--brand);
  }
  .gb-clear[hidden] {
    display: none;
  }

  .muted {
    color: var(--text-2);
    font-size: 14px;
  }

  /* How we rate explainer */
  .ex-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(300px, 1fr));
    gap: var(--gutter);
  }
  .ex-card {
    background: var(--bg-surface);
    border: 1px solid var(--line);
    border-radius: var(--radius);
    padding: 22px 24px;
  }
  .ex-card h3 {
    font-size: 16px;
    margin: 0 0 10px;
  }
  .ex-card p {
    margin: 0 0 12px;
    font-size: 14.5px;
    line-height: 1.7;
    color: var(--text-2);
  }
  .ex-card p:last-child {
    margin-bottom: 0;
  }
  .ex-links {
    display: flex;
    flex-wrap: wrap;
    gap: 6px 10px;
    align-items: baseline;
    margin: 16px 0 0;
    font-size: 13.5px;
    color: var(--text-2);
  }
  .ex-links a {
    color: var(--brand);
  }
  .ex-label {
    color: var(--text-3);
    font-size: 12px;
    text-transform: uppercase;
    letter-spacing: 0.06em;
  }
  .ex-updated {
    margin: 8px 0 0;
    font-size: 12.5px;
    color: var(--text-3);
  }
</style>
