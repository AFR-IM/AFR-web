---
// Categories index — all 14 first-level categories (spec §7.1) with bilingual
// name + blurb + site count, each linking to /c/{slug}. EN at /, zh-CN at /zh-CN/.

import Base from '../../layouts/Base.astro';
import CategoryTiles from '../../components/home/CategoryTiles.astro';
import { getCatalog, pathFor, toLocale } from '../../i18n/loader.ts';
import { listCategories, listSites } from '../../data/loader.ts';
import { sitesLabel } from '../../components/home/fallbacks.ts';

export function getStaticPaths() {
  return [{ params: { locale: undefined } }, { params: { locale: 'zh-CN' } }];
}

const locale = toLocale(Astro.params.locale);
const L = getCatalog(locale);
const href = (p: string) => pathFor(locale, p);

const total = listSites().length || listCategories().reduce((n, c) => n + c.count, 0);
---

<Base title={L.ui.categoriesTitle} description={L.ui.tagline}>
  <div class="container page">
    <header class="page-head">
      <h1>{L.ui.categoriesTitle}</h1>
      <p class="page-sub">
        {sitesLabel(L.ui, locale, total)} · <a href={href('/search')}>{L.ui.viewAll} →</a>
      </p>
    </header>

    <CategoryTiles locale={locale} showBlurb />
  </div>
</Base>

<style>
  .page {
    padding-top: 44px;
  }
  .page-head {
    margin-bottom: 24px;
  }
  .page-head h1 {
    font-size: clamp(1.7rem, 3.4vw, 2.4rem);
    margin-bottom: 8px;
  }
  .page-sub {
    margin: 0;
    font-size: 13.5px;
    color: var(--text-2);
  }
  .page-sub a {
    color: var(--text-2);
  }
  .page-sub a:hover {
    color: var(--brand);
  }
</style>
