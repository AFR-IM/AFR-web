---
// The browser fills this empty row with the API's current grade and score.
// Keep GradeRing outside <template> so its script also runs for natural cards.
import GradeRing from '../grade/GradeRing.astro';
import AdBeacon from './AdBeacon.astro';
import { getCatalog, type Locale } from '../../i18n/loader.ts';
import { uiText } from './fallbacks.ts';

type Props = { locale: Locale } & (
  { slot: 'category-top'; adKey: string } | { slot: 'search-top'; adKey?: never }
);

const { locale, slot, adKey } = Astro.props;
const L = getCatalog(locale);
const sponsored = uiText(L.ui, 'sponsored', locale);
const visit = uiText(L.ui, 'visit', locale);
const report = locale === 'zh-CN' ? '举报广告' : 'Report ad';
---

<aside
  class:list={['sponsor-zone', { search: slot === 'search-top' }]}
  data-ad-slot={slot}
  data-ad-key={adKey}
  data-ad-locale={locale}
  data-ad-grade-label={L.ui.grade}
  data-ad-score-label={L.ui.score}
  hidden
  aria-label={sponsored}
>
  <div data-ad-items>
    <div class="sponsor">
      <div class="sponsor-left">
        <GradeRing score={0} grade="F" size={48} animate={false} />
        <span class="sponsor-badge">{sponsored}</span>
      </div>
      <div class="sponsor-main">
        <p class="sponsor-domain mono" data-ad-domain></p>
        <h3 class="sponsor-headline" data-ad-headline></h3>
        <p class="sponsor-text" data-ad-body></p>
      </div>
      <div class="sponsor-actions">
        <a class="btn" data-ad-visit target="_blank" rel="noopener noreferrer sponsored">{visit}</a>
        <a class="sponsor-report" data-ad-report target="_blank" rel="noopener noreferrer">{report}</a>
      </div>
    </div>
  </div>
</aside>

<AdBeacon />

<style>
  .sponsor-zone {
    padding-bottom: 24px; /* 24px whitespace before the dashed rule */
    border-bottom: 1px dashed var(--line);
    margin-bottom: 16px;
  }
  .sponsor-zone[hidden] {
    display: none;
  }
  .sponsor {
    display: flex;
    align-items: center;
    gap: 20px;
    padding: 18px 20px;
    background: var(--bg-elevated); /* one step brighter than natural cards */
    border: 1px solid var(--line);
    border-radius: var(--radius);
  }
  .sponsor-left {
    display: grid;
    justify-items: center;
    gap: 8px;
    flex: none;
  }
  .sponsor-badge {
    font-size: 11px;
    line-height: 1;
    color: var(--text-2); /* permanent, non-removable badge */
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }
  .sponsor-main {
    flex: 1;
    min-width: 0;
    display: grid;
    gap: 3px;
    overflow-wrap: anywhere;
  }
  /* The API may carry an older rated site's E; it has no current color token. */
  .sponsor :global(.ring[data-grade='E']) {
    --ring-color: var(--grade-e, var(--text-2));
  }
  .sponsor-domain {
    margin: 0;
    font-size: 12px;
    color: var(--text-2);
  }
  .sponsor-headline {
    margin: 0;
    font-family: var(--font-display);
    font-size: 16px;
    font-weight: 600;
    color: var(--text-1);
  }
  .sponsor-text {
    margin: 0;
    font-size: 13px;
    line-height: 1.5;
    color: var(--text-2);
  }
  .sponsor-actions {
    flex: none;
    display: grid;
    justify-items: center;
    gap: 4px;
  }
  .sponsor-report {
    color: var(--text-2);
    font-size: 12px;
    text-decoration: underline;
  }

  /* position 2 (search top): same block, narrower row */
  .sponsor-zone.search {
    margin-top: 24px;
    padding-bottom: 16px;
    margin-bottom: 16px;
  }
  .sponsor-zone.search .sponsor {
    padding: 12px 16px;
    gap: 14px;
  }
  .sponsor-zone.search .sponsor-headline {
    font-size: 14px;
  }
  .sponsor-zone.search .sponsor-text {
    display: -webkit-box;
    -webkit-line-clamp: 1;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  @media (max-width: 560px) {
    .sponsor {
      flex-wrap: wrap;
      gap: 14px;
      padding: 16px;
    }
    .sponsor-main {
      flex: 1 1 200px;
    }
  }
</style>
