---
// CategoryTiles — the 14 first-level categories (spec §7.1) as a tile grid;
// every tile shows its localized name + site count and links to /c/{slug}.
// Counts come from the site list first (matches what the category page shows)
// with listCategories() as the fallback for slices the list does not carry.

import { getCatalog, pathFor, type Locale } from '../../i18n/loader.ts';
import { listCategories, listSites } from '../../data/loader.ts';
import { sitesLabel } from './fallbacks.ts';

interface Props {
  locale: Locale;
  showBlurb?: boolean; // categories index page renders the bilingual blurb too
}

const { locale, showBlurb = false } = Astro.props;
const L = getCatalog(locale);

const listed = new Map(listCategories().map((c) => [c.slug, c.count]));
const scanned = new Map<string, number>();
for (const s of listSites()) {
  if (s.category) scanned.set(s.category, (scanned.get(s.category) ?? 0) + 1);
}
const countOf = (slug: string): number => scanned.get(slug) ?? listed.get(slug) ?? 0;

const slugs = Object.keys(L.categories);
---

<div class="tiles">
  {slugs.map((slug) => {
    const cat = L.categories[slug];
    if (!cat) return null;
    return (
      <a class="tile" href={pathFor(locale, `/c/${slug}`)}>
        <span class="tile-name">{cat.name}</span>
        {showBlurb && <span class="tile-blurb">{cat.blurb}</span>}
        <span class="tile-count mono">{sitesLabel(L.ui, locale, countOf(slug))}</span>
      </a>
    );
  })}
</div>

<style>
  .tiles {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(150px, 1fr));
    gap: 12px;
  }
  .tile {
    display: grid;
    gap: 5px;
    align-content: start;
    padding: 14px;
    background: var(--bg-surface);
    border: 1px solid var(--line);
    border-radius: var(--radius);
    transition: border-color var(--t-micro) var(--ease), transform var(--t-micro) var(--ease);
  }
  .tile:hover {
    border-color: var(--brand);
    transform: translateY(-2px);
    color: inherit; /* keep token text colors; only the name lights up */
  }
  .tile-name {
    font-size: 14px;
    font-weight: 600;
    color: var(--text-1);
    transition: color var(--t-micro) var(--ease);
  }
  .tile:hover .tile-name {
    color: var(--brand);
  }
  .tile-blurb {
    font-size: 12px;
    line-height: 1.45;
    color: var(--text-3);
  }
  .tile-count {
    font-size: 11.5px;
    color: var(--text-2);
    margin-top: 2px;
  }
</style>
