---
// Leaderboard — the homepage "Top" list: natural ranking =
// pure AFR score descending, with visible rank numbers. Mono for domain,
// grade letter and score. Rows carry data-site-grade so the
// homepage grade filter can hide them without touching layout.

import { getCatalog, pathFor, type Locale } from '../../i18n/loader.ts';
import type { SiteCard } from '../../data/types.ts';
import { gradeVar } from '../../utils/grade.ts';

interface Props {
  sites: SiteCard[];
  locale: Locale;
}

const { sites, locale } = Astro.props;
const L = getCatalog(locale);
---

<ol class="lb">
  {sites.map((s, i) => (
    <li class="lb-item" data-site-grade={s.grade}>
      <a class="lb-row" href={pathFor(locale, `/site/${s.domain}`)}>
        <span class="lb-rank mono">{String(i + 1).padStart(2, '0')}</span>
        <span class="lb-domain mono">{s.domain}</span>
        <span class="lb-title">{s.title}</span>
        <span class="lb-strategy chip">{L.strategies[s.strategyTag]?.label ?? s.strategyTag}</span>
        <span class="lb-grade mono" style={`color:${gradeVar(s.grade)}`}>{s.grade}</span>
        <span class="lb-score mono">{s.score}</span>
      </a>
    </li>
  ))}
</ol>

<style>
  .lb {
    list-style: none;
    margin: 0;
    padding: 0;
    border: 1px solid var(--line);
    border-radius: var(--radius);
    overflow: hidden;
    background: var(--bg-surface);
  }
  .lb-item + .lb-item .lb-row {
    border-top: 1px solid var(--line);
  }
  .lb-row {
    display: grid;
    grid-template-columns: 40px minmax(140px, 1.1fr) minmax(0, 1.8fr) auto 28px 48px;
    align-items: center;
    gap: 14px;
    padding: 12px 16px;
    transition: background var(--t-micro) var(--ease);
  }
  .lb-row:hover {
    background: var(--bg-elevated);
    color: inherit;
  }
  .lb-rank {
    font-size: 13px;
    color: var(--text-3);
  }
  .lb-domain {
    font-size: 14px;
    font-weight: 700;
    color: var(--text-1);
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }
  .lb-row:hover .lb-domain {
    color: var(--brand);
  }
  .lb-title {
    font-size: 13px;
    color: var(--text-2);
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }
  .lb-strategy {
    justify-self: start;
  }
  .lb-grade {
    font-size: 14px;
    font-weight: 700;
    text-align: center;
  }
  .lb-score {
    font-size: 14px;
    font-weight: 700;
    color: var(--text-1);
    text-align: right;
  }

  @media (max-width: 767px) {
    .lb-row {
      grid-template-columns: 32px minmax(0, 1fr) 24px 44px;
      gap: 10px;
      padding: 12px;
    }
    .lb-title,
    .lb-strategy {
      display: none;
    }
  }
</style>
