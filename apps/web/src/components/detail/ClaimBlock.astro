---
// ClaimBlock — detail-page right column: verified owners publish a statement
// that answers their score (200 characters, 600 with Pro). Shown beside the
// report so both sides speak with equal weight; empty state uses the catalog
// key. An http(s) URL inside a statement renders as a link — the moderation
// queue published the text, links included.

import { getCatalog } from '../../i18n/loader.ts';

interface Props {
  claim?: string;
  locale: string;
}

const { claim, locale } = Astro.props;
const L = getCatalog(locale);
const isZh = locale === 'zh-CN';
const T = (en: string, zh: string) => (isZh ? zh : en);
const hint = L.ui.claimHint ?? T(
  'Verified owners can publish up to 200 characters here — 600 with Pro.',
  '已验证站方可在此发布 200 字以内的声明（Pro 600 字）。',
);

/** Split a statement into plain text and http(s) links. Only a URL match
 * becomes a link; every other byte stays escaped text (Astro escapes the
 * strings), and trailing sentence punctuation stays with the sentence. */
const LINK_RE = /https?:\/\/[^\s<>"']+/g;
function statementParts(text: string): Array<string | { href: string }> {
  const parts: Array<string | { href: string }> = [];
  let cursor = 0;
  for (const match of text.matchAll(LINK_RE)) {
    const start = match.index ?? 0;
    const whole = match[0];
    const tail = whole.match(/[.,;:!?)\]}]+$/)?.[0] ?? '';
    const url = tail ? whole.slice(0, whole.length - tail.length) : whole;
    if (start > cursor) parts.push(text.slice(cursor, start));
    if (url) parts.push({ href: url });
    if (tail) parts.push(tail);
    cursor = start + whole.length;
  }
  if (cursor < text.length) parts.push(text.slice(cursor));
  return parts;
}

const parts = claim ? statementParts(claim) : [];
---

<section class="claim" aria-label={L.ui.statementTitle}>
  <header class="claim-head">
    <h2>{L.ui.statementTitle}</h2>
    <span class="hint" title={hint}>?</span>
  </header>
  {
    claim ? (
      <blockquote class="body">
        {parts.map((part) =>
          typeof part === 'string' ? (
            part
          ) : (
            <a href={part.href} target="_blank" rel="noopener nofollow ugc">{part.href}</a>
          ),
        )}
      </blockquote>
    ) : (
      <p class="empty">{L.ui.statementEmpty}</p>
    )
  }
</section>

<style>
  .claim {
    background: var(--bg-surface);
    border: 1px solid var(--line);
    border-radius: var(--radius);
    padding: 14px;
  }
  .claim-head {
    display: flex;
    align-items: center;
    gap: 6px;
    margin-bottom: 8px;
  }
  .claim-head h2 {
    font-size: 15px;
    margin: 0;
  }
  .hint {
    display: inline-grid;
    place-items: center;
    width: 16px;
    height: 16px;
    border: 1px solid var(--line);
    border-radius: 50%;
    font-size: 10px;
    color: var(--text-3);
    cursor: help;
  }
  .body {
    margin: 0;
    padding: 10px 12px;
    background: var(--bg-elevated);
    border-left: 2px solid var(--brand);
    border-radius: 0 var(--r-1) var(--r-1) 0;
    font-size: 13.5px;
    line-height: 1.7;
    color: var(--text-1);
  }
  .body a {
    color: var(--brand);
    overflow-wrap: anywhere;
  }
  .empty {
    margin: 0;
    font-size: 13px;
    color: var(--text-3);
    font-style: italic;
  }
</style>
