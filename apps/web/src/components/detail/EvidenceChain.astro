---
// EvidenceChain — spec §10.3 P3 center column: the full evidence chain, richer
// terminal-style rendering of EVERY check grouped by layer (mono, expandable).
// On mobile this column is the "Evidence" tab content.
// Principle (spec §3 P2): no evidence, no points — every awarded point links to
// its source snapshot / excerpt.

import type { SiteDetail } from '../../data/types.ts';
import { gradeVar } from '../../utils/grade.ts';
import { getCatalog } from '../../i18n/loader.ts';
import EvidenceRow from './EvidenceRow.astro';

interface Props {
  site: SiteDetail;
  locale: string;
}

const { site, locale } = Astro.props;
const L = getCatalog(locale);
const isZh = locale === 'zh-CN';
const T = (en: string, zh: string) => (isZh ? zh : en);
const gc = gradeVar(site.grade);
const totalChecks = site.layers.reduce((n, l) => n + l.checks.length, 0);
const principle = T(
  'Principle P2 — no evidence, no points: every awarded point above links to its raw source.',
  '原则 P2——无证据不给分：上方每个得分点都可展开查看原始证据。',
);
---

<section class="chain" aria-label={L.ui.evidenceTitle}>
  <header class="term-head mono">
    <span class="prompt">$</span> evidence --domain {site.domain} --engine {site.engineVersion}
    <span class="hint">{totalChecks} {T('checks', '项检查')}</span>
  </header>

  <div class="term-body">
    {
      totalChecks === 0 ? (
        <p class="empty">{L.ui.statusPending}</p>
      ) : (
        site.layers.map((layer) => {
          const name = L.layers[layer.layer] ?? layer.name;
          return (
            <div class="group">
              <div class="group-head mono">
                <span class="g-id" style={`color:${gc};`}>
                  {layer.layer}
                </span>
                <span class="g-name">{name}</span>
                <span class="g-score">
                  {layer.awarded} / {layer.max}
                </span>
              </div>
              <div class="rows">
                {layer.checks.map((c) => (
                  <EvidenceRow check={c} locale={locale} tone="terminal" />
                ))}
              </div>
            </div>
          );
        })
      )
    }
  </div>

  <footer class="term-foot mono">{principle}</footer>
</section>

<style>
  .chain {
    background: var(--bg-surface);
    border: 1px solid var(--line);
    border-radius: var(--radius);
    overflow: hidden;
  }

  .term-head {
    display: flex;
    align-items: center;
    gap: 8px;
    padding: 10px 14px;
    background: var(--bg-elevated);
    border-bottom: 1px solid var(--line);
    font-size: 12px;
    color: var(--text-2);
    word-break: break-all;
  }
  .prompt {
    color: var(--brand);
  }
  .hint {
    margin-left: auto;
    color: var(--text-3);
    white-space: nowrap;
  }

  .term-body {
    padding: 14px;
    display: grid;
    gap: 18px;
  }
  .empty {
    margin: 0;
    color: var(--text-3);
    font-size: 13px;
  }

  .group-head {
    display: flex;
    align-items: baseline;
    gap: 8px;
    font-size: 12.5px;
    margin-bottom: 6px;
    color: var(--text-3);
  }
  .g-id {
    font-weight: 700;
  }
  .g-name {
    flex: 1;
    color: var(--text-2);
  }
  .g-score {
    color: var(--text-2);
  }

  .rows {
    border: 1px solid var(--line);
    border-radius: var(--r-1);
    background: var(--bg-ink);
    overflow: hidden;
  }

  .term-foot {
    padding: 10px 14px;
    border-top: 1px dashed var(--line);
    font-size: 11.5px;
    line-height: 1.6;
    color: var(--text-3);
  }
</style>
