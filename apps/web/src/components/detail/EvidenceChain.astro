---
// EvidenceChain — detail-page center column: the full evidence chain, richer
// terminal-style rendering of EVERY check grouped by layer (mono, expandable).
// On mobile this column is the "Evidence" tab content.
// Principle (spec §3 P2): no evidence, no points — every awarded point links to
// its source snapshot / excerpt.

import type { SiteDetail } from '../../data/types.ts';
import { gradeTextVar } from '../../utils/grade.ts';
import { getCatalog, pathFor, toLocale } from '../../i18n/loader.ts';
import EvidenceRow from './EvidenceRow.astro';

interface Props {
  site: SiteDetail;
  locale: string;
}

const { site, locale } = Astro.props;
const L = getCatalog(locale);
const isZh = locale === 'zh-CN';
const T = (en: string, zh: string) => (isZh ? zh : en);
const gc = gradeTextVar(site.grade); // g-id label text
const totalChecks = site.layers.reduce((n, l) => n + l.checks.length, 0);
const principle = L.ui.evidencePrinciple ?? T(
  'No evidence, no points: every awarded point above links to its raw source.',
  '无证据不给分：上方每个得分点都可展开查看原始证据。',
);
const methodHref = pathFor(toLocale(locale), '/method');
const layersTitle = L.ui.layersLinkTitle ?? 'How each layer is scored — see Method';
const legend = [
  ['pass', L.ui.dotPass ?? 'Pass'],
  ['partial', L.ui.dotPartial ?? 'Partial'],
  ['fail', L.ui.dotFail ?? 'Fail'],
  ['unknown', L.ui.dotUnknown ?? 'Unknown'],
] as const;
---

<section class="chain" aria-label={L.ui.evidenceTitle}>
  <header class="term-head mono">
    <span class="prompt">$</span> evidence --domain {site.domain} --engine {site.engineVersion}
    <span class="hint">{totalChecks} {L.ui.checksLabel ?? T('checks', '项检查')}</span>
  </header>

  {totalChecks > 0 && (
    <p class="legend mono" aria-label={L.ui.statusLegend ?? T('Status legend', '状态图例')}>
      {legend.map(([s, label]) => (
        <span class="lg-item"><span class={`lg-dot ${s}`} aria-hidden="true" />{label}</span>
      ))}
    </p>
  )}

  <div class="term-body">
    {
      totalChecks === 0 ? (
        <p class="empty">{L.ui.statusPending}</p>
      ) : (
        site.layers.map((layer) => {
          const name = L.layers[layer.layer] ?? layer.name;
          return (
            <div class="group">
              <div class="group-head mono">
                <span class="g-id" style={`color:${gc};`}>
                  {layer.layer}
                </span>
                <a class="g-name" href={`${methodHref}#layers`} title={layersTitle}>{name}</a>
                <span class="g-score">
                  {layer.awarded} / {layer.max}
                </span>
              </div>
              <div class="rows">
                {layer.checks.map((c) => (
                  <EvidenceRow check={c} locale={locale} tone="terminal" />
                ))}
              </div>
            </div>
          );
        })
      )
    }
  </div>

  <footer class="term-foot mono">{principle}</footer>
</section>

<style>
  .chain {
    background: var(--bg-surface);
    border: 1px solid var(--line);
    border-radius: var(--radius);
    overflow: hidden;
  }

  .term-head {
    display: flex;
    align-items: center;
    gap: 8px;
    padding: 10px 14px;
    background: var(--bg-elevated);
    border-bottom: 1px solid var(--line);
    font-size: 12px;
    color: var(--text-2);
    word-break: break-all;
  }
  .prompt {
    color: var(--brand-link);
  }
  .hint {
    margin-left: auto;
    color: var(--text-3);
    white-space: nowrap;
  }

  .term-body {
    padding: 14px;
    display: grid;
    grid-template-columns: minmax(0, 1fr); /* content can never stretch the column */
    gap: 18px;
  }

  /* status legend — explains the dots every EvidenceRow carries */
  .legend {
    display: flex;
    flex-wrap: wrap;
    gap: 4px 14px;
    margin: 0;
    padding: 8px 14px;
    border-bottom: 1px solid var(--line);
    font-size: 11.5px;
    color: var(--text-3);
  }
  .lg-item {
    display: inline-flex;
    align-items: center;
    gap: 5px;
  }
  .lg-dot {
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background: var(--text-3);
  }
  .lg-dot.pass {
    background: var(--grade-b);
  }
  .lg-dot.partial {
    background: var(--grade-c);
  }
  .lg-dot.fail {
    background: var(--grade-f);
  }
  .lg-dot.unknown {
    background: var(--text-3);
  }
  .empty {
    margin: 0;
    color: var(--text-3);
    font-size: 13px;
  }

  .group-head {
    display: flex;
    align-items: baseline;
    gap: 8px;
    font-size: 12.5px;
    margin-bottom: 6px;
    color: var(--text-3);
  }
  .g-id {
    font-weight: 700;
  }
  .g-name {
    flex: 1;
    color: var(--text-2);
  }
  .g-name:hover {
    color: var(--brand-link);
    text-decoration: underline;
  }
  .g-score {
    color: var(--text-2);
  }

  .rows {
    border: 1px solid var(--line);
    border-radius: var(--r-1);
    background: var(--bg-ink);
    overflow: hidden;
  }

  .term-foot {
    padding: 10px 14px;
    border-top: 1px dashed var(--line);
    font-size: 11.5px;
    line-height: 1.6;
    color: var(--text-3);
  }
</style>
