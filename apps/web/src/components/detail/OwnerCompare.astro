---
// OwnerCompare — the competitor comparison (a Pro benefit), right column of
// the owner workspace. The data itself is public (every rating is); the
// endpoint arranges it, so the panel opens only for this site's management
// token with an active Pro term:
//   no token   → hint to confirm the mailbox first
//   free tier  → the benefit described, one scroll to the Pro panel
//   Pro        → load on demand: GET /api/v1/compare?domain= → the owner's
//                site inside its category, top of the category or the
//                owner's neighbourhood, owner row highlighted.
// Built with textContent only — a title from the directory never becomes
// markup. aria-live status, no alert/toast.

interface Props {
  domain: string;
  locale: string;
}

const { domain, locale } = Astro.props;
const isZh = locale === 'zh-CN';
const T = (en: string, zh: string) => (isZh ? zh : en);

const title = T('Competitor comparison', '竞品对比');
const descNoToken = T(
  'Confirm your owner mailbox to see your Pro tools here.',
  '先确认站主邮箱，Pro 工具会出现在这里。',
);
const descFree = T(
  'Competitor comparison is part of AFR Pro: your site next to the others of its category.',
  '竞品对比是 AFR Pro 的权益：你的站点与同类站点并排对照。',
);
const loadText = T('Show my category', '查看同类站点');
const loadingText = T('Loading…', '加载中……');
const errText = T('Could not load the comparison — try again.', '无法加载对比——请重试。');
const unauthorizedText = T(
  'This site’s management token is not on this device.',
  '本机没有该站点的管理令牌。',
);
const rankTpl = T('Your rank: {r} of {n}', '你的排名：{r} / {n}');
const noScoreText = T(
  'Your site has no comparable score yet — the table shows the category top.',
  '你的站点尚无可比分数——表格显示分类头部。',
);
const colRank = T('Rank', '名次');
const colSite = T('Site', '站点');
const colGrade = T('Grade', '等级');
const colScore = T('Score', '分数');
const youLabel = T('you', '你');
---

<section
  class="owner-compare"
  data-owner-compare
  data-domain={domain}
  data-locale={locale}
  data-desc-notoken={descNoToken}
  data-desc-free={descFree}
  data-label-load={loadText}
  data-msg-loading={loadingText}
  data-msg-error={errText}
  data-msg-unauthorized={unauthorizedText}
  data-tpl-rank={rankTpl}
  data-msg-noscore={noScoreText}
  data-col-rank={colRank}
  data-col-site={colSite}
  data-col-grade={colGrade}
  data-col-score={colScore}
  data-label-you={youLabel}
>
  <h2>{title}</h2>
  <p class="oc-desc" data-oc-desc>{descNoToken}</p>
  <button class="btn" type="button" data-oc-load hidden>{loadText}</button>
  <div class="oc-table" data-oc-table hidden></div>
  <p class="oc-status" data-oc-status role="status" aria-live="polite"></p>
</section>

<style>
  .owner-compare {
    background: var(--bg-surface);
    border: 1px solid var(--line);
    border-radius: var(--radius);
    padding: 14px;
    display: grid;
    gap: 10px;
  }
  .owner-compare h2 {
    font-size: 15px;
    margin: 0;
  }
  .oc-desc {
    margin: 0;
    font-size: 12.5px;
    line-height: 1.6;
    color: var(--text-2);
  }
  .oc-status {
    margin: 0;
    min-height: 1.2em;
    font-size: 11.5px;
    color: var(--text-3);
  }
  .oc-status:empty {
    display: none;
  }
  .oc-status[data-tone='error'] {
    color: var(--grade-f);
  }
  .oc-meta {
    margin: 0;
    font-size: 12.5px;
    color: var(--text-2);
  }
  .oc-table {
    overflow-x: auto;
    border: 1px solid var(--line);
    border-radius: var(--r-1);
  }
  .oc-table table {
    width: 100%;
    border-collapse: collapse;
    font-size: 12.5px;
  }
  .oc-table th,
  .oc-table td {
    padding: 7px 10px;
    text-align: left;
    border-bottom: 1px solid var(--line);
    white-space: nowrap;
  }
  .oc-table th {
    background: var(--bg-ink);
    color: var(--text-3);
    font-weight: 500;
    font-size: 11.5px;
  }
  .oc-table tr:last-child td {
    border-bottom: 0;
  }
  .oc-table tr[data-you] td {
    background: color-mix(in srgb, var(--brand) 8%, transparent);
    font-weight: 600;
  }
  .oc-table .num {
    text-align: right;
    font-variant-numeric: tabular-nums;
  }
</style>

<script>
  // Pro gate → on-demand compare → a table built from textContent only.
  function readJson(r: Response): Promise<any> {
    return r.json().catch(() => null);
  }

  for (const section of document.querySelectorAll<HTMLElement>('[data-owner-compare]')) {
    const domain = section.dataset.domain ?? '';
    const desc = section.querySelector<HTMLElement>('[data-oc-desc]');
    const btn = section.querySelector<HTMLButtonElement>('[data-oc-load]');
    const tableBox = section.querySelector<HTMLElement>('[data-oc-table]');
    const status = section.querySelector<HTMLElement>('[data-oc-status]');
    const attr = (name: string) => section.getAttribute(name) ?? '';

    function say(msg: string, tone?: string) {
      if (!status) return;
      status.textContent = msg;
      if (tone) status.dataset.tone = tone;
      else delete status.dataset.tone;
    }

    let token = '';
    try { token = localStorage.getItem(`afr-owner-mail-${domain}`) ?? ''; } catch { /* storage blocked */ }
    if (!token) {
      if (desc) desc.textContent = attr('data-desc-notoken');
      continue;
    }

    // The Pro state decides whether the button exists at all.
    fetch(`/api/v1/pro/status?domain=${encodeURIComponent(domain)}`, {
      headers: { accept: 'application/json', authorization: `Bearer ${token}` },
    })
      .then((r) => (r.ok ? readJson(r) : null))
      .then((body) => {
        if (body && body.pro && body.pro.active === true) {
          if (desc) desc.textContent = '';
          if (btn) btn.hidden = false;
        } else {
          if (desc) desc.textContent = attr('data-desc-free');
        }
      })
      .catch(() => {
        if (desc) desc.textContent = attr('data-desc-free');
      });

    btn?.addEventListener('click', () => {
      if (!btn || btn.disabled) return;
      btn.disabled = true;
      say(attr('data-msg-loading'));
      fetch(`/api/v1/compare?domain=${encodeURIComponent(domain)}`, {
        headers: { accept: 'application/json', authorization: `Bearer ${token}` },
      })
        .then((r) => readJson(r).then((body) => ({ r, body })))
        .then(({ r, body }) => {
          btn.disabled = false;
          if (r.status === 401) {
            if (desc) desc.textContent = attr('data-msg-unauthorized');
            say(attr('data-msg-unauthorized'), 'error');
            btn.hidden = true;
            return;
          }
          if (r.status === 403) {
            if (desc) desc.textContent = attr('data-desc-free');
            say('', undefined);
            btn.hidden = true;
            return;
          }
          if (r.status !== 200 || !body || !Array.isArray(body.peers)) {
            say(attr('data-msg-error'), 'error');
            return;
          }
          render(body);
          say('');
        })
        .catch(() => {
          btn.disabled = false;
          say(attr('data-msg-error'), 'error');
        });
    });

    function render(body: any) {
      if (!tableBox) return;
      tableBox.textContent = '';
      tableBox.hidden = false;

      const zh = section.dataset.locale === 'zh-CN';
      const cat = body.category ?? null;
      const catName = cat ? ((zh ? cat.nameZh : cat.nameEn) || cat.nameEn || cat.nameZh || '') : '';
      const meta = document.createElement('p');
      meta.className = 'oc-meta';
      const you = body.you ?? {};
      const rank = Number(you.rank) || 0;
      const total = Number(you.total) || 0;
      const rankLine = attr('data-tpl-rank').replace('{r}', String(rank || '—')).replace('{n}', String(total));
      meta.textContent = catName ? `${catName} · ${rankLine}` : rankLine;
      tableBox.appendChild(meta);

      const table = document.createElement('table');
      const thead = document.createElement('thead');
      const headRow = document.createElement('tr');
      for (const [key, label] of [
        ['rank', attr('data-col-rank')],
        ['site', attr('data-col-site')],
        ['grade', attr('data-col-grade')],
        ['score', attr('data-col-score')],
      ] as const) {
        const th = document.createElement('th');
        th.textContent = label;
        if (key === 'rank' || key === 'score') th.className = 'num';
        th.scope = 'col';
        headRow.appendChild(th);
      }
      thead.appendChild(headRow);
      table.appendChild(thead);

      const tbody = document.createElement('tbody');
      const peers: any[] = body.peers;
      const absoluteRank = rank > 0 ? rank - peers.findIndex((p: any) => p && p.you === true) : 0;
      peers.forEach((peer, index) => {
        if (!peer) return;
        const tr = document.createElement('tr');
        if (peer.you === true) tr.setAttribute('data-you', '');
        const cells: [string, string][] = [
          [String(absoluteRank > 0 ? absoluteRank + index : index + 1), 'num'],
          [String(peer.domain ?? ''), ''],
          [String(peer.grade ?? '—'), ''],
          [peer.score === null || peer.score === undefined ? '—' : String(peer.score), 'num'],
        ];
        for (const [value, cls] of cells) {
          const td = document.createElement('td');
          td.textContent = value;
          if (cls) td.className = cls;
          tr.appendChild(td);
        }
        if (peer.you === true) {
          const mark = document.createElement('span');
          mark.textContent = ` (${attr('data-label-you')})`;
          tr.children[1]?.appendChild(mark);
        }
        tbody.appendChild(tr);
      });
      table.appendChild(tbody);
      tableBox.appendChild(table);

      if (!rank) say(attr('data-msg-noscore'));
    }
  }
</script>
