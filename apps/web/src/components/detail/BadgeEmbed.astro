---
// BadgeEmbed — detail-page right column / badge-page embed snippets:
// HTML <a><img></a> and Markdown forms in readonly mono fields, each with a
// Copy button: "Copy" → "Copied ✓" → reverts after 1.5s,
// never alert/toast.

import { getCatalog } from '../../i18n/loader.ts';

interface Props {
  domain: string;
  grade: string;
  locale: string;
  /** locale-aware href of the badge gallery page (P6) */
  badgeHref?: string;
  /** hide the "badge gallery" link when this component IS the gallery page */
  showGalleryLink?: boolean;
}

const { domain, grade, locale, badgeHref = '/badges', showGalleryLink = true } = Astro.props;
const L = getCatalog(locale);
const isZh = locale === 'zh-CN';
const T = (en: string, zh: string) => (isZh ? zh : en);

const siteUrl = `https://afr.im/site/${domain}`;
const badgeUrl = `https://afr.im/badge/${domain}.svg`;
const htmlSnippet = `<a href="${siteUrl}"><img src="${badgeUrl}" alt="AI-Friendly Rating ${grade}"></a>`;
const mdSnippet = `[![AI-Friendly Rating](${badgeUrl})](${siteUrl})`;
const copyLabel = L.ui.copy ?? 'Copy';
const copiedLabel = `${L.ui.copied ?? 'Copied'} ✓`;
const title = L.ui.badgeEmbed ?? T('Embed badge', '嵌入徽章');
const note = L.ui.badgeEmbedNote ?? T(
  'Official badges are only served from AFR.IM — clicking one opens this site’s report.',
  '官方徽章只从 AFR.IM 提供——点击徽章即可回到本站报告页验真。',
);
---

<section class="embed" aria-label={title}>
  <header class="embed-head">
    <h2>{title}</h2>
    {showGalleryLink && <a class="all mono" href={badgeHref}>{L.ui.badgeTitle ?? T('Badge gallery', '徽章总览')} →</a>}
  </header>

  <div class="snippet">
    <div class="snippet-top">
      <span class="kind mono">HTML</span>
      <button class="copy mono" type="button" data-copy data-label={copyLabel} data-done={copiedLabel}>
        {copyLabel}
      </button>
    </div>
    <pre class="code mono" data-snippet aria-label="HTML embed code">{htmlSnippet}</pre>
  </div>

  <div class="snippet">
    <div class="snippet-top">
      <span class="kind mono">Markdown</span>
      <button class="copy mono" type="button" data-copy data-label={copyLabel} data-done={copiedLabel}>
        {copyLabel}
      </button>
    </div>
    <pre class="code mono" data-snippet aria-label="Markdown embed code">{mdSnippet}</pre>
  </div>

  <p class="note">{note}</p>
</section>

<style>
  .embed {
    background: var(--bg-surface);
    border: 1px solid var(--line);
    border-radius: var(--radius);
    padding: 14px;
    display: grid;
    gap: 10px;
  }
  .embed-head {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 8px;
  }
  .embed-head h2 {
    font-size: 15px;
    margin: 0;
  }
  .all {
    font-size: 11.5px;
    color: var(--text-3);
  }
  .all:hover {
    color: var(--brand);
  }

  .snippet {
    border: 1px solid var(--line);
    border-radius: var(--r-1);
    overflow: hidden;
  }
  .snippet-top {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 8px;
    padding: 5px 8px;
    background: var(--bg-elevated);
    border-bottom: 1px solid var(--line);
  }
  .kind {
    font-size: 11px;
    color: var(--text-3);
    text-transform: uppercase;
    letter-spacing: 0.04em;
  }
  .copy {
    padding: 3px 10px;
    border: 1px solid var(--line);
    border-radius: var(--r-1);
    font-size: 11.5px;
    color: var(--text-1);
    transition: border-color var(--t-micro) var(--ease), color var(--t-micro) var(--ease);
  }
  .copy:hover {
    border-color: var(--brand);
    color: var(--brand);
  }
  .copy[data-state='done'] {
    border-color: var(--grade-a);
    color: var(--grade-a);
  }

  /* full snippet visible: never clipped, never ellipsized — the badge URL
     https://afr.im/badge/<domain>.svg must be readable end-to-end */
  .code {
    margin: 0;
    padding: 8px 10px;
    background: var(--bg-ink);
    color: var(--text-1);
    font-family: var(--font-mono);
    font-size: 11.5px;
    line-height: 1.6;
    white-space: pre-wrap;
    word-break: break-all;
    overflow-wrap: anywhere;
    tab-size: 2;
  }
  .code:focus-visible {
    outline: 2px solid var(--brand);
    outline-offset: -2px;
  }

  .note {
    margin: 0;
    font-size: 11.5px;
    line-height: 1.6;
    color: var(--text-3);
  }
</style>

<script>
  // Copy row: "Copy" → "Copied ✓" → reverts after 1.5s (no alert/toast).
  const timers = new WeakMap<Element, ReturnType<typeof setTimeout>>();
  for (const btn of document.querySelectorAll<HTMLButtonElement>('[data-copy]')) {
    btn.addEventListener('click', async () => {
      const box = btn.closest('.snippet')?.querySelector('[data-snippet]');
      if (!box) return;
      const text = box.textContent ?? '';
      try {
        await navigator.clipboard.writeText(text);
      } catch {
        /* clipboard unavailable → select the node and fall back to execCommand */
        const range = document.createRange();
        range.selectNodeContents(box);
        const sel = window.getSelection();
        sel?.removeAllRanges();
        sel?.addRange(range);
        try {
          document.execCommand('copy');
        } catch {
          /* nothing else to try — the snippet stays selectable */
        }
        sel?.removeAllRanges();
      }
      btn.textContent = btn.dataset.done ?? 'Copied ✓';
      btn.dataset.state = 'done';
      const prev = timers.get(btn);
      if (prev) clearTimeout(prev);
      timers.set(
        btn,
        setTimeout(() => {
          btn.textContent = btn.dataset.label ?? 'Copy';
          delete btn.dataset.state;
        }, 1500),
      );
    });
  }
</script>
