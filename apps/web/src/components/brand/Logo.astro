---
// Logo — aiapp brand lockup (spec §15.3, §15.4-④).
// The mark is the hand-written flat SVG (SVG is the ONLY source of truth):
// fixed mint-on-navy fills, no currentColor, so it reads on dark AND light
// themes — the deep-navy disc travels with the mark everywhere.

interface Props {
  size?: number; // mark diameter in px (default 28)
  wordmark?: boolean; // render "aiapp" + ".im" beside the mark (default false)
}

const { size = 28, wordmark = false } = Astro.props;
const gap = size * 0.35; // spec §15.3: gap = mark diameter × 0.35
---

<span class="logo" style={`--logo-size:${size}px;--logo-gap:${gap}px;`}>
  <svg
    class="mark"
    width={size}
    height={size}
    viewBox="0 0 64 64"
    role={wordmark ? undefined : 'img'}
    aria-label={wordmark ? undefined : 'AiApp.im'}
    aria-hidden={wordmark ? 'true' : undefined}
  >
    <!-- concept C3 "Signal Ripple": five-point spark inside segmented arcs -->
    <circle cx="32" cy="32" r="32" fill="#0B1220"></circle>
    <circle cx="32" cy="32" r="23" fill="none" stroke="#3ECFAD" stroke-width="3.2"></circle>
    <g fill="none" stroke="#3ECFAD" stroke-width="3.4">
      <path d="M34.09 17.15A15 15 0 0 1 45.91 37.62"></path>
      <path d="M18.09 37.62A15 15 0 0 1 29.91 17.15"></path>
      <path d="M43.82 41.24A15 15 0 0 1 20.18 41.24"></path>
    </g>
    <path fill="#3ECFAD" d="M32 21.6L34.56 28.48L41.89 28.79L36.14 33.34L38.11 40.41L32 36.35L25.89 40.41L27.86 33.34L22.11 28.79L29.44 28.48Z"></path>
  </svg>
  {
    wordmark && (
      <span class="word">
        <span class="word-name">AiApp</span><span class="word-tld">.im</span>
      </span>
    )
  }
</span>

<style>
  .logo {
    display: inline-flex;
    align-items: center;
    gap: var(--logo-gap, 0px);
    vertical-align: middle;
  }

  .mark {
    display: block;
    flex: none;
  }

  .word {
    font-family: var(--font-display);
    font-weight: 500;
    font-size: var(--logo-size, 28px);
    line-height: 1;
    letter-spacing: -0.02em;
    color: var(--text-1);
    white-space: nowrap;
    /* cap-height optical centring: the cap box sits ~0.02em below the em box */
    transform: translateY(-0.02em);
  }

  .word-name {
    color: var(--text-1);
  }

  /* spec §15.3: suffix is same size but softened — one word, two weights */
  .word-tld {
    color: var(--text-2);
  }
</style>
